FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    bc \
    build-essential \
    ca-certificates \
    cpio \
    curl \
    file \
    git \
    libelf-dev \
    locales \
    patch \
    perl \
    python3 \
    rsync \
    tar \
    unzip \
    wget \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["scripts/build-image.sh"]
