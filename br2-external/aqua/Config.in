menu "Aqua Linux"

config BR2_PACKAGE_AQUA_BOOT_MARKERS
    bool "Aqua boot markers"
    default y
    help
      Installs the early recovery boot marker scripts used by Milestone 1.

source "$BR2_EXTERNAL_AQUA_PATH/package/aqua-audio-native/Config.in"
source "$BR2_EXTERNAL_AQUA_PATH/package/aqua-audio-probe/Config.in"

endmenu
