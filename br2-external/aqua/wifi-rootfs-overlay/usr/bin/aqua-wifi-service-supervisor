#!/bin/sh

set -u

CONFIG_PATH="${AQUA_WIFI_SERVICES_CONFIG:-/etc/aqua/wifi-services.conf}"
CONTROL_DIR="${AQUA_WIFI_CONTROL_DIR:-/run/aqua-wifi}"
NETWORK_CONTROL_DIR="${AQUA_NETWORK_CONTROL_DIR:-/run/aqua-network}"
STATE_FILE="${AQUA_WIFI_STATE_FILE:-${CONTROL_DIR}/wifi-service.state}"
PID_FILE="${AQUA_WIFI_PID_FILE:-${CONTROL_DIR}/wifi-service.pid}"
STOP_FILE="${AQUA_WIFI_STOP_FILE:-${CONTROL_DIR}/wifi-service.stop}"
ASSOCIATION_FILE="${AQUA_WIFI_ASSOCIATION_FILE:-${NETWORK_CONTROL_DIR}/wifi.associated}"
READY_FILE="${AQUA_WIFI_DHCP_READY_FILE:-${CONTROL_DIR}/lease.ready}"
WPA_CONTROL_DIR="${AQUA_WIFI_WPA_CONTROL_DIR:-/run/wpa_supplicant}"
ROUTE_TABLE="${AQUA_WIFI_ROUTE_TABLE:-/proc/net/route}"
RESOLVER_FILE="${AQUA_WIFI_RESOLVER_FILE:-/etc/resolv.conf}"
TEST_MODE="${AQUA_WIFI_TEST_MODE:-false}"

config_value() {
    key="$1"
    fallback="$2"
    value=""
    if [ -f "${CONFIG_PATH}" ]; then
        value="$(sed -n "s/^${key}=//p" "${CONFIG_PATH}" | tail -n 1)"
    fi
    printf '%s\n' "${value:-${fallback}}"
}

ENABLED="${AQUA_WIFI_ENABLED:-$(config_value enabled false)}"
INTERFACE="${AQUA_WIFI_INTERFACE:-$(config_value interface wlan0)}"
LINK_CARRIER_FILE="${AQUA_WIFI_CARRIER_FILE:-/sys/class/net/${INTERFACE}/carrier}"
WPA_BIN="${AQUA_WIFI_WPA_BIN:-$(config_value wpa_binary /usr/sbin/wpa_supplicant)}"
WPA_CONFIG="${AQUA_WIFI_WPA_CONFIG:-$(config_value wpa_config /etc/aqua/wpa_supplicant-aqua.conf)}"
UDHCPC_BIN="${AQUA_WIFI_UDHCPC_BIN:-$(config_value udhcpc_binary /usr/bin/aqua-wifi-udhcpc-client)}"
UDHCPC_HOOK="${AQUA_WIFI_UDHCPC_HOOK:-/usr/bin/aqua-udhcpc-hook}"
UDHCPC_DEFAULT_SCRIPT="${AQUA_UDHCPC_DEFAULT_SCRIPT:-$(config_value udhcpc_default_script /usr/share/udhcpc/default.script)}"
MAX_RESTARTS="${AQUA_WIFI_MAX_RESTARTS:-$(config_value max_restarts 3)}"
RESTART_DELAY="${AQUA_WIFI_RESTART_DELAY_SECONDS:-$(config_value restart_delay_seconds 2)}"
READY_TIMEOUT="${AQUA_WIFI_READY_TIMEOUT_SECONDS:-$(config_value readiness_timeout_seconds 20)}"
MONITOR_INTERVAL="${AQUA_WIFI_MONITOR_INTERVAL_SECONDS:-$(config_value monitor_interval_seconds 1)}"
STOP_TIMEOUT="${AQUA_WIFI_STOP_TIMEOUT_SECONDS:-$(config_value stop_timeout_seconds 5)}"
MAX_ROUTE_BYTES="${AQUA_WIFI_MAX_ROUTE_BYTES:-16384}"
MAX_RESOLVER_BYTES="${AQUA_WIFI_MAX_RESOLVER_BYTES:-4096}"

wpa_pid=""
dhcp_pid=""
termination_requested=false

mark() {
    echo "[AQUA-WIFI] stage=wifi-service-supervisor status=$1 $2"
}

valid_unsigned() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

valid_binary() {
    path="$1"
    [ "${path#/}" != "${path}" ] && [ -f "${path}" ] &&
        [ -x "${path}" ] && [ ! -L "${path}" ]
}

bounded_file() {
    path="$1"
    limit="$2"
    [ -f "${path}" ] && [ ! -L "${path}" ] || return 1
    bytes="$(wc -c < "${path}" 2>/dev/null | tr -d '[:space:]')" || return 1
    valid_unsigned "${bytes}" && [ "${bytes}" -le "${limit}" ]
}

association_ready() {
    bounded_file "${ASSOCIATION_FILE}" 256 || return 1
    grep -Fxq "interface=${INTERFACE}" "${ASSOCIATION_FILE}" || return 1
    grep -Fxq 'authoritative=true' "${ASSOCIATION_FILE}" || return 1
    if [ "${TEST_MODE}" != true ]; then
        owner="$(ls -nd "${ASSOCIATION_FILE}" 2>/dev/null | awk '{print $3}')"
        [ "${owner}" = 0 ] || return 1
    fi
}

carrier_ready() {
    bounded_file "${LINK_CARRIER_FILE}" 16 || return 1
    [ "$(tr -d '[:space:]' < "${LINK_CARRIER_FILE}")" = 1 ]
}

route_ready() {
    bounded_file "${ROUTE_TABLE}" "${MAX_ROUTE_BYTES}" || return 1
    while read -r route_interface destination gateway flags remainder; do
        [ "${route_interface}" = "${INTERFACE}" ] || continue
        [ "${destination}" = 00000000 ] || continue
        case "${flags}" in *[!0123456789abcdefABCDEF]*) continue ;; esac
        case "${flags}" in
            ????) last_flag="${flags#???}" ;;
            ????????) last_flag="${flags#???????}" ;;
            *) continue ;;
        esac
        case "${last_flag}" in 1|3|5|7|9|b|B|d|D|f|F) return 0 ;; esac
    done < "${ROUTE_TABLE}"
    return 1
}

valid_ipv4() {
    old_ifs="${IFS}"
    IFS=.
    set -- $1
    IFS="${old_ifs}"
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        valid_unsigned "${octet}" && [ "${octet}" -le 255 ] || return 1
    done
}

dns_ready() {
    dns_source="${RESOLVER_FILE}"
    if [ -L "${dns_source}" ]; then
        [ "${dns_source}" = /etc/resolv.conf ] &&
            [ "$(readlink "${dns_source}" 2>/dev/null || true)" = ../tmp/resolv.conf ] ||
            return 1
        dns_source=/tmp/resolv.conf
    fi
    bounded_file "${dns_source}" "${MAX_RESOLVER_BYTES}" || return 1
    while read -r directive address remainder; do
        [ "${directive}" = nameserver ] || continue
        valid_ipv4 "${address:-}" && return 0
    done < "${dns_source}"
    return 1
}

write_state() {
    state="$1"
    attempts="$2"
    restarts="$3"
    failure="$4"
    tmp="${STATE_FILE}.tmp.$$"
    {
        echo 'product=Aqua Linux'
        echo "state=${state}"
        echo "interface=${INTERFACE}"
        echo "attempts=${attempts}"
        echo "restarts=${restarts}"
        echo "max_restarts=${MAX_RESTARTS}"
        echo "failure=${failure}"
        echo "wpa_pid=${wpa_pid}"
        echo "dhcp_pid=${dhcp_pid}"
        echo "wpa_ready=$([ -S "${WPA_CONTROL_DIR}/${INTERFACE}" ] && echo true || echo false)"
        echo "associated=$(association_ready && echo true || echo false)"
        echo "carrier_ready=$(carrier_ready && echo true || echo false)"
        echo "lease_ready=$([ -f "${READY_FILE}" ] && [ ! -L "${READY_FILE}" ] && echo true || echo false)"
        echo "route_ready=$(route_ready && echo true || echo false)"
        echo "dns_ready=$(dns_ready && echo true || echo false)"
        echo "service_owner_uid=$(id -u)"
        echo 'policy_owner=aqua-wifi-service-supervisor'
        echo 'settings_management=false'
        echo 'default_wifi=false'
    } > "${tmp}" && chmod 644 "${tmp}" && mv "${tmp}" "${STATE_FILE}"
}

stop_process() {
    process_pid="$1"
    service="$2"
    [ -n "${process_pid}" ] || return 0
    if kill -0 "${process_pid}" 2>/dev/null; then
        kill "${process_pid}" 2>/dev/null || true
        waited=0
        while kill -0 "${process_pid}" 2>/dev/null && [ "${waited}" -lt "${STOP_TIMEOUT}" ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if kill -0 "${process_pid}" 2>/dev/null; then
            kill -9 "${process_pid}" 2>/dev/null || true
            mark stopping "service=${service} forced=true"
        else
            mark stopping "service=${service} forced=false"
        fi
    fi
    wait "${process_pid}" 2>/dev/null || true
}

stop_dhcp() {
    stop_process "${dhcp_pid}" udhcpc
    dhcp_pid=""
    rm -f "${READY_FILE}" 2>/dev/null || true
}

stop_wpa() {
    stop_process "${wpa_pid}" wpa_supplicant
    wpa_pid=""
}

cleanup() {
    stop_dhcp
    stop_wpa
    if [ -f "${PID_FILE}" ] && [ "$(cat "${PID_FILE}" 2>/dev/null || true)" = "$$" ]; then
        rm -f "${PID_FILE}"
    fi
}

trap 'termination_requested=true' HUP INT TERM
trap cleanup EXIT

for value in "${MAX_RESTARTS}" "${RESTART_DELAY}" "${READY_TIMEOUT}" \
    "${MONITOR_INTERVAL}" "${STOP_TIMEOUT}" "${MAX_ROUTE_BYTES}" \
    "${MAX_RESOLVER_BYTES}"; do
    valid_unsigned "${value}" || { mark blocked 'reason=invalid-policy'; exit 2; }
done
if [ "${INTERFACE}" != wlan0 ] || [ "${READY_TIMEOUT}" -eq 0 ] ||
   [ "${MONITOR_INTERVAL}" -eq 0 ] || [ "${STOP_TIMEOUT}" -eq 0 ]; then
    mark blocked 'reason=invalid-policy'
    exit 2
fi
for directory in "${CONTROL_DIR}" "${NETWORK_CONTROL_DIR}" "${WPA_CONTROL_DIR}"; do
    [ ! -L "${directory}" ] || { mark blocked 'reason=unsafe-control-directory'; exit 2; }
    mkdir -p "${directory}" || { mark blocked 'reason=control-directory'; exit 2; }
    [ -d "${directory}" ] || { mark blocked 'reason=unsafe-control-directory'; exit 2; }
    chmod 755 "${directory}" 2>/dev/null || true
done
if [ "${ENABLED}" != true ]; then
    write_state disabled 0 0 none
    mark disabled 'reason=transition-not-enabled default_wifi=false'
    exit 0
fi
if [ "$(id -u)" -ne 0 ] && [ "${TEST_MODE}" != true ]; then
    write_state blocked 0 0 ownership
    mark blocked "reason=root-service-required uid=$(id -u)"
    exit 1
fi
for binary in "${WPA_BIN}" "${UDHCPC_BIN}" "${UDHCPC_HOOK}" "${UDHCPC_DEFAULT_SCRIPT}"; do
    valid_binary "${binary}" || { write_state degraded 0 0 preflight; mark degraded "reason=invalid-service-binary binary=${binary}"; exit 1; }
done
if [ "${WPA_CONFIG#/}" = "${WPA_CONFIG}" ] || [ ! -f "${WPA_CONFIG}" ] ||
   [ -L "${WPA_CONFIG}" ] || ! bounded_file "${WPA_CONFIG}" 4096; then
    write_state degraded 0 0 preflight
    mark degraded 'reason=invalid-wpa-config'
    exit 1
fi
if [ -f "${PID_FILE}" ]; then
    old_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    case "${old_pid}" in
        ''|*[!0-9]*) ;;
        *) kill -0 "${old_pid}" 2>/dev/null && { mark duplicate "pid=${old_pid}"; exit 1; } ;;
    esac
fi
rm -f "${PID_FILE}" "${STOP_FILE}" "${READY_FILE}" 2>/dev/null || true
echo "$$" > "${PID_FILE}"

export AQUA_NETWORK_INTERFACE="${INTERFACE}"
export AQUA_NETWORK_READY_FILE="${READY_FILE}"
export AQUA_NETWORK_RESOLVER_FILE="${RESOLVER_FILE}"
export AQUA_NETWORK_ROUTE_TABLE="${ROUTE_TABLE}"
export AQUA_NETWORK_ENSURE_ONLINK_ROUTE=true
export AQUA_UDHCPC_DEFAULT_SCRIPT="${UDHCPC_DEFAULT_SCRIPT}"

attempts=0
restarts=0
while :; do
    attempts=$((attempts + 1))
    rm -f "${WPA_CONTROL_DIR}/${INTERFACE}" "${READY_FILE}" 2>/dev/null || true
    mark starting "service=wpa_supplicant interface=${INTERFACE} attempt=${attempts} restart=${restarts}"
    "${WPA_BIN}" -i "${INTERFACE}" -D nl80211 -c "${WPA_CONFIG}" \
        -C "${WPA_CONTROL_DIR}" >> "${CONTROL_DIR}/wpa_supplicant.log" 2>&1 &
    wpa_pid="$!"
    write_state starting "${attempts}" "${restarts}" none
    waited=0
    while [ ! -S "${WPA_CONTROL_DIR}/${INTERFACE}" ] &&
          kill -0 "${wpa_pid}" 2>/dev/null && [ "${waited}" -lt "${READY_TIMEOUT}" ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if ! kill -0 "${wpa_pid}" 2>/dev/null; then
        failure=wpa-service
    elif [ ! -S "${WPA_CONTROL_DIR}/${INTERFACE}" ]; then
        failure=wpa-readiness
    else
        failure=none
        write_state ready "${attempts}" "${restarts}" none
        mark ready "interface=${INTERFACE} attempt=${attempts} restart=${restarts} control_socket=true"
    fi

    while [ "${failure}" = none ]; do
        if [ "${termination_requested}" = true ] || [ -f "${STOP_FILE}" ]; then
            stop_dhcp
            stop_wpa
            write_state stopped "${attempts}" "${restarts}" none
            rm -f "${STOP_FILE}"
            mark stopped "reason=requested interface=${INTERFACE}"
            exit 0
        fi
        if ! kill -0 "${wpa_pid}" 2>/dev/null; then
            failure=wpa-service
            break
        fi
        if association_ready && carrier_ready; then
            if [ -z "${dhcp_pid}" ]; then
                mark starting "service=udhcpc interface=${INTERFACE} attempt=${attempts} restart=${restarts}"
                "${UDHCPC_BIN}" -f -n -i "${INTERFACE}" -s "${UDHCPC_HOOK}" \
                    >> "${CONTROL_DIR}/udhcpc.log" 2>&1 &
                dhcp_pid="$!"
                write_state configuring "${attempts}" "${restarts}" none
                waited=0
                while [ ! -f "${READY_FILE}" ] && kill -0 "${dhcp_pid}" 2>/dev/null &&
                      [ "${waited}" -lt "${READY_TIMEOUT}" ]; do
                    sleep 1
                    waited=$((waited + 1))
                done
                if ! kill -0 "${dhcp_pid}" 2>/dev/null; then failure=dhcp-client; break; fi
                if [ ! -f "${READY_FILE}" ] || [ -L "${READY_FILE}" ]; then failure=dhcp-readiness; break; fi
                if ! route_ready; then failure=route-readiness; break; fi
                if ! dns_ready; then failure=dns-readiness; break; fi
                write_state running "${attempts}" "${restarts}" none
                mark running "interface=${INTERFACE} association=true dhcp=true route=true dns=true"
            elif ! kill -0 "${dhcp_pid}" 2>/dev/null; then
                failure=dhcp-client
                break
            elif [ ! -f "${READY_FILE}" ] || ! route_ready || ! dns_ready; then
                failure=network-lost
                break
            fi
        else
            if [ -n "${dhcp_pid}" ]; then
                stop_dhcp
                write_state ready "${attempts}" "${restarts}" none
                mark ready "interface=${INTERFACE} association=false dhcp=false"
            fi
        fi
        sleep "${MONITOR_INTERVAL}"
    done

    stop_dhcp
    stop_wpa
    if [ -f "${ASSOCIATION_FILE}" ] && [ ! -L "${ASSOCIATION_FILE}" ]; then
        rm -f "${ASSOCIATION_FILE}"
    fi
    if [ "${restarts}" -ge "${MAX_RESTARTS}" ]; then
        write_state degraded "${attempts}" "${restarts}" "${failure}"
        mark degraded "reason=restart-limit failure=${failure} attempts=${attempts} restarts=${restarts}"
        exit 1
    fi
    restarts=$((restarts + 1))
    write_state restarting "${attempts}" "${restarts}" "${failure}"
    mark restarting "failure=${failure} next_restart=${restarts} delay_seconds=${RESTART_DELAY}"
    [ "${RESTART_DELAY}" -gt 0 ] && sleep "${RESTART_DELAY}"
done
