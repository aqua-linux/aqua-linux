#!/bin/sh

set -u

CMDLINE_PATH="${AQUA_CMDLINE_PATH:-/proc/cmdline}"
PROFILE_PATH="${AQUA_NETWORK_BOOT_PROFILE:-/etc/aqua/network-services-qemu.conf}"
SUPERVISOR_BIN="${AQUA_NETWORK_SUPERVISOR_BIN:-/usr/bin/aqua-network-service-supervisor}"
CONTROL_DIR="${AQUA_NETWORK_CONTROL_DIR:-/run/aqua-network}"
PID_FILE="${AQUA_NETWORK_SUPERVISOR_PID_FILE:-${CONTROL_DIR}/network-service-supervisor.pid}"
LOG_FILE="${AQUA_NETWORK_SUPERVISOR_LOG_FILE:-${CONTROL_DIR}/network-service-supervisor.log}"

mark() {
    echo "[AQUA-BOOT] stage=network-service-activation status=$1 $2"
}

profile_has_once() {
    [ "$(grep -Fxc "$1" "${PROFILE_PATH}" 2>/dev/null || true)" -eq 1 ]
}

cmdline=""
[ -r "${CMDLINE_PATH}" ] && cmdline="$(cat "${CMDLINE_PATH}")"
case " ${cmdline} " in
    *' aqua.boot_network=1 '*) ;;
    *)
        mark disabled "reason=kernel-flag-absent boot_network=false network_started=false"
        exit 0
        ;;
esac

profile_lines=""
if [ -f "${PROFILE_PATH}" ] && [ ! -L "${PROFILE_PATH}" ]; then
    profile_lines="$(wc -l < "${PROFILE_PATH}" | tr -d ' ')"
fi
if [ ! -f "${PROFILE_PATH}" ] || [ -L "${PROFILE_PATH}" ] ||
   [ "${profile_lines}" != 12 ] ||
   ! profile_has_once 'enabled=true' ||
   ! profile_has_once 'interface=eth0' ||
   ! profile_has_once 'udhcpc_binary=/usr/bin/aqua-udhcpc-client' ||
   ! profile_has_once 'udhcpc_default_script=/usr/share/udhcpc/default.script' ||
   ! profile_has_once 'legacy_owner_disabled=true' ||
   ! profile_has_once 'max_restarts=3' ||
   ! profile_has_once 'restart_delay_seconds=2' ||
   ! profile_has_once 'readiness_timeout_seconds=20' ||
   ! profile_has_once 'lease_loss_grace_seconds=5' ||
   ! profile_has_once 'monitor_interval_seconds=1' ||
   ! profile_has_once 'stop_timeout_seconds=5' ||
   ! profile_has_once 'profile_scope=qemu-only'; then
    mark blocked "reason=invalid-qemu-network-profile network_started=false"
    exit 1
fi

if [ ! -f "${SUPERVISOR_BIN}" ] || [ ! -x "${SUPERVISOR_BIN}" ] ||
   [ -L "${SUPERVISOR_BIN}" ]; then
    mark blocked "reason=network-supervisor-missing network_started=false"
    exit 1
fi

if [ -L "${CONTROL_DIR}" ]; then
    mark blocked "reason=unsafe-control-directory network_started=false"
    exit 1
fi
mkdir -p "${CONTROL_DIR}" || {
    mark blocked "reason=control-directory network_started=false"
    exit 1
}

if [ -f "${PID_FILE}" ]; then
    old_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    case "${old_pid}" in
        ''|*[!0-9]*) ;;
        *)
            if kill -0 "${old_pid}" 2>/dev/null; then
                mark duplicate "pid=${old_pid} network_started=false"
                exit 1
            fi
            ;;
    esac
    rm -f "${PID_FILE}"
fi

AQUA_NETWORK_SERVICES_CONFIG="${PROFILE_PATH}" \
AQUA_NETWORK_CONTROL_DIR="${CONTROL_DIR}" \
AQUA_NETWORK_SUPERVISOR_PID_FILE="${PID_FILE}" \
"${SUPERVISOR_BIN}" >> "${LOG_FILE}" 2>&1 &
supervisor_pid="$!"

mark started "mode=supervised-root target=qemu interface=eth0 pid=${supervisor_pid} boot_network=true recovery_tty=true"
exit 0
