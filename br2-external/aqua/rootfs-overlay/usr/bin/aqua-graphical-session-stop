#!/bin/sh

set -u

RUNTIME_DIR="${AQUA_RUNTIME_DIR:-/run/aqua}"
PID_FILE="${AQUA_GRAPHICS_SUPERVISOR_PID_FILE:-${RUNTIME_DIR}/graphical-session-supervisor.pid}"
STATE_FILE="${AQUA_GRAPHICS_SUPERVISOR_STATE_FILE:-${RUNTIME_DIR}/graphical-session-supervisor.state}"
LOG_FILE="${AQUA_GRAPHICS_SUPERVISOR_LOG_FILE:-${RUNTIME_DIR}/graphical-session-supervisor.log}"
STOP_FILE="${AQUA_DRM_WAYLAND_STOP_FILE:-${RUNTIME_DIR}/graphical-session.stop}"
TIMEOUT="${AQUA_GRAPHICS_STOP_TIMEOUT_SECONDS:-20}"

mark() {
    echo "[AQUA-SESSION] stage=graphical-session-stop status=$1 $2"
}

case "${TIMEOUT}" in
    ''|*[!0-9]*)
        mark error "reason=invalid-timeout"
        exit 2
        ;;
esac

if [ ! -f "${PID_FILE}" ]; then
    mark idle "reason=supervisor-not-running"
    exit 0
fi

pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
case "${pid}" in
    ''|*[!0-9]*)
        mark error "reason=invalid-supervisor-pid"
        exit 1
        ;;
esac
if ! kill -0 "${pid}" 2>/dev/null; then
    rm -f "${PID_FILE}"
    mark idle "reason=stale-supervisor-pid-removed"
    exit 0
fi

tmp="${STOP_FILE}.tmp"
{
    echo "product=Aqua Linux"
    echo "request=graceful-graphical-session-stop"
    echo "supervisor_pid=${pid}"
} > "${tmp}" && mv "${tmp}" "${STOP_FILE}" || {
    mark error "reason=stop-request-write-failed"
    exit 1
}
mark requested "supervisor_pid=${pid}"

i=0
while kill -0 "${pid}" 2>/dev/null && [ "${i}" -lt "${TIMEOUT}" ]; do
    sleep 1
    i=$((i + 1))
done

if kill -0 "${pid}" 2>/dev/null; then
    mark timeout "supervisor_pid=${pid} waited_seconds=${i}"
    exit 1
fi

if [ -f "${PID_FILE}" ]; then
    mark error "reason=pid-file-not-cleaned"
    exit 1
fi
if ! grep -Fq 'state=stopped' "${STATE_FILE}" 2>/dev/null ||
   ! grep -Fq 'crtc_restored=true' "${LOG_FILE}" 2>/dev/null ||
   ! grep -Fq 'gbm_scanout_buffers_released=true' "${LOG_FILE}" 2>/dev/null ||
   ! grep -Fq 'graceful_stop_completed=true' "${LOG_FILE}" 2>/dev/null; then
    mark error "reason=incomplete-compositor-cleanup"
    exit 1
fi

rm -f "${STOP_FILE}" "${tmp}"
mark ok "supervisor_stopped=true pid_cleaned=true kms_restored=true clients_stopped=true recovery_return=ok"
