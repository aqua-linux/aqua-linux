#!/bin/sh

set -u

CONFIG_PATH="${AQUA_COMPOSITOR_CONFIG:-/etc/aqua/compositor-session.conf}"
ENV_PATH="${AQUA_SESSION_ENV:-/etc/aqua/session.env}"
COMPOSITOR_BIN="${AQUA_COMPOSITOR_BIN:-/usr/bin/aqua-compositor}"
RUNTIME_DIR_OVERRIDE="${AQUA_RUNTIME_DIR:-}"

failures=0

config_value() {
    key="$1"
    awk -F= -v key="${key}" '$1 == key { print $2; found = 1; exit } END { if (!found) exit 1 }' "${CONFIG_PATH}" 2>/dev/null || true
}

env_value() {
    key="$1"
    awk -F= -v key="export ${key}" '$1 == key { print $2; found = 1; exit } END { if (!found) exit 1 }' "${ENV_PATH}" 2>/dev/null || true
}

mark() {
    status="$1"
    echo "[AQUA-MANUAL] stage=compositor-launch-plan status=${status}"
}

need_value() {
    label="$1"
    actual="$2"
    expected="$3"

    if [ "${actual}" = "${expected}" ]; then
        echo "${label}=${actual}"
    else
        echo "${label}=${actual:-missing}"
        failures=$((failures + 1))
    fi
}

run_probe() {
    label="$1"
    shift
    log="${RUNTIME_DIR}/${label}.log"

    if "$@" > "${log}" 2> "${log}.err"; then
        echo "${label}=ok"
    else
        echo "${label}=failed"
        failures=$((failures + 1))
    fi
}

if [ ! -f "${CONFIG_PATH}" ]; then
    echo "config_path=${CONFIG_PATH}"
    echo "config_status=missing"
    mark error
    exit 1
fi

if [ ! -f "${ENV_PATH}" ]; then
    echo "env_path=${ENV_PATH}"
    echo "env_status=missing"
    mark error
    exit 1
fi

if [ ! -x "${COMPOSITOR_BIN}" ]; then
    echo "compositor_bin=${COMPOSITOR_BIN}"
    echo "compositor_status=missing"
    mark error
    exit 1
fi

product="$(config_value product)"
mode="$(config_value mode)"
wayland_socket="$(config_value wayland_socket)"
configured_runtime_dir="$(config_value runtime_dir)"
runtime_asset_root="$(config_value runtime_asset_root)"
autostart="$(config_value autostart)"
boot_graphics="$(config_value boot_graphics)"
recovery_tty_required="$(config_value recovery_tty_required)"
env_wayland="$(env_value WAYLAND_DISPLAY)"
env_runtime_dir="$(env_value XDG_RUNTIME_DIR)"
env_asset_root="$(env_value AQUA_ASSET_ROOT)"

RUNTIME_DIR="${RUNTIME_DIR_OVERRIDE:-${configured_runtime_dir}}"

echo "product=${product}"
echo "tool=aqua-compositor-manual-launch"
echo "launch_status=qemu-safe-manual-compositor-launch-plan-ready"
echo "launch_mode=manual-recovery"
echo "config_path=${CONFIG_PATH}"
echo "env_path=${ENV_PATH}"
echo "compositor_bin=${COMPOSITOR_BIN}"

need_value "mode" "${mode}" "nested-dev"
need_value "wayland_display" "${wayland_socket}" "aqua-wayland-0"
need_value "runtime_dir" "${configured_runtime_dir}" "/run/user/1000"
need_value "runtime_asset_root" "${runtime_asset_root}" "/usr/share/aqua"
need_value "autostart" "${autostart}" "false"
need_value "boot_graphics" "${boot_graphics}" "false"
need_value "recovery_tty_required" "${recovery_tty_required}" "true"
need_value "session_env_wayland" "${env_wayland}" "aqua-wayland-0"
need_value "session_env_runtime_dir" "${env_runtime_dir}" "/run/user/1000"
need_value "session_env_asset_root" "${env_asset_root}" "/usr/share/aqua"

mkdir -p "${RUNTIME_DIR}" 2>/dev/null || failures=$((failures + 1))
chmod 700 "${RUNTIME_DIR}" 2>/dev/null || true

if [ -d "${RUNTIME_DIR}" ]; then
    echo "runtime_dir_prepared=ok"
else
    echo "runtime_dir_prepared=failed"
    failures=$((failures + 1))
fi

run_probe "manual-launch-session-config" "${COMPOSITOR_BIN}" probe-session-config "${CONFIG_PATH}"
run_probe "manual-launch-session-env" "${COMPOSITOR_BIN}" probe-session-env "${CONFIG_PATH}"
run_probe "manual-launch-session-bootstrap" "${COMPOSITOR_BIN}" probe-session-bootstrap "${CONFIG_PATH}" "${RUNTIME_DIR}"
run_probe "manual-launch-display-activation-plan" "${COMPOSITOR_BIN}" probe-display-activation-plan

echo "fallback_tty_required=true"
echo "manual_start_required=true"
echo "starts_display_output=false"
echo "starts_renderer=false"
echo "starts_desktop_shell=false"
echo "display_output_started=false"
echo "renderer_started=false"
echo "desktop_shell_started=false"
echo "safe_to_run_from_recovery=ok"
echo "next_manual_command=/usr/bin/aqua-compositor probe-display-activation-plan"

if [ "${failures}" -eq 0 ]; then
    mark ok
    exit 0
fi

mark error
exit 1
