#!/bin/sh

set -u

RUNTIME_DIR="${AQUA_RUNTIME_DIR:-/run/aqua}"
ATTEMPT_FILE="${AQUA_GRAPHICS_VISIBLE_QEMU_ATTEMPT_FILE:-${RUNTIME_DIR}/graphics-visible-qemu-attempt.plan}"
TRANSCRIPT_FILE="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_TRANSCRIPT_FILE:-${RUNTIME_DIR}/graphics-visible-attempt-transcript.plan}"

failures=0

mark() {
    status="$1"
    echo "[AQUA-GATE] stage=graphics-visible-attempt-transcript status=${status}"
}

need_log() {
    label="$1"
    log="$2"
    needle="$3"

    if [ -f "${log}" ] && grep -Fq "${needle}" "${log}"; then
        echo "${label}=ok"
    else
        echo "${label}=failed"
        failures=$((failures + 1))
    fi
}

mkdir -p "${RUNTIME_DIR}" 2>/dev/null || failures=$((failures + 1))
chmod 700 "${RUNTIME_DIR}" 2>/dev/null || true

echo "product=Aqua Linux"
echo "tool=aqua-graphics-visible-attempt-transcript"
echo "visible_attempt_transcript_status=qemu-safe-visible-attempt-transcript-ready"
echo "mode=text-recovery"
echo "transcript_mode=manual-visible-qemu-attempt"
echo "attempt_file=${ATTEMPT_FILE}"
echo "transcript_file=${TRANSCRIPT_FILE}"

need_log "source_attempt_ready" "${ATTEMPT_FILE}" "attempt=first-visible-qemu-compositor-run"
need_log "source_attempt_allowed" "${ATTEMPT_FILE}" "visible_qemu_attempt_allowed=true"
need_log "source_attempt_not_started" "${ATTEMPT_FILE}" "visible_qemu_attempt_started=false"
need_log "source_attempt_manual" "${ATTEMPT_FILE}" "manual_start_required=true"
need_log "source_attempt_command" "${ATTEMPT_FILE}" "qemu_attempt_command=/usr/bin/aqua-compositor-guarded-run"
need_log "source_attempt_recovery_safe" "${ATTEMPT_FILE}" "safe_return_to_recovery=ok"

cat > "${TRANSCRIPT_FILE}" <<'EOF' || failures=$((failures + 1))
product=Aqua Linux
transcript=first-visible-qemu-attempt
mode=text-recovery
transcript_mode=manual-visible-qemu-attempt
source_attempt=graphics-visible-qemu-attempt
operator_sequence_ready=true
operator_step_1=/usr/bin/aqua-recovery-help
operator_step_2=/usr/bin/aqua-graphics-visible-qemu-attempt
operator_step_3=/usr/bin/aqua-compositor-guarded-run
expected_bounded_frames=3
expected_display_output_started=true
expected_display_output_stopped=true
expected_return=safe-return-to-recovery
visible_qemu_attempt_started=false
visible_qemu_attempt_completed=false
persistent_graphical_session_started=false
actual_graphics_started=false
desktop_shell_started=false
boot_graphics=false
autostart=false
fallback_tty_available=true
rollback_command=/usr/bin/aqua-recovery
safe_return_to_recovery=ok
EOF

need_log "transcript_written" "${TRANSCRIPT_FILE}" "transcript=first-visible-qemu-attempt"
need_log "transcript_sequence" "${TRANSCRIPT_FILE}" "operator_sequence_ready=true"
need_log "transcript_step_attempt" "${TRANSCRIPT_FILE}" "operator_step_2=/usr/bin/aqua-graphics-visible-qemu-attempt"
need_log "transcript_step_run" "${TRANSCRIPT_FILE}" "operator_step_3=/usr/bin/aqua-compositor-guarded-run"
need_log "transcript_expected_return" "${TRANSCRIPT_FILE}" "expected_return=safe-return-to-recovery"
need_log "transcript_not_started" "${TRANSCRIPT_FILE}" "visible_qemu_attempt_started=false"
need_log "transcript_no_persistent_session" "${TRANSCRIPT_FILE}" "persistent_graphical_session_started=false"
need_log "transcript_no_desktop_shell" "${TRANSCRIPT_FILE}" "desktop_shell_started=false"
need_log "transcript_no_autostart" "${TRANSCRIPT_FILE}" "autostart=false"
need_log "transcript_recovery_safe" "${TRANSCRIPT_FILE}" "safe_return_to_recovery=ok"

echo "graphics_visible_attempt_transcript=ok"
echo "operator_sequence_ready=true"
echo "operator_step_1=/usr/bin/aqua-recovery-help"
echo "operator_step_2=/usr/bin/aqua-graphics-visible-qemu-attempt"
echo "operator_step_3=/usr/bin/aqua-compositor-guarded-run"
echo "expected_bounded_frames=3"
echo "expected_display_output_started=true"
echo "expected_display_output_stopped=true"
echo "expected_return=safe-return-to-recovery"
echo "visible_qemu_attempt_started=false"
echo "visible_qemu_attempt_completed=false"
echo "persistent_graphical_session_started=false"
echo "actual_graphics_started=false"
echo "desktop_shell_started=false"
echo "boot_graphics=false"
echo "autostart=false"
echo "fallback_tty_available=true"
echo "rollback_command=/usr/bin/aqua-recovery"
echo "safe_return_to_recovery=ok"

if [ "${failures}" -eq 0 ]; then
    mark ok
    exit 0
fi

mark error
exit 1
