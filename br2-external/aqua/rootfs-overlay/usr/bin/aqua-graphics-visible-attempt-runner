#!/bin/sh

set -u

CONFIG_PATH="${AQUA_COMPOSITOR_CONFIG:-/etc/aqua/compositor-session.conf}"
ENV_PATH="${AQUA_SESSION_ENV:-/etc/aqua/session.env}"
COMPOSITOR_BIN="${AQUA_COMPOSITOR_BIN:-/usr/bin/aqua-compositor}"
MANUAL_LAUNCH_BIN="${AQUA_MANUAL_LAUNCH_BIN:-/usr/bin/aqua-compositor-manual-launch}"
GUARDED_RUN_BIN="${AQUA_GUARDED_RUN_BIN:-/usr/bin/aqua-compositor-guarded-run}"
RESULT_BIN="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_RESULT_BIN:-/usr/bin/aqua-graphics-visible-attempt-result}"
RUNTIME_DIR="${AQUA_RUNTIME_DIR:-/run/aqua}"
TRANSCRIPT_FILE="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_TRANSCRIPT_FILE:-${RUNTIME_DIR}/graphics-visible-attempt-transcript.plan}"
RUN_LOG="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_RUN_LOG:-${RUNTIME_DIR}/graphics-visible-attempt-run.log}"
RESULT_FILE="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_RESULT_FILE:-${RUNTIME_DIR}/graphics-visible-attempt-runner-result.plan}"
RESULT_LOG="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_RESULT_LOG:-${RUNTIME_DIR}/graphics-visible-attempt-runner-result.log}"

failures=0

mark() {
    status="$1"
    echo "[AQUA-GATE] stage=graphics-visible-attempt-runner status=${status}"
}

need_log() {
    label="$1"
    log="$2"
    needle="$3"

    if [ -f "${log}" ] && grep -Fq "${needle}" "${log}"; then
        echo "${label}=ok"
    else
        echo "${label}=failed"
        failures=$((failures + 1))
    fi
}

need_exec() {
    label="$1"
    path="$2"

    if [ -x "${path}" ]; then
        echo "${label}=present"
    else
        echo "${label}=missing"
        failures=$((failures + 1))
    fi
}

run_guarded() {
    AQUA_COMPOSITOR_CONFIG="${CONFIG_PATH}" \
    AQUA_SESSION_ENV="${ENV_PATH}" \
    AQUA_COMPOSITOR_BIN="${COMPOSITOR_BIN}" \
    AQUA_MANUAL_LAUNCH_BIN="${MANUAL_LAUNCH_BIN}" \
    AQUA_RUNTIME_DIR="${RUNTIME_DIR}" \
    "${GUARDED_RUN_BIN}" > "${RUN_LOG}" 2> "${RUN_LOG}.err"
}

collect_result() {
    AQUA_RUNTIME_DIR="${RUNTIME_DIR}" \
    AQUA_GRAPHICS_VISIBLE_ATTEMPT_TRANSCRIPT_FILE="${TRANSCRIPT_FILE}" \
    AQUA_GRAPHICS_VISIBLE_ATTEMPT_RUN_LOG="${RUN_LOG}" \
    AQUA_GRAPHICS_VISIBLE_ATTEMPT_RESULT_FILE="${RESULT_FILE}" \
    "${RESULT_BIN}" > "${RESULT_LOG}" 2> "${RESULT_LOG}.err"
}

mkdir -p "${RUNTIME_DIR}" 2>/dev/null || failures=$((failures + 1))
chmod 700 "${RUNTIME_DIR}" 2>/dev/null || true

echo "product=Aqua Linux"
echo "tool=aqua-graphics-visible-attempt-runner"
echo "visible_attempt_runner_status=qemu-safe-visible-attempt-runner-complete"
echo "mode=text-recovery"
echo "runner_mode=manual-visible-qemu-attempt"
echo "transcript_file=${TRANSCRIPT_FILE}"
echo "run_log=${RUN_LOG}"
echo "result_file=${RESULT_FILE}"
echo "result_log=${RESULT_LOG}"

need_exec "guarded_run_tool" "${GUARDED_RUN_BIN}"
need_exec "result_collector_tool" "${RESULT_BIN}"
need_log "source_transcript_ready" "${TRANSCRIPT_FILE}" "transcript=first-visible-qemu-attempt"
need_log "source_transcript_command" "${TRANSCRIPT_FILE}" "operator_step_3=/usr/bin/aqua-compositor-guarded-run"
need_log "source_transcript_expected_return" "${TRANSCRIPT_FILE}" "expected_return=safe-return-to-recovery"

if [ "${failures}" -eq 0 ] && run_guarded; then
    echo "attempt_guarded_run=ok"
else
    echo "attempt_guarded_run=failed"
    failures=$((failures + 1))
fi

need_log "attempt_run_status" "${RUN_LOG}" "run_status=qemu-safe-guarded-compositor-run-complete"
need_log "attempt_bounded_run" "${RUN_LOG}" "bounded_run_complete=ok"
need_log "attempt_frames" "${RUN_LOG}" "bounded_run_frames=3"
need_log "attempt_display_started" "${RUN_LOG}" "display_output_started=true"
need_log "attempt_display_stopped" "${RUN_LOG}" "display_output_stopped=true"
need_log "attempt_recovery_safe" "${RUN_LOG}" "safe_return_to_recovery=ok"

if [ "${failures}" -eq 0 ] && collect_result; then
    echo "attempt_result_collector=ok"
else
    echo "attempt_result_collector=failed"
    failures=$((failures + 1))
fi

need_log "result_status" "${RESULT_LOG}" "[AQUA-GATE] stage=graphics-visible-attempt-result status=ok"
need_log "result_run_log_present" "${RESULT_LOG}" "run_log_status=present"
need_log "result_completed" "${RESULT_LOG}" "attempt_result=completed-bounded-run"
need_log "result_attempt_completed" "${RESULT_LOG}" "visible_qemu_attempt_completed=true"
need_log "result_display_started" "${RESULT_LOG}" "display_output_started=true"
need_log "result_display_stopped" "${RESULT_LOG}" "display_output_stopped=true"
need_log "result_no_persistent_session" "${RESULT_LOG}" "persistent_graphical_session_started=false"
need_log "result_no_desktop_shell" "${RESULT_LOG}" "desktop_shell_started=false"
need_log "result_no_boot_graphics" "${RESULT_LOG}" "boot_graphics=false"
need_log "result_no_autostart" "${RESULT_LOG}" "autostart=false"
need_log "result_recovery_safe" "${RESULT_LOG}" "safe_return_to_recovery=ok"

echo "graphics_visible_attempt_runner=ok"
echo "attempt_result=completed-bounded-run"
echo "visible_qemu_attempt_started=true"
echo "visible_qemu_attempt_completed=true"
echo "bounded_run_frames=3"
echo "display_output_started=true"
echo "display_output_stopped=true"
echo "persistent_graphical_session_started=false"
echo "desktop_shell_started=false"
echo "boot_graphics=false"
echo "autostart=false"
echo "fallback_tty_available=true"
echo "manual_operator_required=true"
echo "safe_return_to_recovery=ok"

if [ "${failures}" -eq 0 ]; then
    mark ok
    exit 0
fi

mark error
exit 1
