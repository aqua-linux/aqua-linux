#!/bin/sh

set -u

RUNTIME_DIR="${AQUA_RUNTIME_DIR:-/run/aqua}"
ROLLBACK_FILE="${AQUA_GRAPHICS_ROLLBACK_DRILL_FILE:-${RUNTIME_DIR}/graphics-rollback-drill.plan}"
PREFLIGHT_FILE="${AQUA_GRAPHICS_STARTUP_PREFLIGHT_FILE:-${RUNTIME_DIR}/graphics-startup-preflight.plan}"

failures=0

mark() {
    status="$1"
    echo "[AQUA-GATE] stage=graphics-startup-preflight status=${status}"
}

need_log() {
    label="$1"
    log="$2"
    needle="$3"

    if [ -f "${log}" ] && grep -Fq "${needle}" "${log}"; then
        echo "${label}=ok"
    else
        echo "${label}=failed"
        failures=$((failures + 1))
    fi
}

mkdir -p "${RUNTIME_DIR}" 2>/dev/null || failures=$((failures + 1))
chmod 700 "${RUNTIME_DIR}" 2>/dev/null || true

echo "product=Aqua Linux"
echo "tool=aqua-graphics-startup-preflight"
echo "startup_preflight_status=qemu-safe-guarded-startup-preflight-ready"
echo "mode=text-recovery"
echo "preflight_mode=no-start-bounded-startup"
echo "rollback_file=${ROLLBACK_FILE}"
echo "preflight_file=${PREFLIGHT_FILE}"

need_log "source_rollback_ready" "${ROLLBACK_FILE}" "drill=graphics-rollback"
need_log "source_rollback_cancel_path" "${ROLLBACK_FILE}" "operator_cancel_simulated=true"
need_log "source_rollback_failure_path" "${ROLLBACK_FILE}" "startup_failure_simulated=true"
need_log "source_rollback_verified" "${ROLLBACK_FILE}" "rollback_verified=true"
need_log "source_rollback_command" "${ROLLBACK_FILE}" "rollback_command=/usr/bin/aqua-recovery"
need_log "source_rollback_no_actual_start" "${ROLLBACK_FILE}" "actual_graphics_started=false"
need_log "source_rollback_no_display_start" "${ROLLBACK_FILE}" "display_output_started=false"
need_log "source_rollback_recovery_safe" "${ROLLBACK_FILE}" "safe_return_to_recovery=ok"

cat > "${PREFLIGHT_FILE}" <<'EOF' || failures=$((failures + 1))
product=Aqua Linux
preflight=guarded-graphics-startup
mode=text-recovery
preflight_mode=no-start-bounded-startup
source_rollback=graphics-rollback-drill
bounded_startup_candidate=true
operator_ack_required=true
fallback_tty_required=true
fallback_tty_available=true
rollback_verified=true
rollback_command=/usr/bin/aqua-recovery
startup_preflight_passed=true
startup_preflight_decision=allow-bounded-manual-preflight-only
candidate_started=false
actual_graphics_started=false
display_output_started=false
desktop_shell_started=false
boot_graphics=false
autostart=false
max_bounded_frames=3
startup_timeout_seconds=5
safe_return_to_recovery=ok
next_qemu_command=/usr/bin/aqua-compositor-guarded-run
EOF

need_log "preflight_written" "${PREFLIGHT_FILE}" "preflight=guarded-graphics-startup"
need_log "preflight_bounded_candidate" "${PREFLIGHT_FILE}" "bounded_startup_candidate=true"
need_log "preflight_operator_ack" "${PREFLIGHT_FILE}" "operator_ack_required=true"
need_log "preflight_fallback_tty" "${PREFLIGHT_FILE}" "fallback_tty_available=true"
need_log "preflight_rollback_verified" "${PREFLIGHT_FILE}" "rollback_verified=true"
need_log "preflight_decision" "${PREFLIGHT_FILE}" "startup_preflight_decision=allow-bounded-manual-preflight-only"
need_log "preflight_not_started" "${PREFLIGHT_FILE}" "candidate_started=false"
need_log "preflight_no_actual_graphics" "${PREFLIGHT_FILE}" "actual_graphics_started=false"
need_log "preflight_no_display_start" "${PREFLIGHT_FILE}" "display_output_started=false"
need_log "preflight_recovery_safe" "${PREFLIGHT_FILE}" "safe_return_to_recovery=ok"

echo "graphics_startup_preflight=ok"
echo "preflight_written=ok"
echo "bounded_startup_candidate=true"
echo "operator_ack_required=true"
echo "fallback_tty_available=true"
echo "rollback_verified=true"
echo "rollback_command=/usr/bin/aqua-recovery"
echo "startup_preflight_passed=true"
echo "startup_preflight_decision=allow-bounded-manual-preflight-only"
echo "candidate_started=false"
echo "actual_graphics_started=false"
echo "display_output_started=false"
echo "desktop_shell_started=false"
echo "boot_graphics=false"
echo "autostart=false"
echo "max_bounded_frames=3"
echo "startup_timeout_seconds=5"
echo "safe_return_to_recovery=ok"
echo "next_qemu_command=/usr/bin/aqua-compositor-guarded-run"

if [ "${failures}" -eq 0 ]; then
    mark ok
    exit 0
fi

mark error
exit 1
