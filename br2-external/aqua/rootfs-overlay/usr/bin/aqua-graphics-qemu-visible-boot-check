#!/bin/sh

set -u

RUNTIME_DIR="${AQUA_RUNTIME_DIR:-/run/aqua}"
RUNNER_RESULT_LOG="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_RESULT_LOG:-${RUNTIME_DIR}/graphics-visible-attempt-runner-result.log}"
RUNNER_RESULT_FILE="${AQUA_GRAPHICS_VISIBLE_ATTEMPT_RESULT_FILE:-${RUNTIME_DIR}/graphics-visible-attempt-runner-result.plan}"
BOOT_CHECK_FILE="${AQUA_GRAPHICS_QEMU_VISIBLE_BOOT_CHECK_FILE:-${RUNTIME_DIR}/graphics-qemu-visible-boot-check.plan}"

failures=0

mark() {
    status="$1"
    echo "[AQUA-GATE] stage=graphics-qemu-visible-boot-check status=${status}"
}

need_log() {
    label="$1"
    log="$2"
    needle="$3"

    if [ -f "${log}" ] && grep -Fq "${needle}" "${log}"; then
        echo "${label}=ok"
    else
        echo "${label}=failed"
        failures=$((failures + 1))
    fi
}

mkdir -p "${RUNTIME_DIR}" 2>/dev/null || failures=$((failures + 1))
chmod 700 "${RUNTIME_DIR}" 2>/dev/null || true

echo "product=Aqua Linux"
echo "tool=aqua-graphics-qemu-visible-boot-check"
echo "qemu_visible_boot_check_status=qemu-visible-boot-path-check-ready"
echo "mode=text-recovery"
echo "runner_result_log=${RUNNER_RESULT_LOG}"
echo "runner_result_file=${RUNNER_RESULT_FILE}"
echo "boot_check_file=${BOOT_CHECK_FILE}"

need_log "runner_result_ready" "${RUNNER_RESULT_LOG}" "[AQUA-GATE] stage=graphics-visible-attempt-result status=ok"
need_log "runner_result_log_present" "${RUNNER_RESULT_LOG}" "run_log_status=present"
need_log "runner_result_completed" "${RUNNER_RESULT_LOG}" "attempt_result=completed-bounded-run"
need_log "runner_attempt_completed" "${RUNNER_RESULT_LOG}" "visible_qemu_attempt_completed=true"
need_log "runner_display_started" "${RUNNER_RESULT_LOG}" "display_output_started=true"
need_log "runner_display_stopped" "${RUNNER_RESULT_LOG}" "display_output_stopped=true"
need_log "runner_no_persistent" "${RUNNER_RESULT_LOG}" "persistent_graphical_session_started=false"
need_log "runner_no_desktop_shell" "${RUNNER_RESULT_LOG}" "desktop_shell_started=false"
need_log "runner_no_boot_graphics" "${RUNNER_RESULT_LOG}" "boot_graphics=false"
need_log "runner_no_autostart" "${RUNNER_RESULT_LOG}" "autostart=false"
need_log "runner_recovery_safe" "${RUNNER_RESULT_LOG}" "safe_return_to_recovery=ok"

{
    echo "product=Aqua Linux"
    echo "check=qemu-visible-boot-path"
    echo "mode=text-recovery"
    echo "source_result=graphics-visible-attempt-runner"
    echo "qemu_visible_boot_path_ready=true"
    echo "qemu_vm_display_observed=false"
    echo "manual_observation_required=true"
    echo "manual_operator_required=true"
    echo "bounded_attempt_completed=true"
    echo "bounded_run_frames=3"
    echo "display_output_started=true"
    echo "display_output_stopped=true"
    echo "persistent_graphical_session_started=false"
    echo "desktop_shell_started=false"
    echo "boot_graphics=false"
    echo "autostart=false"
    echo "fallback_tty_available=true"
    echo "rollback_command=/usr/bin/aqua-recovery"
    echo "safe_return_to_recovery=ok"
} > "${BOOT_CHECK_FILE}" || failures=$((failures + 1))

need_log "boot_check_written" "${BOOT_CHECK_FILE}" "check=qemu-visible-boot-path"
need_log "boot_path_ready" "${BOOT_CHECK_FILE}" "qemu_visible_boot_path_ready=true"
need_log "vm_display_not_observed" "${BOOT_CHECK_FILE}" "qemu_vm_display_observed=false"
need_log "manual_observation_required" "${BOOT_CHECK_FILE}" "manual_observation_required=true"
need_log "bounded_attempt_completed" "${BOOT_CHECK_FILE}" "bounded_attempt_completed=true"
need_log "boot_check_no_persistent" "${BOOT_CHECK_FILE}" "persistent_graphical_session_started=false"
need_log "boot_check_no_desktop_shell" "${BOOT_CHECK_FILE}" "desktop_shell_started=false"
need_log "boot_check_no_boot_graphics" "${BOOT_CHECK_FILE}" "boot_graphics=false"
need_log "boot_check_no_autostart" "${BOOT_CHECK_FILE}" "autostart=false"
need_log "boot_check_recovery_safe" "${BOOT_CHECK_FILE}" "safe_return_to_recovery=ok"

echo "graphics_qemu_visible_boot_check=ok"
echo "qemu_visible_boot_path_ready=true"
echo "qemu_vm_display_observed=false"
echo "manual_observation_required=true"
echo "bounded_attempt_completed=true"
echo "bounded_run_frames=3"
echo "display_output_started=true"
echo "display_output_stopped=true"
echo "persistent_graphical_session_started=false"
echo "desktop_shell_started=false"
echo "boot_graphics=false"
echo "autostart=false"
echo "fallback_tty_available=true"
echo "safe_return_to_recovery=ok"

if [ "${failures}" -eq 0 ]; then
    mark ok
    exit 0
fi

mark error
exit 1
