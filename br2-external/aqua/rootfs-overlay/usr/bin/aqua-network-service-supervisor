#!/bin/sh

set -u

CONFIG_PATH="${AQUA_NETWORK_SERVICES_CONFIG:-/etc/aqua/network-services.conf}"
CONTROL_DIR="${AQUA_NETWORK_CONTROL_DIR:-/run/aqua-network}"
STATE_FILE="${AQUA_NETWORK_SUPERVISOR_STATE_FILE:-${CONTROL_DIR}/network-service-supervisor.state}"
PID_FILE="${AQUA_NETWORK_SUPERVISOR_PID_FILE:-${CONTROL_DIR}/network-service-supervisor.pid}"
STOP_FILE="${AQUA_NETWORK_SUPERVISOR_STOP_FILE:-${CONTROL_DIR}/network-service-supervisor.stop}"
READY_FILE="${AQUA_NETWORK_READY_FILE:-${CONTROL_DIR}/lease.ready}"
DRY_RUN="${AQUA_NETWORK_SUPERVISOR_DRY_RUN:-false}"
TEST_MODE="${AQUA_NETWORK_SUPERVISOR_TEST_MODE:-false}"
INTERFACE_ROOT="${AQUA_NETWORK_SYS_CLASS_NET:-/sys/class/net}"
ROUTE_TABLE="${AQUA_NETWORK_ROUTE_TABLE:-/proc/net/route}"
RESOLVER_FILE="${AQUA_NETWORK_RESOLVER_FILE:-/etc/resolv.conf}"
MAX_ROUTE_BYTES="${AQUA_NETWORK_MAX_ROUTE_BYTES:-16384}"
MAX_RESOLVER_BYTES="${AQUA_NETWORK_MAX_RESOLVER_BYTES:-4096}"

config_value() {
    key="$1"
    fallback="$2"
    value=""
    if [ -f "${CONFIG_PATH}" ]; then
        value="$(sed -n "s/^${key}=//p" "${CONFIG_PATH}" | tail -n 1)"
    fi
    printf '%s\n' "${value:-${fallback}}"
}

ENABLED="${AQUA_NETWORK_SERVICES_ENABLED:-$(config_value enabled false)}"
INTERFACE="${AQUA_NETWORK_INTERFACE:-$(config_value interface eth0)}"
UDHCPC_BIN="${AQUA_UDHCPC_BIN:-$(config_value udhcpc_binary /usr/bin/aqua-udhcpc-client)}"
UDHCPC_HOOK="${AQUA_UDHCPC_HOOK:-/usr/bin/aqua-udhcpc-hook}"
UDHCPC_DEFAULT_SCRIPT="${AQUA_UDHCPC_DEFAULT_SCRIPT:-$(config_value udhcpc_default_script /usr/share/udhcpc/default.script)}"
LEGACY_OWNER_DISABLED="${AQUA_NETWORK_LEGACY_OWNER_DISABLED:-$(config_value legacy_owner_disabled false)}"
MAX_RESTARTS="${AQUA_NETWORK_MAX_RESTARTS:-$(config_value max_restarts 3)}"
RESTART_DELAY="${AQUA_NETWORK_RESTART_DELAY_SECONDS:-$(config_value restart_delay_seconds 2)}"
READY_TIMEOUT="${AQUA_NETWORK_READY_TIMEOUT_SECONDS:-$(config_value readiness_timeout_seconds 20)}"
LEASE_GRACE="${AQUA_NETWORK_LEASE_LOSS_GRACE_SECONDS:-$(config_value lease_loss_grace_seconds 5)}"
MONITOR_INTERVAL="${AQUA_NETWORK_MONITOR_INTERVAL_SECONDS:-$(config_value monitor_interval_seconds 1)}"
STOP_TIMEOUT="${AQUA_NETWORK_STOP_TIMEOUT_SECONDS:-$(config_value stop_timeout_seconds 5)}"

client_pid=""
termination_requested=false

mark() {
    echo "[AQUA-NETWORK] stage=network-service-supervisor status=$1 $2"
}

valid_unsigned() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

valid_interface() {
    case "$1" in
        ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-]*|????????????????*) return 1 ;;
        *) return 0 ;;
    esac
}

valid_binary() {
    path="$1"
    [ "${path#/}" != "${path}" ] && [ -f "${path}" ] &&
        [ -x "${path}" ] && [ ! -L "${path}" ]
}

bounded_file() {
    path="$1"
    limit="$2"
    [ -f "${path}" ] || return 1
    bytes="$(wc -c < "${path}" 2>/dev/null)" || return 1
    bytes="$(printf '%s' "${bytes}" | tr -d '[:space:]')"
    valid_unsigned "${bytes}" && [ "${bytes}" -le "${limit}" ]
}

route_ready() {
    bounded_file "${ROUTE_TABLE}" "${MAX_ROUTE_BYTES}" || return 1
    while read -r route_interface destination gateway flags remainder; do
        [ "${route_interface}" = "${INTERFACE}" ] || continue
        [ "${destination}" = 00000000 ] || continue
        case "${flags}" in
            ????) last_flag="${flags#???}" ;;
            ????????) last_flag="${flags#???????}" ;;
            *) continue ;;
        esac
        case "${flags}" in *[!0123456789abcdefABCDEF]*) continue ;; esac
        case "${last_flag}" in
            1|3|5|7|9|b|B|d|D|f|F) return 0 ;;
        esac
    done < "${ROUTE_TABLE}"
    return 1
}

valid_ipv4() {
    old_ifs="${IFS}"
    IFS=.
    set -- $1
    IFS="${old_ifs}"
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        valid_unsigned "${octet}" && [ "${octet}" -le 255 ] || return 1
    done
}

valid_dns_address() {
    address="$1"
    if valid_ipv4 "${address}"; then
        return 0
    fi
    case "${address}" in
        *:*)
            [ "${#address}" -le 45 ] || return 1
            case "${address}" in *[!0123456789abcdefABCDEF:.]*) return 1 ;; esac
            return 0
            ;;
    esac
    return 1
}

dns_ready() {
    bounded_file "${RESOLVER_FILE}" "${MAX_RESOLVER_BYTES}" || return 1
    while read -r directive address remainder; do
        [ "${directive}" = nameserver ] || continue
        valid_dns_address "${address:-}" && return 0
    done < "${RESOLVER_FILE}"
    return 1
}

network_health_failure() {
    route_ready || { echo route; return; }
    dns_ready || { echo dns; return; }
    echo none
}

write_state() {
    state="$1"
    attempts="$2"
    restarts="$3"
    failure="$4"
    tmp="${STATE_FILE}.tmp.$$"
    {
        echo 'product=Aqua Linux'
        echo "state=${state}"
        echo "interface=${INTERFACE}"
        echo "attempts=${attempts}"
        echo "restarts=${restarts}"
        echo "max_restarts=${MAX_RESTARTS}"
        echo "failure=${failure}"
        echo "client_pid=${client_pid}"
        echo "lease_ready=$([ -f "${READY_FILE}" ] && [ ! -L "${READY_FILE}" ] && echo true || echo false)"
        echo "route_ready=$(route_ready && echo true || echo false)"
        echo "dns_ready=$(dns_ready && echo true || echo false)"
        echo "service_owner_uid=$(id -u)"
        echo 'policy_owner=aqua-network-service-supervisor'
        echo "legacy_owner_disabled=${LEGACY_OWNER_DISABLED}"
        echo 'settings_management=false'
        echo 'wifi_packaged=false'
    } > "${tmp}" && chmod 644 "${tmp}" && mv "${tmp}" "${STATE_FILE}"
}

stop_client() {
    [ -n "${client_pid}" ] || return 0
    if kill -0 "${client_pid}" 2>/dev/null; then
        kill "${client_pid}" 2>/dev/null || true
        waited=0
        while kill -0 "${client_pid}" 2>/dev/null && [ "${waited}" -lt "${STOP_TIMEOUT}" ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if kill -0 "${client_pid}" 2>/dev/null; then
            kill -9 "${client_pid}" 2>/dev/null || true
            mark stopping "service=udhcpc forced=true"
        else
            mark stopping "service=udhcpc forced=false"
        fi
    fi
    wait "${client_pid}" 2>/dev/null || true
    client_pid=""
    rm -f "${READY_FILE}" 2>/dev/null || true
}

cleanup() {
    stop_client
    if [ -f "${PID_FILE}" ] && [ "$(cat "${PID_FILE}" 2>/dev/null || true)" = "$$" ]; then
        rm -f "${PID_FILE}"
    fi
}

trap 'termination_requested=true' HUP INT TERM
trap cleanup EXIT

for value in "${MAX_RESTARTS}" "${RESTART_DELAY}" "${READY_TIMEOUT}" \
    "${LEASE_GRACE}" "${MONITOR_INTERVAL}" "${STOP_TIMEOUT}" \
    "${MAX_ROUTE_BYTES}" "${MAX_RESOLVER_BYTES}"; do
    if ! valid_unsigned "${value}"; then
        mark blocked "reason=invalid-policy"
        exit 2
    fi
done
if [ "${READY_TIMEOUT}" -eq 0 ] || [ "${MONITOR_INTERVAL}" -eq 0 ] ||
   [ "${STOP_TIMEOUT}" -eq 0 ] || [ "${MAX_ROUTE_BYTES}" -eq 0 ] ||
   [ "${MAX_RESOLVER_BYTES}" -eq 0 ] || ! valid_interface "${INTERFACE}"; then
    mark blocked "reason=invalid-policy"
    exit 2
fi
if [ -L "${CONTROL_DIR}" ]; then
    mark blocked "reason=unsafe-control-directory"
    exit 2
fi
mkdir -p "${CONTROL_DIR}" || {
    mark blocked "reason=control-directory"
    exit 2
}
if [ ! -d "${CONTROL_DIR}" ]; then
    mark blocked "reason=unsafe-control-directory"
    exit 2
fi
chmod 755 "${CONTROL_DIR}" 2>/dev/null || true

if [ "${DRY_RUN}" = true ]; then
    write_state policy-ready 0 0 none
    mark ok "mode=dry-run enabled=${ENABLED} interface=${INTERFACE} legacy_owner_disabled=${LEGACY_OWNER_DISABLED}"
    exit 0
fi
if [ "${ENABLED}" != true ]; then
    write_state disabled 0 0 none
    mark disabled "reason=transition-not-enabled boot_owner=none"
    exit 0
fi
if [ "${TEST_MODE}" != true ]; then
    control_owner="$(ls -nd "${CONTROL_DIR}" 2>/dev/null | awk '{print $3}')"
    control_permissions="$(LC_ALL=C ls -ld "${CONTROL_DIR}" 2>/dev/null | awk '{print substr($1, 1, 10)}')"
    if [ "${control_owner}" != 0 ] || [ "${control_permissions}" != drwxr-xr-x ]; then
        mark blocked "reason=unsafe-control-directory"
        exit 2
    fi
fi
if [ "$(id -u)" -ne 0 ] && [ "${TEST_MODE}" != true ]; then
    write_state blocked 0 0 ownership
    mark blocked "reason=root-service-required uid=$(id -u)"
    exit 1
fi
if [ "${LEGACY_OWNER_DISABLED}" != true ]; then
    write_state blocked 0 0 policy-conflict
    mark blocked "reason=legacy-owner-not-declared-disabled owner=buildroot-s40network"
    exit 1
fi
if [ -L "${INTERFACE_ROOT}" ] || [ ! -d "${INTERFACE_ROOT}/${INTERFACE}" ]; then
    write_state degraded 0 0 interface
    mark degraded "reason=interface-not-present interface=${INTERFACE}"
    exit 1
fi
for binary in "${UDHCPC_BIN}" "${UDHCPC_HOOK}" "${UDHCPC_DEFAULT_SCRIPT}"; do
    if ! valid_binary "${binary}"; then
        write_state degraded 0 0 preflight
        mark degraded "reason=invalid-service-binary binary=${binary}"
        exit 1
    fi
done

if [ -f "${PID_FILE}" ]; then
    old_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    case "${old_pid}" in
        ''|*[!0-9]*) ;;
        *) if kill -0 "${old_pid}" 2>/dev/null; then mark duplicate "pid=${old_pid}"; exit 1; fi ;;
    esac
fi
rm -f "${PID_FILE}" "${STOP_FILE}" "${READY_FILE}" 2>/dev/null || true
echo "$$" > "${PID_FILE}"

export AQUA_NETWORK_INTERFACE="${INTERFACE}"
export AQUA_NETWORK_READY_FILE="${READY_FILE}"
export AQUA_NETWORK_RESOLVER_FILE="${RESOLVER_FILE}"
export AQUA_UDHCPC_DEFAULT_SCRIPT="${UDHCPC_DEFAULT_SCRIPT}"

attempts=0
restarts=0
while :; do
    attempts=$((attempts + 1))
    rm -f "${READY_FILE}" 2>/dev/null || true
    mark starting "service=udhcpc interface=${INTERFACE} attempt=${attempts} restart=${restarts}"
    "${UDHCPC_BIN}" -f -n -i "${INTERFACE}" -s "${UDHCPC_HOOK}" >> "${CONTROL_DIR}/udhcpc.log" 2>&1 &
    client_pid="$!"
    write_state starting "${attempts}" "${restarts}" none

    waited=0
    failure=none
    while [ ! -f "${READY_FILE}" ] && kill -0 "${client_pid}" 2>/dev/null &&
          [ "${waited}" -lt "${READY_TIMEOUT}" ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if ! kill -0 "${client_pid}" 2>/dev/null; then
        failure=dhcp-client
    elif [ ! -f "${READY_FILE}" ] || [ -L "${READY_FILE}" ]; then
        failure=dhcp-readiness
    else
        health_failure="$(network_health_failure)"
        if [ "${health_failure}" != none ]; then
            failure="${health_failure}-readiness"
        else
            write_state running "${attempts}" "${restarts}" none
            mark running "interface=${INTERFACE} attempt=${attempts} restart=${restarts} client_pid=${client_pid} route=true dns=true"
        fi
    fi

    lease_missing=0
    health_missing=0
    health_failure=none
    while [ "${failure}" = none ]; do
        if [ "${termination_requested}" = true ] || [ -f "${STOP_FILE}" ]; then
            stop_client
            write_state stopped "${attempts}" "${restarts}" none
            rm -f "${STOP_FILE}"
            mark stopped "reason=requested interface=${INTERFACE}"
            exit 0
        fi
        if ! kill -0 "${client_pid}" 2>/dev/null; then
            failure=dhcp-client
            break
        fi
        if [ ! -f "${READY_FILE}" ] || [ -L "${READY_FILE}" ]; then
            lease_missing=$((lease_missing + MONITOR_INTERVAL))
            if [ "${lease_missing}" -ge "${LEASE_GRACE}" ]; then
                failure=lease-lost
                break
            fi
        else
            lease_missing=0
        fi
        current_health_failure="$(network_health_failure)"
        if [ "${current_health_failure}" != none ]; then
            health_failure="${current_health_failure}"
            health_missing=$((health_missing + MONITOR_INTERVAL))
            if [ "${health_missing}" -ge "${LEASE_GRACE}" ]; then
                failure="${health_failure}-lost"
                break
            fi
        else
            health_missing=0
            health_failure=none
        fi
        sleep "${MONITOR_INTERVAL}"
    done

    stop_client
    if [ "${restarts}" -ge "${MAX_RESTARTS}" ]; then
        write_state degraded "${attempts}" "${restarts}" "${failure}"
        mark degraded "reason=restart-limit failure=${failure} attempts=${attempts} restarts=${restarts}"
        exit 1
    fi
    restarts=$((restarts + 1))
    write_state restarting "${attempts}" "${restarts}" "${failure}"
    mark restarting "failure=${failure} next_restart=${restarts} delay_seconds=${RESTART_DELAY}"
    [ "${RESTART_DELAY}" -gt 0 ] && sleep "${RESTART_DELAY}"
done
