#!/bin/sh

set -u

RUNTIME_DIR="${AQUA_RUNTIME_DIR:-/run/aqua}"
GATE_FILE="${AQUA_GRAPHICS_ENABLE_GATE_FILE:-${RUNTIME_DIR}/graphics-enable-gate-positive.plan}"
CANDIDATE_FILE="${AQUA_GRAPHICS_LAUNCH_CANDIDATE_FILE:-${RUNTIME_DIR}/graphics-launch-candidate.plan}"

failures=0

mark() {
    status="$1"
    echo "[AQUA-GATE] stage=graphics-launch-candidate status=${status}"
}

need_log() {
    label="$1"
    log="$2"
    needle="$3"

    if [ -f "${log}" ] && grep -Fq "${needle}" "${log}"; then
        echo "${label}=ok"
    else
        echo "${label}=failed"
        failures=$((failures + 1))
    fi
}

mkdir -p "${RUNTIME_DIR}" 2>/dev/null || failures=$((failures + 1))
chmod 700 "${RUNTIME_DIR}" 2>/dev/null || true

echo "product=Aqua Linux"
echo "tool=aqua-graphics-launch-candidate"
echo "candidate_status=qemu-safe-graphics-launch-candidate-ready"
echo "mode=text-recovery"
echo "launch_mode=no-start-dry-run"
echo "gate_file=${GATE_FILE}"
echo "candidate_file=${CANDIDATE_FILE}"

need_log "source_gate_ready" "${GATE_FILE}" "enable_decision=allow-dry-run"
need_log "source_gate_allowable" "${GATE_FILE}" "currently_allowable=true"
need_log "source_gate_no_actual_start" "${GATE_FILE}" "actual_graphics_started=false"
need_log "source_gate_recovery_safe" "${GATE_FILE}" "safe_return_to_recovery=ok"

cat > "${CANDIDATE_FILE}" <<'EOF' || failures=$((failures + 1))
product=Aqua Linux
candidate=manual-graphics-launch
mode=text-recovery
launch_mode=no-start-dry-run
source_gate=graphics-enable-gate-positive
supervision=required
operator_ack_required=true
candidate_allowable=true
candidate_selected=true
candidate_started=false
actual_graphics_started=false
display_output_started=false
desktop_shell_started=false
boot_graphics=false
autostart=false
fallback_tty_available=true
rollback_required=true
rollback_strategy=return-to-text-recovery
rollback_command=/usr/bin/aqua-recovery
rollback_trigger=any-startup-failure-or-operator-cancel
safe_return_to_recovery=ok
next_qemu_command=/usr/bin/aqua-compositor-preview-exec
next_host_command=aqua-host-tools --features host-window-preview -- smoke-manual-execution-window
EOF

need_log "candidate_written" "${CANDIDATE_FILE}" "candidate=manual-graphics-launch"
need_log "candidate_allowable" "${CANDIDATE_FILE}" "candidate_allowable=true"
need_log "candidate_selected" "${CANDIDATE_FILE}" "candidate_selected=true"
need_log "candidate_not_started" "${CANDIDATE_FILE}" "candidate_started=false"
need_log "candidate_no_actual_graphics" "${CANDIDATE_FILE}" "actual_graphics_started=false"
need_log "candidate_no_display_start" "${CANDIDATE_FILE}" "display_output_started=false"
need_log "candidate_rollback" "${CANDIDATE_FILE}" "rollback_strategy=return-to-text-recovery"
need_log "candidate_recovery_safe" "${CANDIDATE_FILE}" "safe_return_to_recovery=ok"

echo "graphics_launch_candidate=ok"
echo "candidate_written=ok"
echo "candidate_allowable=true"
echo "candidate_selected=true"
echo "candidate_started=false"
echo "actual_graphics_started=false"
echo "display_output_started=false"
echo "desktop_shell_started=false"
echo "boot_graphics=false"
echo "autostart=false"
echo "fallback_tty_available=true"
echo "rollback_required=true"
echo "rollback_strategy=return-to-text-recovery"
echo "rollback_command=/usr/bin/aqua-recovery"
echo "safe_return_to_recovery=ok"
echo "next_qemu_command=/usr/bin/aqua-compositor-preview-exec"
echo "next_host_command=aqua-host-tools --features host-window-preview -- smoke-manual-execution-window"

if [ "${failures}" -eq 0 ]; then
    mark ok
    exit 0
fi

mark error
exit 1
