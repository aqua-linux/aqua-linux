#!/bin/sh

set -u

CONFIG_PATH="${AQUA_MEDIA_SERVICES_CONFIG:-/etc/aqua/media-services.conf}"
CONTROL_DIR="${AQUA_SESSION_CONTROL_DIR:-${AQUA_RUNTIME_DIR:-/run/aqua}}"
SESSION_RUNTIME_DIR="${AQUA_SESSION_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/1000}}"
STATE_FILE="${AQUA_MEDIA_SUPERVISOR_STATE_FILE:-${CONTROL_DIR}/media-service-supervisor.state}"
PID_FILE="${AQUA_MEDIA_SUPERVISOR_PID_FILE:-${CONTROL_DIR}/media-service-supervisor.pid}"
STOP_FILE="${AQUA_MEDIA_SUPERVISOR_STOP_FILE:-${CONTROL_DIR}/media-service-supervisor.stop}"
READY_PATH="${AQUA_PIPEWIRE_READY_PATH:-${SESSION_RUNTIME_DIR}/pipewire-0}"
READY_KIND="${AQUA_PIPEWIRE_READY_KIND:-socket}"
DRY_RUN="${AQUA_MEDIA_SUPERVISOR_DRY_RUN:-false}"

config_value() {
    key="$1"
    fallback="$2"
    value=""
    if [ -f "${CONFIG_PATH}" ]; then
        value="$(sed -n "s/^${key}=//p" "${CONFIG_PATH}" | tail -n 1)"
    fi
    printf '%s\n' "${value:-${fallback}}"
}

ENABLED="${AQUA_MEDIA_SERVICES_ENABLED:-$(config_value enabled false)}"
PIPEWIRE_BIN="${AQUA_PIPEWIRE_BIN:-$(config_value pipewire_binary /usr/bin/pipewire)}"
WIREPLUMBER_BIN="${AQUA_WIREPLUMBER_BIN:-$(config_value wireplumber_binary /usr/bin/wireplumber)}"
MAX_RESTARTS="${AQUA_MEDIA_MAX_RESTARTS:-$(config_value max_restarts 3)}"
RESTART_DELAY="${AQUA_MEDIA_RESTART_DELAY_SECONDS:-$(config_value restart_delay_seconds 2)}"
READY_TIMEOUT="${AQUA_MEDIA_READY_TIMEOUT_SECONDS:-$(config_value readiness_timeout_seconds 10)}"
WIREPLUMBER_STABLE="${AQUA_WIREPLUMBER_STABLE_SECONDS:-$(config_value wireplumber_stable_seconds 1)}"
STABLE_RUNTIME="${AQUA_MEDIA_STABLE_SECONDS:-$(config_value stable_runtime_seconds 30)}"
MONITOR_INTERVAL="${AQUA_MEDIA_MONITOR_INTERVAL_SECONDS:-$(config_value monitor_interval_seconds 1)}"
STOP_TIMEOUT="${AQUA_MEDIA_STOP_TIMEOUT_SECONDS:-5}"

pipewire_pid=""
wireplumber_pid=""
termination_requested=false

mark() {
    echo "[AQUA-MEDIA] stage=media-service-supervisor status=$1 $2"
}

write_state() {
    state="$1"
    attempts="$2"
    restarts="$3"
    failed_service="$4"
    tmp="${STATE_FILE}.tmp.$$"
    {
        echo "product=Aqua Linux"
        echo "state=${state}"
        echo "attempts=${attempts}"
        echo "restarts=${restarts}"
        echo "max_restarts=${MAX_RESTARTS}"
        echo "failed_service=${failed_service}"
        echo "pipewire_pid=${pipewire_pid}"
        echo "wireplumber_pid=${wireplumber_pid}"
        echo "pipewire_ready_path=${READY_PATH}"
        echo "ordered_start=pipewire,wireplumber"
        echo "ordered_stop=wireplumber,pipewire"
        echo "service_owner_uid=$(id -u)"
        echo "runtime_dir=${SESSION_RUNTIME_DIR}"
        echo "root_media_daemon=false"
    } > "${tmp}" && mv "${tmp}" "${STATE_FILE}"
}

valid_unsigned() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

ready_path_exists() {
    case "${READY_KIND}" in
        socket) [ -S "${READY_PATH}" ] ;;
        file) [ -f "${READY_PATH}" ] && [ ! -L "${READY_PATH}" ] ;;
        *) return 1 ;;
    esac
}

stop_child() {
    child_pid="$1"
    service="$2"
    [ -n "${child_pid}" ] || return 0
    if kill -0 "${child_pid}" 2>/dev/null; then
        kill "${child_pid}" 2>/dev/null || true
        waited=0
        while kill -0 "${child_pid}" 2>/dev/null && [ "${waited}" -lt "${STOP_TIMEOUT}" ]; do
            sleep 1
            waited=$((waited + 1))
        done
        if kill -0 "${child_pid}" 2>/dev/null; then
            kill -9 "${child_pid}" 2>/dev/null || true
            mark stopping "service=${service} forced=true"
        else
            mark stopping "service=${service} forced=false"
        fi
    fi
    wait "${child_pid}" 2>/dev/null || true
}

stop_services() {
    stop_child "${wireplumber_pid}" wireplumber
    wireplumber_pid=""
    stop_child "${pipewire_pid}" pipewire
    pipewire_pid=""
    rm -f "${READY_PATH}" 2>/dev/null || true
}

cleanup() {
    stop_services
    if [ -f "${PID_FILE}" ] && [ "$(cat "${PID_FILE}" 2>/dev/null || true)" = "$$" ]; then
        rm -f "${PID_FILE}"
    fi
}

trap 'termination_requested=true' HUP INT TERM
trap cleanup EXIT

for value in "${MAX_RESTARTS}" "${RESTART_DELAY}" "${READY_TIMEOUT}" \
    "${WIREPLUMBER_STABLE}" "${STABLE_RUNTIME}" "${MONITOR_INTERVAL}" "${STOP_TIMEOUT}"; do
    if ! valid_unsigned "${value}"; then
        mark blocked "reason=invalid-policy"
        exit 2
    fi
done
if [ "${MONITOR_INTERVAL}" -eq 0 ] || [ "${STOP_TIMEOUT}" -eq 0 ]; then
    mark blocked "reason=invalid-policy"
    exit 2
fi
case "${READY_KIND}" in socket|file) ;; *) mark blocked "reason=invalid-ready-kind"; exit 2 ;; esac

mkdir -p "${CONTROL_DIR}" || {
    mark blocked "reason=control-directory"
    exit 2
}
chmod 700 "${CONTROL_DIR}" 2>/dev/null || true

if [ "${DRY_RUN}" = true ]; then
    write_state policy-ready 0 0 none
    mark ok "mode=dry-run enabled=${ENABLED} ordered_start=pipewire,wireplumber ordered_stop=wireplumber,pipewire"
    exit 0
fi

if [ "$(id -u)" -eq 0 ] || [ "${XDG_RUNTIME_DIR:-}" != "${SESSION_RUNTIME_DIR}" ]; then
    write_state blocked 0 0 session
    mark blocked "reason=unprivileged-session-contract uid=$(id -u) runtime_dir=${XDG_RUNTIME_DIR:-missing}"
    exit 1
fi

owner="$(ls -nd "${SESSION_RUNTIME_DIR}" 2>/dev/null | awk '{print $3 ":" $4}')"
permissions="$(LC_ALL=C ls -ld "${SESSION_RUNTIME_DIR}" 2>/dev/null | awk '{print substr($1, 1, 10)}')"
if [ -L "${SESSION_RUNTIME_DIR}" ] || [ ! -d "${SESSION_RUNTIME_DIR}" ] ||
   [ "${owner}" != "$(id -u):$(id -g)" ] || [ "${permissions}" != "drwx------" ]; then
    write_state blocked 0 0 session
    mark blocked "reason=unsafe-runtime-directory path=${SESSION_RUNTIME_DIR}"
    exit 1
fi

if [ "${ENABLED}" != true ]; then
    write_state disabled 0 0 none
    mark disabled "reason=packages-not-enabled root_media_daemon=false"
    exit 0
fi

for binary in "${PIPEWIRE_BIN}" "${WIREPLUMBER_BIN}"; do
    if [ "${binary#/}" = "${binary}" ] || [ ! -f "${binary}" ] ||
       [ ! -x "${binary}" ] || [ -L "${binary}" ]; then
        write_state degraded 0 0 preflight
        mark degraded "reason=invalid-service-binary binary=${binary}"
        exit 1
    fi
done
if [ "${PIPEWIRE_BIN}" = "${WIREPLUMBER_BIN}" ]; then
    write_state degraded 0 0 preflight
    mark degraded "reason=duplicate-service-binary"
    exit 1
fi

if [ -f "${PID_FILE}" ]; then
    old_pid="$(cat "${PID_FILE}" 2>/dev/null || true)"
    case "${old_pid}" in
        ''|*[!0-9]*) ;;
        *)
            if kill -0 "${old_pid}" 2>/dev/null; then
                mark duplicate "pid=${old_pid}"
                exit 1
            fi
            ;;
    esac
fi
rm -f "${PID_FILE}" "${STOP_FILE}" "${READY_PATH}" 2>/dev/null || true
echo "$$" > "${PID_FILE}"

attempts=0
restarts=0
while :; do
    attempts=$((attempts + 1))
    cycle_started="$(date +%s)"
    mark starting "service=pipewire attempt=${attempts} restart=${restarts}"
    "${PIPEWIRE_BIN}" >> "${CONTROL_DIR}/pipewire.log" 2>&1 &
    pipewire_pid="$!"
    write_state starting-pipewire "${attempts}" "${restarts}" none

    ready_waited=0
    while ! ready_path_exists && kill -0 "${pipewire_pid}" 2>/dev/null &&
          [ "${ready_waited}" -lt "${READY_TIMEOUT}" ]; do
        sleep 1
        ready_waited=$((ready_waited + 1))
    done
    failed_service=none
    if ! kill -0 "${pipewire_pid}" 2>/dev/null; then
        failed_service=pipewire
    elif ! ready_path_exists; then
        failed_service=pipewire-readiness
    fi

    if [ "${failed_service}" = none ]; then
        mark ready "service=pipewire attempt=${attempts} ready_path=${READY_PATH}"
        mark starting "service=wireplumber attempt=${attempts} restart=${restarts}"
        "${WIREPLUMBER_BIN}" >> "${CONTROL_DIR}/wireplumber.log" 2>&1 &
        wireplumber_pid="$!"
        stable_waited=0
        while kill -0 "${wireplumber_pid}" 2>/dev/null &&
              [ "${stable_waited}" -lt "${WIREPLUMBER_STABLE}" ]; do
            sleep 1
            stable_waited=$((stable_waited + 1))
        done
        if ! kill -0 "${wireplumber_pid}" 2>/dev/null; then
            failed_service=wireplumber
        else
            write_state running "${attempts}" "${restarts}" none
            mark running "attempt=${attempts} restart=${restarts} pipewire_pid=${pipewire_pid} wireplumber_pid=${wireplumber_pid} ordered=true"
        fi
    fi

    while [ "${failed_service}" = none ]; do
        if [ "${termination_requested}" = true ] || [ -f "${STOP_FILE}" ]; then
            stop_services
            write_state stopped "${attempts}" "${restarts}" none
            rm -f "${STOP_FILE}"
            mark stopped "reason=requested ordered_stop=wireplumber,pipewire"
            exit 0
        fi
        if ! kill -0 "${pipewire_pid}" 2>/dev/null; then
            failed_service=pipewire
            break
        fi
        if ! kill -0 "${wireplumber_pid}" 2>/dev/null; then
            failed_service=wireplumber
            break
        fi
        sleep "${MONITOR_INTERVAL}"
    done

    runtime=$(( $(date +%s) - cycle_started ))
    stop_services
    if [ "${runtime}" -ge "${STABLE_RUNTIME}" ]; then
        restarts=0
    fi
    if [ "${restarts}" -ge "${MAX_RESTARTS}" ]; then
        write_state degraded "${attempts}" "${restarts}" "${failed_service}"
        mark degraded "reason=restart-limit failed_service=${failed_service} attempts=${attempts} restarts=${restarts}"
        exit 1
    fi
    restarts=$((restarts + 1))
    write_state restarting "${attempts}" "${restarts}" "${failed_service}"
    mark restarting "failed_service=${failed_service} next_restart=${restarts} delay_seconds=${RESTART_DELAY}"
    [ "${RESTART_DELAY}" -gt 0 ] && sleep "${RESTART_DELAY}"
done
