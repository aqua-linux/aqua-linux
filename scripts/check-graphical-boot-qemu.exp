run_shell_check {grep -Fq 'crtc_restored=true' /run/aqua/graphical-session-supervisor.log || ok=0} "checking first KMS cleanup"
run_shell_check {grep -Fq 'desktop_runtime_process_exited_files=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_runtime_process_exited_settings=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_runtime_process_active_count=0' /run/aqua/graphical-session-supervisor.log || ok=0} "checking runtime application process cleanup"
run_shell_check {grep -Fq 'gbm_scanout_buffers_released=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'graceful_stop_completed=true' /run/aqua/graphical-session-supervisor.log || ok=0} "checking first GBM cleanup"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-runtime-cleanup-qemu status=ok apps=files,settings lifecycle_clean=true active_count=0 stale_surfaces=0'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-runtime-cleanup-qemu status=ok apps=files,settings lifecycle_clean=true active_count=0 stale_surfaces=0} {}
    timeout { puts stderr "Runtime application processes were not cleaned up"; exit 1 }
    eof { puts stderr "QEMU exited before runtime application cleanup verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Runtime Files cleanup verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after runtime Files cleanup verification"; exit 1 }
}

send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=graphical-stop-qemu status=ok clients_stopped=true kms_restored=true gbm_released=true pid_cleaned=true recovery_return=ok'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=graphical-stop-qemu status=ok clients_stopped=true kms_restored=true gbm_released=true pid_cleaned=true recovery_return=ok} {}
    timeout { puts stderr "Missing graphical stop QEMU verification marker"; exit 1 }
    eof { puts stderr "QEMU exited before graphical stop QEMU marker"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Graphical stop marker did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after graphical stop marker"; exit 1 }
}

send -- {/usr/bin/aqua-graphical-session-boot}
send -- "\r"

expect {
    -re {\[AQUA-BOOT\] stage=graphical-session-activation status=started mode=supervised-unprivileged user=aqua uid=1000 pid=[0-9]+ runtime_dir=/run/user/1000 boot_graphics=true autostart=true recovery_tty=true} {}
    timeout { puts stderr "Second graphical session did not start"; exit 1 }
    eof { puts stderr "QEMU exited before second graphical session start"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Second graphical session start did not return to shell"; exit 1 }
    eof { puts stderr "QEMU exited after second graphical session start"; exit 1 }
}

run_shell_check {i=0; while [ "$i" -lt 30 ] && [ "$(grep -Fc 'stage=drm-wayland-session status=active' /run/aqua/graphical-session-supervisor.log)" -lt 2 ]; do sleep 1; i=$((i + 1)); done} "waiting for the second graphical session"
run_shell_check {ok=1; pid="$(cat /run/aqua/graphical-session-supervisor.pid 2>/dev/null)"} "reading the second supervisor PID"
run_shell_check {[ "$(grep -Fc 'stage=drm-wayland-session status=active' /run/aqua/graphical-session-supervisor.log)" -ge 2 ] || ok=0; [ "$(grep -Fc 'session_lifetime_policy=persistent-until-stop' /run/aqua/graphical-session-supervisor.log)" -ge 2 ] || ok=0} "checking the second persistent DRM session"
run_shell_check {grep -Fq 'state=running' /run/aqua/graphical-session-supervisor.state || ok=0; kill -0 "$pid" 2>/dev/null || ok=0} "checking the second running process"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=graphical-restart-qemu status=ok second_session=active stale_pid=false stale_drm=false stale_socket=false'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=graphical-restart-qemu status=ok second_session=active stale_pid=false stale_drm=false stale_socket=false} {}
    timeout { puts stderr "Second graphical session did not become active"; exit 1 }
    eof { puts stderr "QEMU exited before second graphical session verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Second graphical session verification did not return to shell"; exit 1 }
    eof { puts stderr "QEMU exited after second graphical session verification"; exit 1 }
}

send -- {/usr/bin/aqua-graphical-session-stop}
send -- "\r"

expect {
    -exact {[AQUA-SESSION] stage=graphical-session-stop status=ok supervisor_stopped=true pid_cleaned=true kms_restored=true clients_stopped=true recovery_return=ok} {}
    timeout { puts stderr "Second graphical session did not stop cleanly"; exit 1 }
    eof { puts stderr "QEMU exited before second graphical session cleanup"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Second graphical stop did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after second graphical stop"; exit 1 }
}

run_shell_check {ok=1; test ! -e /run/aqua/graphical-session-supervisor.pid || ok=0; test ! -e /run/user/1000/aqua-wayland-drm-0 || ok=0} "checking final PID and socket cleanup"
run_shell_check {[ "$(grep -Fc 'graceful_stop_completed=true' /run/aqua/graphical-session-supervisor.log)" -ge 2 ] || ok=0; [ "$(grep -Fc 'external_fixture_clients_started=false' /run/aqua/graphical-session-supervisor.log)" -ge 2 ] || ok=0} "checking two-cycle production cleanup"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=graphical-session-cycle-qemu status=ok starts=2 stops=2 sockets_clean=true pids_clean=true clients_clean=true drm_clean=true recovery_return=ok'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=graphical-session-cycle-qemu status=ok starts=2 stops=2 sockets_clean=true pids_clean=true clients_clean=true drm_clean=true recovery_return=ok} {}
    timeout { puts stderr "Graphical start-stop-start cycle did not clean up"; exit 1 }
    eof { puts stderr "QEMU exited before graphical cycle marker"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Graphical cycle marker did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after graphical cycle marker"; exit 1 }
}

send -- "poweroff -f\r"
expect eof
