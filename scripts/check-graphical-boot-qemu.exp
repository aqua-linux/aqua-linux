#!/usr/bin/expect -f

set timeout $env(TIMEOUT_SECONDS)
log_file -noappend $env(SERIAL_LOG)

proc run_shell_check {command description} {
    send -- "$command\r"
    expect {
        -exact {# } {}
        timeout { puts stderr "Timed out while $description"; exit 1 }
        eof { puts stderr "QEMU exited while $description"; exit 1 }
    }
}

spawn qemu-system-x86_64 \
    -machine accel=tcg \
    -cpu max \
    -smp $env(CPUS) \
    -m $env(MEMORY) \
    -kernel $env(KERNEL) \
    -drive file=$env(ROOTFS),if=virtio,format=raw,snapshot=on \
    -append {root=/dev/vda rw console=tty1 console=ttyS0,115200n8 panic=-1 aqua.boot_graphics=1} \
    -serial stdio \
    -monitor unix:$env(MONITOR_SOCKET),server=on,wait=off \
    -qmp unix:$env(QMP_SOCKET),server=on,wait=off \
    -display none \
    -vnc unix:$env(VNC_SOCKET) \
    -vga none \
    -device virtio-vga \
    -device virtio-keyboard-pci \
    -device virtio-mouse-pci,id=aqua-pointer \
    -netdev user,id=net0 \
    -device virtio-net-pci,netdev=net0 \
    -no-reboot

expect {
    -exact {[AQUA-BOOT] stage=graphical-session-activation status=started mode=supervised boot_graphics=true recovery_tty=true} {}
    timeout { puts stderr "Timed out waiting for opt-in graphical boot marker"; exit 1 }
    eof { puts stderr "QEMU exited before opt-in graphical boot marker"; exit 1 }
}

expect {
    -exact {[AQUA-BOOT] stage=recovery-ready status=ok shell=/bin/sh} {}
    timeout { puts stderr "Recovery TTY marker missing during graphical boot"; exit 1 }
    eof { puts stderr "QEMU exited before recovery TTY marker"; exit 1 }
}

expect {
    -exact {aqua-linux login: } {}
    timeout { puts stderr "Timed out waiting for serial login during graphical boot"; exit 1 }
    eof { puts stderr "QEMU exited before serial login"; exit 1 }
}
send -- "root\r"

expect {
    -exact {# } {}
    timeout { puts stderr "Timed out waiting for recovery shell during graphical boot"; exit 1 }
    eof { puts stderr "QEMU exited before recovery shell"; exit 1 }
}

run_shell_check {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'stage=drm-wayland-session status=active' /run/aqua/graphical-session-supervisor.log; do sleep 1; i=$((i + 1)); done} "waiting for the first graphical session"
run_shell_check {ok=1; pid="$(cat /run/aqua/graphical-session-supervisor.pid 2>/dev/null)"} "reading the first supervisor PID"
run_shell_check {grep -Fq 'stage=graphical-session-supervisor status=running attempt=1 restart=0 device=/dev/dri/card0' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the first supervisor marker"
run_shell_check {grep -Fq 'stage=drm-wayland-session status=active' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the first DRM session marker"
run_shell_check {grep -Fq 'boot_graphics=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'autostart=true' /run/aqua/graphical-session-supervisor.log || ok=0} "checking graphical boot policy"
run_shell_check {grep -Fq 'persistent_graphical_session_started=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'session_lifetime_policy=persistent-until-stop' /run/aqua/graphical-session-supervisor.log || ok=0} "checking persistent lifetime policy"
run_shell_check {grep -Fq 'session_scenario=desktop-event-loop' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'external_fixture_clients_started=false' /run/aqua/graphical-session-supervisor.log || ok=0} "checking production desktop scenario"
run_shell_check {grep -Fq 'state=running' /run/aqua/graphical-session-supervisor.state || ok=0; kill -0 "$pid" 2>/dev/null || ok=0} "checking the first running process"
run_shell_check {supervisor_uid="$(awk '/^Uid:/{print $2}' "/proc/$pid/status")"; supervisor_gid="$(awk '/^Gid:/{print $2}' "/proc/$pid/status")"; compositor_pid="$(pidof aqua-compositor | awk '{print $1}')"} "reading unprivileged session identities"
run_shell_check {[ "$supervisor_uid" = 1000 ] || ok=0; [ "$supervisor_gid" = 1000 ] || ok=0; [ "$(awk '/^Uid:/{print $2}' "/proc/$compositor_pid/status")" = 1000 ] || ok=0; [ "$(awk '/^Gid:/{print $2}' "/proc/$compositor_pid/status")" = 1000 ] || ok=0} "checking supervisor and compositor identity"
run_shell_check {groups=" $(id -G aqua) "; case "$groups" in *' 28 '*) ;; *) ok=0;; esac; case "$groups" in *' 29 '*) ;; *) ok=0;; esac; case "$groups" in *' 30 '*) ;; *) ok=0;; esac} "checking Aqua device groups"
run_shell_check {[ "$(ls -nd /run/user/1000 | awk '{print $3 ":" $4}')" = 1000:1000 ] || ok=0; [ "$(LC_ALL=C ls -ld /run/user/1000 | awk '{print substr($1,1,10)}')" = drwx------ ] || ok=0; [ -S /run/user/1000/aqua-wayland-drm-0 ] || ok=0} "checking user-owned Wayland runtime"
run_shell_check {echo "[AQUA-DIAG] process-groups=$(awk '/^Groups:/{for(i=2;i<=NF;i++)printf "%s%s",$i,(i<NF?",":"")}' "/proc/$compositor_pid/status")"; ls -ln /dev/input/event*; ls -l "/proc/$compositor_pid/fd" | grep '/dev/input/' || true; grep -E 'input_source=|libinput' /run/aqua/graphical-session-supervisor.log | tail -n 12 || true} "reporting unprivileged input access"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=unprivileged-session-qemu status=ok user=aqua uid=1000 gid=1000 groups=video,audio,input runtime=/run/user/1000 mode=0700 compositor_uid=1000'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=unprivileged-session-qemu status=ok user=aqua uid=1000 gid=1000 groups=video,audio,input runtime=/run/user/1000 mode=0700 compositor_uid=1000} {}
    timeout { puts stderr "Unprivileged graphical session contract failed"; exit 1 }
    eof { puts stderr "QEMU exited before unprivileged session verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Unprivileged session verification did not return to shell"; exit 1 }
    eof { puts stderr "QEMU exited after unprivileged session verification"; exit 1 }
}

run_shell_check {media_ok=1; grep -Fq 'state=disabled' /run/aqua/media-service-supervisor.state || media_ok=0; grep -Fq 'service_owner_uid=1000' /run/aqua/media-service-supervisor.state || media_ok=0; grep -Fq 'root_media_daemon=false' /run/aqua/media-service-supervisor.state || media_ok=0} "checking the packaged media supervisor safe default"
run_shell_check {grep -Fq 'status=disabled reason=packages-not-enabled root_media_daemon=false' /run/aqua/media-service-supervisor.log || media_ok=0; grep -Fq 'status=media-disabled state=disabled reason=packages-not-enabled' /run/aqua/graphical-session-supervisor.log || media_ok=0} "checking media supervision session integration"
run_shell_check {test ! -e /run/aqua/media-service-supervisor.pid || media_ok=0; command -v pipewire >/dev/null 2>&1 && media_ok=0 || true; command -v wireplumber >/dev/null 2>&1 && media_ok=0 || true} "checking disabled media packages and clean PID state"
send -- {[ "$media_ok" = 1 ] && echo '[AQUA-TEST] stage=media-supervisor-qemu status=ok user=aqua uid=1000 state=disabled packages=absent root_daemon=false graphics_continues=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=media-supervisor-qemu status=ok user=aqua uid=1000 state=disabled packages=absent root_daemon=false graphics_continues=true} {}
    timeout { puts stderr "Packaged media supervisor safe-default contract failed"; exit 1 }
    eof { puts stderr "QEMU exited before media supervisor verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Media supervisor verification did not return to shell"; exit 1 }
    eof { puts stderr "QEMU exited after media supervisor verification"; exit 1 }
}

send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=graphical-boot-qemu status=ok activation=supervised drm_wayland=active persistent=true scenario=desktop-event-loop fixtures=false recovery_tty=available'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=graphical-boot-qemu status=ok activation=supervised drm_wayland=active persistent=true scenario=desktop-event-loop fixtures=false recovery_tty=available} {}
    timeout { puts stderr "Opt-in graphical boot did not become active"; exit 1 }
    eof { puts stderr "QEMU exited before opt-in graphical boot verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Opt-in graphical boot verification did not return to shell"; exit 1 }
    eof { puts stderr "QEMU exited after opt-in graphical boot verification"; exit 1 }
}

run_shell_check {ok=1; grep -Fq 'desktop_system_overview_texture_ready=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_system_overview_clock=' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_system_overview_kernel=' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_system_overview_memory_percent=' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_system_overview_visible=true' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the real system overview GPU panel"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-system-overview-qemu status=ok data=clock,kernel,uptime,load,memory gpu_texture=true visible=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-system-overview-qemu status=ok data=clock,kernel,uptime,load,memory gpu_texture=true visible=true} {}
    timeout { puts stderr "Real system overview was not GPU composited"; exit 1 }
    eof { puts stderr "QEMU exited before system overview verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "System overview verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after system overview verification"; exit 1 }
}

run_shell_check {ok=1; grep -Fq 'desktop_dock_texture_ready=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_dock_item_count=3' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_bottom_shell_group_count=3' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_workspace_active=0' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_dock_running_indicators=0' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the functional bottom shell GPU layer"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-bottom-shell-qemu status=ok apps=3 groups=3 workspaces=3 gpu_texture=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-bottom-shell-qemu status=ok apps=3 groups=3 workspaces=3 gpu_texture=true} {}
    timeout { puts stderr "Bottom shell content was not GPU composited"; exit 1 }
    eof { puts stderr "QEMU exited before dock verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Dock verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after dock verification"; exit 1 }
}

after 500
if {[catch {exec python3 $env(CAPTURE_HELPER) $env(MONITOR_SOCKET) $env(CLEAN_DESKTOP_SCREENSHOT) $env(CLEAN_DESKTOP_SCREENSHOT_PNG)} capture_error]} {
    puts stderr "QEMU clean desktop screendump failed: $capture_error"
    exit 1
}

if {[catch {exec python3 $env(INPUT_HELPER) $env(MONITOR_SOCKET) bottom-applications-activate} input_error]} {
    puts stderr "QEMU bottom Applications input injection failed: $input_error"
    exit 1
}

run_shell_check {i=0; while [ "$i" -lt 30 ] && [ "$(grep -Fc 'desktop_bottom_shell_activation=Applications' /run/aqua/graphical-session-supervisor.log)" -lt 2 ]; do sleep 1; i=$((i + 1)); done} "waiting for bottom Applications activations"
run_shell_check {activation_count="$(grep -Fc 'desktop_bottom_shell_activation=Applications' /run/aqua/graphical-session-supervisor.log)"; ok=1; [ "$activation_count" -ge 2 ] || ok=0; grep -E 'desktop_(primary|pointer|bottom_shell|input)' /run/aqua/graphical-session-supervisor.log | tail -n 40 || true} "checking bottom Applications input"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-bottom-shell-input-qemu status=ok target=applications activations=2 bounded=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-bottom-shell-input-qemu status=ok target=applications activations=2 bounded=true} {}
    timeout { puts stderr "Bottom Applications input did not activate twice"; exit 1 }
    eof { puts stderr "QEMU exited before dock input verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Dock input verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after dock input verification"; exit 1 }
}

if {[catch {exec python3 $env(INPUT_HELPER) $env(MONITOR_SOCKET) launcher-after-dock} input_error]} {
    puts stderr "QEMU production launcher input injection failed: $input_error"
    exit 1
}

run_shell_check {i=0; while [ "$i" -lt 60 ] && ! grep -Fq 'desktop_event_client_surface_count=1' /run/aqua/graphical-session-supervisor.log; do sleep 1; i=$((i + 1)); done} "waiting for the runtime Files repaint"
run_shell_check {printf '%s\n' '[AQUA-DIAG] files-launch'; grep -E 'aqua_launcher_|desktop_launch_|desktop_event_launcher_visible=|desktop_event_client_surface_count=' /run/aqua/graphical-session-supervisor.log | tail -n 40} "reporting the Files launch state"
run_shell_check {ok=1; grep -Fq 'desktop_launch_request_app=files' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_launch_preflight=accepted' /run/aqua/graphical-session-supervisor.log || ok=0} "checking runtime Files preflight"
run_shell_check {grep -Fq 'desktop_launch_surface_app_id=aqua.files' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_launch_surface_ready=true' /run/aqua/graphical-session-supervisor.log || ok=0} "checking runtime Files surface"
run_shell_check {grep -Fq 'desktop_event_repaint=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_event_client_surface_count=1' /run/aqua/graphical-session-supervisor.log || ok=0} "checking runtime Files repaint"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-runtime-launch-qemu status=ok app=files surface=aqua.files repaint=true supervised=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-runtime-launch-qemu status=ok app=files surface=aqua.files repaint=true supervised=true} {}
    timeout { puts stderr "Production launcher did not start and repaint Aqua Files"; exit 1 }
    eof { puts stderr "QEMU exited before runtime launcher verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Runtime launcher verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after runtime launcher verification"; exit 1 }
}

run_shell_check {ok=1; grep -Fq 'desktop_notification_overlay_texture_ready=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_notification_visible=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_notification_active_id=1' /run/aqua/graphical-session-supervisor.log || ok=0} "checking runtime notification toast"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-notification-qemu status=ok source=launcher toast=visible gpu_texture=true active_id=1'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-notification-qemu status=ok source=launcher toast=visible gpu_texture=true active_id=1} {}
    timeout { puts stderr "Runtime notification toast was not GPU composited"; exit 1 }
    eof { puts stderr "QEMU exited before runtime notification verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Runtime notification verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after runtime notification verification"; exit 1 }
}

if {[catch {exec python3 $env(INPUT_HELPER) $env(MONITOR_SOCKET) notification-promote} input_error]} {
    puts stderr "QEMU notification promotion input injection failed: $input_error"
    exit 1
}
run_shell_check {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'desktop_notification_dismissed=true' /run/aqua/graphical-session-supervisor.log; do sleep 1; i=$((i + 1)); done} "waiting for pointer notification dismissal"
run_shell_check {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'desktop_notification_active_id=2' /run/aqua/graphical-session-supervisor.log; do sleep 1; i=$((i + 1)); done} "waiting for queued notification promotion"
run_shell_check {printf '%s\n' '[AQUA-DIAG] notification-promotion'; grep -E 'desktop_icon_context_action=|desktop_notification_|desktop_primary_pointer_press|aqua_desktop_pointer' /run/aqua/graphical-session-supervisor.log | tail -n 48} "reporting notification promotion state"
run_shell_check {ok=1; grep -Fq 'desktop_icon_context_action=properties icon=files' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_notification_dismissed=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_notification_active_id=2' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_notification_queued=0' /run/aqua/graphical-session-supervisor.log || ok=0} "checking FIFO notification promotion"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-notification-promotion-qemu status=ok dismissed=1 promoted=2 queued=0 pointer=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-notification-promotion-qemu status=ok dismissed=1 promoted=2 queued=0 pointer=true} {}
    timeout { puts stderr "Pointer dismissal did not promote the queued notification"; exit 1 }
    eof { puts stderr "QEMU exited before notification promotion verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Notification promotion verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after notification promotion verification"; exit 1 }
}

if {[catch {exec python3 $env(INPUT_HELPER) $env(MONITOR_SOCKET) desktop-context} input_error]} {
    puts stderr "QEMU desktop icon context input injection failed: $input_error"
    exit 1
}
run_shell_check {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'desktop_icon_selected=0' /run/aqua/graphical-session-supervisor.log; do sleep 1; i=$((i + 1)); done} "waiting for the desktop icon selection"
run_shell_check {ok=1; grep -Fq 'desktop_icon_selected=0' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_icons_texture_ready=true' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_icons_selected=0' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the desktop icon GPU interaction"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-icons-qemu status=ok selection=files gpu_texture=true'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-icons-qemu status=ok selection=files gpu_texture=true} {}
    timeout { puts stderr "Desktop icon selection was not GPU composited"; exit 1 }
    eof { puts stderr "QEMU exited before desktop icon verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Desktop icon verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after desktop icon verification"; exit 1 }
}

run_shell_check {i=0; while [ "$i" -lt 60 ] && ! grep -Fq 'desktop_launch_surface_app_id=aqua.properties' /run/aqua/graphical-session-supervisor.log; do sleep 1; i=$((i + 1)); done} "waiting for the Properties surface"
run_shell_check {ok=1; grep -Fq 'desktop_launch_request_app=properties' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_launch_preflight=accepted' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'desktop_launch_surface_app_id=aqua.properties' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the Properties launch"
run_shell_check {grep -Fq 'aqua_properties_target=files' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'aqua_properties_kind=Folder' /run/aqua/graphical-session-supervisor.log || ok=0; grep -Fq 'aqua_properties_location=/home/aqua' /run/aqua/graphical-session-supervisor.log || ok=0} "checking the Properties target metadata"
run_shell_check {[ "$(grep -F 'desktop_event_client_surface_count=' /run/aqua/graphical-session-supervisor.log | tail -n 1)" = 'desktop_event_client_surface_count=2' ] || ok=0} "checking the Properties composition"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-properties-qemu status=ok target=files surface=aqua.properties kind=Folder location=/home/aqua clients=2'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-properties-qemu status=ok target=files surface=aqua.properties kind=Folder location=/home/aqua clients=2} {}
    timeout { puts stderr "Desktop Properties did not open as a real Wayland surface"; exit 1 }
    eof { puts stderr "QEMU exited before Properties verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Properties verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after Properties verification"; exit 1 }
}

run_shell_check {properties_nonprimary_repaint_before="$(grep -Fc 'desktop_event_repaint_sequence=' /run/aqua/graphical-session-supervisor.log)"} "recording the Properties non-primary pointer repaint baseline"
if {[catch {exec python3 $env(INPUT_HELPER) $env(MONITOR_SOCKET) properties-nonprimary-pointer} input_error]} {
    puts stderr "QEMU Properties non-primary pointer input injection failed: $input_error"
    exit 1
}
run_shell_check {i=0; while [ "$i" -lt 30 ] && ! grep -F 'aqua_properties_pointer phase=release' /run/aqua/graphical-session-supervisor.log | grep -Fq 'primary=false ignored=true focus=none'; do sleep 1; i=$((i + 1)); done} "waiting for the Properties non-primary release rejection"
run_shell_check {i=0; while [ "$i" -lt 60 ] && [ "$(grep -Fc 'desktop_event_repaint_sequence=' /run/aqua/graphical-session-supervisor.log)" -le "$properties_nonprimary_repaint_before" ]; do sleep 1; i=$((i + 1)); done} "waiting for the Properties non-primary hover repaint"
run_shell_check {ok=1; grep -F 'aqua_properties_pointer phase=press' /run/aqua/graphical-session-supervisor.log | grep -Fq 'primary=false ignored=true focus=none' || ok=0; grep -F 'aqua_properties_pointer phase=release' /run/aqua/graphical-session-supervisor.log | grep -Fq 'primary=false ignored=true focus=none' || ok=0; [ "$(grep -F 'aqua_properties_refresh_generation=' /run/aqua/graphical-session-supervisor.log | tail -n 1)" = 'aqua_properties_refresh_generation=0' ] || ok=0; [ "$(grep -Fc 'desktop_event_repaint_sequence=' /run/aqua/graphical-session-supervisor.log)" -gt "$properties_nonprimary_repaint_before" ] || ok=0} "checking the Properties primary-button gate"
send -- {[ "$ok" = 1 ] && echo '[AQUA-TEST] stage=desktop-properties-primary-button-qemu status=ok input=non-primary shared_button=true ignored=true focus=none activation=false generation=0 repaint=hover-only clients=2'}
send -- "\r"

expect {
    -exact {[AQUA-TEST] stage=desktop-properties-primary-button-qemu status=ok input=non-primary shared_button=true ignored=true focus=none activation=false generation=0 repaint=hover-only clients=2} {}
    timeout { puts stderr "Properties primary-button gate was not proven"; exit 1 }
    eof { puts stderr "QEMU exited before Properties primary-button verification"; exit 1 }
}

expect {
    -exact {# } {}
    timeout { puts stderr "Properties primary-button verification did not return to recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after Properties primary-button verification"; exit 1 }
}

run_shell_check {properties_cancel_repaint_before="$(grep -Fc 'desktop_event_repaint_sequence=' /run/aqua/graphical-session-supervisor.log)"} "recording the Properties pointer-cancel repaint baseline"
if {[catch {exec python3 $env(INPUT_HELPER) $env(MONITOR_SOCKET) properties-pointer-cancel} input_error]} {
    puts stderr "QEMU Properties pointer-cancel input injection failed: $input_error"
    exit 1
}
run_shell_check {i=0; while [ "$i" -lt 30 ] && ! grep -F 'aqua_properties_pointer phase=release' /run/aqua/graphical-session-supervisor.log | grep -Fq 'action=none was_pressed=true'; do sleep 1; i=$((i + 1)); done} "waiting for the Properties release-outside cancellation"
