#!/usr/bin/expect -f

set timeout $env(TIMEOUT_SECONDS)
log_file -noappend $env(SERIAL_LOG)

proc shell {command description} {
    send -- "$command\r"
    expect {
        -exact {# } {}
        timeout { puts stderr "Timed out while $description"; exit 1 }
        eof { puts stderr "QEMU exited while $description"; exit 1 }
    }
}

spawn qemu-system-x86_64 \
    -machine accel=tcg \
    -cpu max \
    -smp $env(CPUS) \
    -m $env(MEMORY) \
    -kernel $env(KERNEL) \
    -drive file=$env(ROOTFS),if=virtio,format=raw,snapshot=on \
    -append {root=/dev/vda rw console=tty1 console=ttyS0,115200n8 panic=-1 aqua.boot_network=1} \
    -serial stdio \
    -display none \
    -vga none \
    -device virtio-vga \
    -netdev user,id=net0 \
    -device virtio-net-pci,netdev=net0 \
    -device virtio-rng-pci \
    -no-reboot

expect {
    -exact {[AQUA-BOOT] stage=network-service-activation status=started mode=supervised-root target=qemu interface=eth0} {}
    timeout { puts stderr "Opt-in network activation marker missing"; exit 1 }
    eof { puts stderr "QEMU exited before network activation"; exit 1 }
}

expect {
    -exact {aqua-linux login: } {}
    timeout { puts stderr "Timed out waiting for the recovery login"; exit 1 }
    eof { puts stderr "QEMU exited before the recovery login"; exit 1 }
}
send -- "root\r"
expect {
    -exact {# } {}
    timeout { puts stderr "Timed out waiting for the recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited before the recovery shell"; exit 1 }
}

shell {stty -echo} {disabling recovery-shell command echo}

shell {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=running' /run/aqua-network/network-service-supervisor.state 2>/dev/null; do sleep 1; i=$((i + 1)); done} {waiting for DHCP readiness}
send -- {if grep -Fq 'state=running' /run/aqua-network/network-service-supervisor.state 2>/dev/null; then echo '[AQUA-NETWORK] stage=qemu-readiness status=ok'; else cat /run/aqua-network/network-service-supervisor.state /run/aqua-network/network-service-supervisor.log /run/aqua-network/udhcpc.log 2>/dev/null; echo '[AQUA-NETWORK] stage=qemu-readiness status=failed'; fi}
send -- "\r"
expect {
    -exact {[AQUA-NETWORK] stage=qemu-readiness status=ok} {}
    -exact {[AQUA-NETWORK] stage=qemu-readiness status=failed} { puts stderr "DHCP did not reach authoritative readiness"; exit 1 }
    timeout { puts stderr "DHCP readiness result missing"; exit 1 }
    eof { puts stderr "QEMU exited during DHCP readiness"; exit 1 }
}
expect {
    -exact {# } {}
    timeout { puts stderr "DHCP readiness did not return to the recovery shell"; exit 1 }
    eof { puts stderr "QEMU exited after DHCP readiness"; exit 1 }
}
shell {network_ok=1; network_fail() { network_ok=0; echo "[AQUA-NETWORK] check=$1 status=failed"; }; grep -Fq 'attempts=1' /run/aqua-network/network-service-supervisor.state || network_fail initial-attempt; grep -Fq 'lease_ready=true' /run/aqua-network/network-service-supervisor.state || network_fail initial-lease; grep -Fq 'route_ready=true' /run/aqua-network/network-service-supervisor.state || network_fail initial-route; grep -Fq 'dns_ready=true' /run/aqua-network/network-service-supervisor.state || network_fail initial-dns} {checking authoritative network readiness}
shell {test -S /run/aqua-network/control.sock || { network_ok=0; echo '[AQUA-NETWORK] check=broker-socket-type status=failed'; }; test "$(ls -nd /run/aqua-network/control.sock | awk '{print $3 ":" $4}')" = '0:1000' || { network_ok=0; echo '[AQUA-NETWORK] check=broker-socket-owner status=failed'; }; test "$(LC_ALL=C ls -ld /run/aqua-network/control.sock | awk '{print substr($1,1,10)}')" = 'srw-rw----' || { network_ok=0; echo '[AQUA-NETWORK] check=broker-socket-mode status=failed'; }; grep -Fq 'status=ready socket=/run/aqua-network/control.sock owner_uid=0 client_uid=1000 interface=eth0 operations=status,renew-dhcp arbitrary_commands=false arbitrary_paths=false' /run/aqua-network/network-privilege-broker.log || { network_ok=0; echo '[AQUA-NETWORK] check=broker-ready-marker status=failed'; }} {checking the root-owned broker socket contract}
shell {root_status=0; /usr/bin/aqua-network-broker status >/run/aqua-network/root-broker-request.log 2>&1 || root_status=$?; test "$root_status" -ne 0 || network_fail root-exit; grep -Fq 'AQUA-NETWORK/1 ERROR unauthorized-peer' /run/aqua-network/root-broker-request.log || network_fail root-response} {requiring root client rejection}
shell {su -s /bin/sh aqua -c '/usr/bin/aqua-network-broker status' >/run/aqua-network/aqua-broker-status.log 2>&1 || network_fail aqua-status-exit; cat /run/aqua-network/aqua-broker-status.log; grep -Fq 'AQUA-NETWORK/1 OK operation=status interface=eth0 state=running' /run/aqua-network/aqua-broker-status.log || network_fail aqua-status-response; grep -Fq 'management=true' /run/aqua-network/aqua-broker-status.log || network_fail aqua-status-management} {authenticating the Aqua session through peer credentials}
shell {grep -Eq '^eth0[[:space:]]+00000000[[:space:]]+' /proc/net/route || network_fail default-route; grep -Eq '^nameserver[[:space:]]+[0-9a-fA-F:.]+([[:space:]]+#.*)?$' /etc/resolv.conf || network_fail resolver} {checking the default route and resolver state}
shell {nslookup example.com >/run/aqua-network/nslookup.log 2>&1 || network_fail dns-lookup; cat /run/aqua-network/nslookup.log} {performing a DNS lookup through QEMU user networking}

shell {su -s /bin/sh aqua -c '/usr/bin/aqua-network-broker renew-dhcp' >/run/aqua-network/aqua-broker-renew.log 2>&1 || network_fail broker-renew-exit; cat /run/aqua-network/aqua-broker-renew.log; grep -Fq 'AQUA-NETWORK/1 OK operation=renew-dhcp interface=eth0 authoritative=true' /run/aqua-network/aqua-broker-renew.log || network_fail broker-renew-response; grep -Fq 'event=renew' /run/aqua-network/lease.ready || network_fail broker-renew-marker} {requesting authoritative DHCP renewal through the broker}

shell {ip route del default dev eth0} {removing the active default route}
shell {i=0; while [ "$i" -lt 30 ]; do state="$(cat /run/aqua-network/network-service-supervisor.state 2>/dev/null || true)"; printf '%s\n' "$state" | grep -Fq 'state=running' && printf '%s\n' "$state" | grep -Fq 'attempts=2' && break; sleep 1; i=$((i + 1)); done} {waiting for bounded route-loss recovery}
shell {grep -Fq 'attempts=2' /run/aqua-network/network-service-supervisor.state || network_fail route-recovery-attempt; grep -Fq 'restarts=1' /run/aqua-network/network-service-supervisor.state || network_fail route-recovery-restart; grep -Fq 'route_ready=true' /run/aqua-network/network-service-supervisor.state || network_fail route-recovery-route; grep -Fq 'status=restarting failure=route-lost next_restart=1' /run/aqua-network/network-service-supervisor.log || network_fail route-recovery-log} {checking route-loss recovery evidence}

shell {client_pid="$(sed -n 's/^client_pid=//p' /run/aqua-network/network-service-supervisor.state)"; kill -KILL "$client_pid"} {forcing DHCP client failure}
shell {i=0; while [ "$i" -lt 30 ]; do state="$(cat /run/aqua-network/network-service-supervisor.state 2>/dev/null || true)"; printf '%s\n' "$state" | grep -Fq 'state=running' && printf '%s\n' "$state" | grep -Fq 'attempts=3' && break; sleep 1; i=$((i + 1)); done} {waiting for bounded service recovery}
shell {grep -Fq 'attempts=3' /run/aqua-network/network-service-supervisor.state || network_fail service-recovery-attempt; grep -Fq 'restarts=2' /run/aqua-network/network-service-supervisor.state || network_fail service-recovery-restart; grep -Fq 'status=restarting failure=dhcp-client next_restart=2' /run/aqua-network/network-service-supervisor.log || network_fail service-recovery-log; grep -Fq 'route_ready=true' /run/aqua-network/network-service-supervisor.state || network_fail service-recovery-route; grep -Fq 'dns_ready=true' /run/aqua-network/network-service-supervisor.state || network_fail service-recovery-dns} {checking forced-service recovery evidence}
shell {su -s /bin/sh aqua -c '/usr/bin/aqua-network-broker status' >/run/aqua-network/aqua-broker-recovered.log 2>&1 || network_fail broker-recovered-exit; grep -Fq 'state=running attempts=3 restarts=2' /run/aqua-network/aqua-broker-recovered.log || network_fail broker-recovered-state} {checking broker availability after service recovery}

send -- {[ "$network_ok" = 1 ] && echo '[AQUA-NETWORK] stage=qemu-acceptance status=ok dhcp=true default_route=true dns_lookup=true renewal=true route_recovery=true service_recovery=true broker_auth=true root_rejected=true typed_renewal=true recovery_shell=true' || echo '[AQUA-NETWORK] stage=qemu-acceptance status=failed'}
send -- "\r"
expect {
    -exact {[AQUA-NETWORK] stage=qemu-acceptance status=ok dhcp=true default_route=true dns_lookup=true renewal=true route_recovery=true service_recovery=true broker_auth=true root_rejected=true typed_renewal=true recovery_shell=true} {}
    -exact {[AQUA-NETWORK] stage=qemu-acceptance status=failed} { puts stderr "Network QEMU acceptance failed"; exit 1 }
    timeout { puts stderr "Final network acceptance marker missing"; exit 1 }
    eof { puts stderr "QEMU exited before the final network marker"; exit 1 }
}

send -- "poweroff -f\r"
expect eof
