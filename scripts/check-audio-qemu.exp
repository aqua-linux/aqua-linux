    shell {for retired_pid in $retired_media_pids; do kill -0 "$retired_pid" 2>/dev/null && capture_exhaustion_ok=0; done} {checking capture-exhaustion media processes are gone}
    shell {su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null 2>&1 && capture_exhaustion_ok=0; test "$(grep -Fc '[AQUA-MEDIA] stage=media-service-supervisor status=restarting failed_service=pipewire' /run/aqua/audio-qemu-supervisor.log)" -eq 3 || capture_exhaustion_ok=0} {checking unavailable capture graph and finite restarts}
    shell {grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=degraded reason=restart-limit failed_service=pipewire attempts=4 restarts=3' /run/aqua/audio-qemu-supervisor.log || capture_exhaustion_ok=0} {checking capture restart-limit marker}
    send -- {marker='[AQUA-AUDIO] stage=qemu-capture-restart-exhaustion'; [ "$capture_exhaustion_ok" = 1 ] && echo "$marker status=ok failed_service=pipewire attempts=4 restarts=3 restart_limit=true full_stack_retired=true services_stopped=true capture_before=true capture_blocked=true false_success=false controlled_pattern=zero-pcm host_microphone=false recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture-restart-exhaustion status=ok failed_service=pipewire attempts=4 restarts=3 restart_limit=true full_stack_retired=true services_stopped=true capture_before=true capture_blocked=true false_success=false controlled_pattern=zero-pcm host_microphone=false recovery_shell=true} {}
