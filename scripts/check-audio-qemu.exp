    expect {
        -exact {[AQUA-AUDIO] stage=adapter-route-generation status=pending target_bound=true selected_route=true fallback_prepared=true fallback_matches_desired=true} {}
        -exact {[AQUA-AUDIO] stage=adapter-route-generation status=failed} { puts stderr "Audio adapter route-generation precondition failed"; exit 1 }
        timeout { puts stderr "Audio adapter route-generation precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before the pending route-bound control"; exit 1 }
    }
    if {[catch {exec python3 $env(QMP_DEVICE_DELETE) $env(QMP_SOCKET) aqua-hda-secondary} delete_result]} {
        puts stderr $delete_result
        exit 1
    }
    expect {
        -exact {[AQUA-AUDIO] stage=adapter-route-generation status=ok target_bound=true route_changed=true old_request_confirmed=false request_rejected_or_lost=true fallback_matches_desired=true no_resubmission=true} {}
        -exact {[AQUA-AUDIO] stage=adapter-route-generation status=failed} { puts stderr "Audio adapter accepted a stale route control"; exit 1 }
        timeout { puts stderr "Audio adapter route-generation result marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during route-generation reconciliation"; exit 1 }
    }
    expect -exact {# }
    shell {route_control_ok=1; i=0; while [ "$i" -lt 30 ] && [ "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -ne 1 ]; do sleep 1; i=$((i + 1)); done; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 1 || route_control_ok=0; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || route_control_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || route_control_ok=0} {checking the authoritative fallback after pending control route loss}
    send -- {marker='[AQUA-AUDIO] stage=qemu-device-unplug'; [ "$route_control_ok" = 1 ] && echo "$marker status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device-unplug status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1} {}
        timeout { puts stderr "Pending-control selected-device removal was not acknowledged"; exit 1 }
        eof { puts stderr "QEMU exited during pending-control selected-device removal"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {marker='[AQUA-AUDIO] stage=qemu-control-route-loss'; [ "$route_control_ok" = 1 ] && echo "$marker status=ok target_bound=true removed_default=true false_acknowledgement=false request_rejected_or_lost=true fallback_matches_desired=true no_resubmission=true services_running=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-control-route-loss status=ok target_bound=true removed_default=true false_acknowledgement=false request_rejected_or_lost=true fallback_matches_desired=true no_resubmission=true services_running=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-control-route-loss status=failed} { puts stderr "Audio control route-loss contract failed"; exit 1 }
        timeout { puts stderr "Audio control route-loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during audio control route-loss verification"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

