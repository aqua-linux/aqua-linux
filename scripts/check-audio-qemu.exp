    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "control-service-loss"} {
    shell {control_loss_ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' || control_loss_ok=0} {establishing acknowledged control precondition}
    shell {supervisor_pid="$(cat /run/aqua/media-service-supervisor.pid)"; old_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state)"; kill -STOP "$supervisor_pid"; kill "$old_pipewire"; i=0; while [ "$i" -lt 10 ] && [ -S /run/user/1000/pipewire-0 ]; do sleep 1; i=$((i + 1)); done; [ ! -S /run/user/1000/pipewire-0 ] || control_loss_ok=0} {holding a bounded unavailable media graph}
    shell {control_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' >/run/aqua/audio-control-service-loss.log 2>&1 || control_status=$?; cat /run/aqua/audio-control-service-loss.log; [ "$control_status" -ne 0 ] || control_loss_ok=0; grep -Fq '[AQUA-AUDIO] stage=control-probe status=failed operation=open' /run/aqua/audio-control-service-loss.log || control_loss_ok=0; if grep -Fq '[AQUA-AUDIO] stage=control-probe status=ok' /run/aqua/audio-control-service-loss.log; then control_loss_ok=0; fi} {rejecting control acknowledgement while unavailable}
    shell {kill -CONT "$supervisor_pid"; i=0; while [ "$i" -lt 30 ]; do new_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$new_pipewire" ] && [ "$new_pipewire" != "$old_pipewire" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || control_loss_ok=0; grep -Fq 'attempts=2' /run/aqua/media-service-supervisor.state || control_loss_ok=0} {releasing bounded media-service recovery}
    shell {[ "$control_loss_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' || control_loss_ok=0} {checking acknowledged controls after recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-control-service-loss'; [ "$control_loss_ok" = 1 ] && echo "$marker status=ok failed_service=pipewire control_rejected=true false_acknowledgement=false restart_recovery=true control_after=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-control-service-loss status=ok failed_service=pipewire control_rejected=true false_acknowledgement=false restart_recovery=true control_after=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-control-service-loss status=failed} { puts stderr "Audio control service-loss contract failed"; exit 1 }
        timeout { puts stderr "Audio control service-loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during audio control service-loss recovery"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "control-policy-service-loss"} {
    shell {control_policy_loss_ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' || control_policy_loss_ok=0} {establishing acknowledged controls before policy-service loss}
    shell {supervisor_pid="$(cat /run/aqua/media-service-supervisor.pid)"; old_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state)"; old_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state)"; kill "$old_wireplumber"; i=0; while [ "$i" -lt 10 ] && ! grep -Fq 'state=restarting' /run/aqua/media-service-supervisor.state 2>/dev/null; do sleep 1; i=$((i + 1)); done; grep -Fq 'failed_service=wireplumber' /run/aqua/media-service-supervisor.state || control_policy_loss_ok=0; kill -STOP "$supervisor_pid"; [ ! -S /run/user/1000/pipewire-0 ] || control_policy_loss_ok=0} {holding the full-stack outage caused by policy-service loss}
    shell {control_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' >/run/aqua/audio-control-policy-service-loss.log 2>&1 || control_status=$?; cat /run/aqua/audio-control-policy-service-loss.log; [ "$control_status" -ne 0 ] || control_policy_loss_ok=0; grep -Fq '[AQUA-AUDIO] stage=control-probe status=failed operation=open' /run/aqua/audio-control-policy-service-loss.log || control_policy_loss_ok=0; if grep -Fq '[AQUA-AUDIO] stage=control-probe status=ok' /run/aqua/audio-control-policy-service-loss.log; then control_policy_loss_ok=0; fi} {rejecting control acknowledgement during policy-triggered graph outage}
    shell {kill -CONT "$supervisor_pid"; i=0; while [ "$i" -lt 30 ]; do new_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; new_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$new_pipewire" ] && [ -n "$new_wireplumber" ] && [ "$new_pipewire" != "$old_pipewire" ] && [ "$new_wireplumber" != "$old_wireplumber" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || control_policy_loss_ok=0; grep -Fq 'attempts=2' /run/aqua/media-service-supervisor.state || control_policy_loss_ok=0; grep -Fq 'restarts=1' /run/aqua/media-service-supervisor.state || control_policy_loss_ok=0} {releasing full-stack policy-service recovery}
    shell {kill -0 "$old_pipewire" 2>/dev/null && control_policy_loss_ok=0; kill -0 "$old_wireplumber" 2>/dev/null && control_policy_loss_ok=0; grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=restarting failed_service=wireplumber' /run/aqua/audio-qemu-supervisor.log || control_policy_loss_ok=0; grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=stopping service=pipewire' /run/aqua/audio-qemu-supervisor.log || control_policy_loss_ok=0; cat /run/aqua/audio-qemu-supervisor.log} {checking complete policy-triggered media replacement}
    shell {[ "$control_policy_loss_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' || control_policy_loss_ok=0} {checking acknowledged controls after policy-service recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-control-policy-service-loss'; [ "$control_policy_loss_ok" = 1 ] && echo "$marker status=ok failed_service=wireplumber control_rejected=true false_acknowledgement=false full_stack_restart=true old_processes_retired=true restart_recovery=true control_after=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-control-policy-service-loss status=ok failed_service=wireplumber control_rejected=true false_acknowledgement=false full_stack_restart=true old_processes_retired=true restart_recovery=true control_after=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-control-policy-service-loss status=failed} { puts stderr "Audio control policy-service loss contract failed"; exit 1 }
        timeout { puts stderr "Audio control policy-service loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during audio control policy-service recovery"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "input-signal" || $audio_contract eq "input-disconnect" || $audio_contract eq "active-input-unplug"} {
    if {$audio_contract eq "input-disconnect"} {
        set injector_command [list $env(AUDIO_INPUT_INJECTOR) $env(QMP_SOCKET) $env(AUDIO_INPUT_READY) $env(AUDIO_INPUT_RESULT) $env(AUDIO_INPUT_DISCONNECT_BYTES)]
    } else {
        set injector_command [list $env(AUDIO_INPUT_INJECTOR) $env(QMP_SOCKET) $env(AUDIO_INPUT_READY) $env(AUDIO_INPUT_RESULT)]
    }
    if {[catch {exec {*}$injector_command >$env(AUDIO_INPUT_LOG) 2>@1 &} injector_pid]} {
        puts stderr "Unable to start the QEMU D-Bus input injector"
        exit 1
    }
    set injector_ready 0
    for {set attempt 0} {$attempt < 100} {incr attempt} {
        if {[file exists $env(AUDIO_INPUT_READY)]} {
            set injector_ready 1
            break
        }
        after 100
    }
    if {!$injector_ready} {
        if {[file exists $env(AUDIO_INPUT_LOG)]} {
            set handle [open $env(AUDIO_INPUT_LOG) r]
            puts stderr [read $handle]
            close $handle
        }
        puts stderr "Timed out waiting for the QEMU D-Bus input injector"
        exit 1
    }
    if {$audio_contract eq "active-input-unplug"} {
        shell {active_input_ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-signal' || active_input_ok=0} {establishing deterministic input transport before removal}
        shell {rm -f /run/aqua/audio-active-input-unplug.log; capture_status=0; [ "$active_input_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-expect-input-route-loss' >/run/aqua/audio-active-input-unplug.log 2>&1 & capture_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=capture frames=480' /run/aqua/audio-active-input-unplug.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; capture_started=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=capture frames=480' /run/aqua/audio-active-input-unplug.log && capture_started=1} {starting route-aware capture on the selected input}
        send -- {marker='[AQUA-AUDIO] stage=qemu-active-input-unplug-precondition'; [ "$capture_started" = 1 ] && echo "$marker status=ok selected_slot=04.0 active_stream=true frames=480 controlled_pattern=bipolar-injected host_microphone=false" || echo "$marker status=failed"}
        send -- "\r"
        expect {
            -exact {[AQUA-AUDIO] stage=qemu-active-input-unplug-precondition status=ok selected_slot=04.0 active_stream=true frames=480 controlled_pattern=bipolar-injected host_microphone=false} {}
            -exact {[AQUA-AUDIO] stage=qemu-active-input-unplug-precondition status=failed} { puts stderr "Active input removal precondition failed"; exit 1 }
            timeout { puts stderr "Active input removal precondition marker missing"; exit 1 }
            eof { puts stderr "QEMU exited before active input removal"; exit 1 }
        }
        expect -exact {# }
        if {[catch {exec python3 $env(QMP_DEVICE_DELETE) $env(QMP_SOCKET) aqua-hda-input} delete_result]} {
            puts stderr $delete_result
            exit 1
        }
        shell {i=0; while [ "$i" -lt 30 ] && [ "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -ne 0 ]; do sleep 1; i=$((i + 1)); done; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 0 || active_input_ok=0; wait "$capture_pid" || capture_status=$?; cat /run/aqua/audio-active-input-unplug.log; [ "$capture_status" -eq 3 ] || active_input_ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=interrupted direction=capture reason=input-route-loss frames=480' /run/aqua/audio-active-input-unplug.log || active_input_ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=capture' /run/aqua/audio-active-input-unplug.log; then active_input_ok=0; fi} {requiring explicit authoritative input-route-loss interruption}
        send -- {marker='[AQUA-AUDIO] stage=qemu-device-unplug'; [ "$active_input_ok" = 1 ] && echo "$marker status=ok device=aqua-hda-input event=DEVICE_DELETED alsa_inputs=0"}
        send -- "\r"
        expect {
            -exact {[AQUA-AUDIO] stage=qemu-device-unplug status=ok device=aqua-hda-input event=DEVICE_DELETED alsa_inputs=0} {}
            timeout { puts stderr "Active input device removal was not acknowledged"; exit 1 }
            eof { puts stderr "QEMU exited during active input device removal"; exit 1 }
        }
        expect -exact {# }
        shell {[ "$active_input_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-unavailable' || active_input_ok=0; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || active_input_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || active_input_ok=0} {requiring fail-closed capture state with media services responsive}
        shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
        send -- {marker='[AQUA-AUDIO] stage=qemu-active-input-unplug'; [ "$active_input_ok" = 1 ] && echo "$marker status=ok removed_default_input=true active_stream_aborted=true false_success=false new_capture_blocked=true services_running=true controlled_pattern=bipolar-injected host_microphone=false recovery_shell=true" || echo "$marker status=failed"}
        send -- "\r"
        expect {
            -exact {[AQUA-AUDIO] stage=qemu-active-input-unplug status=ok removed_default_input=true active_stream_aborted=true false_success=false new_capture_blocked=true services_running=true controlled_pattern=bipolar-injected host_microphone=false recovery_shell=true} {}
            -exact {[AQUA-AUDIO] stage=qemu-active-input-unplug status=failed} { puts stderr "Active input unplug contract failed"; exit 1 }
            timeout { puts stderr "Final active input unplug marker missing"; exit 1 }
            eof { puts stderr "QEMU exited before the active input unplug marker"; exit 1 }
        }
        expect -exact {# }
        send -- "poweroff -f\r"
        expect eof
        exit 0
    } elseif {$audio_contract eq "input-disconnect"} {
        shell {input_failure_ok=1; probe_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-signal' >/run/aqua/audio-input-disconnect.log 2>&1 || probe_status=$?; cat /run/aqua/audio-input-disconnect.log; test "$probe_status" -ne 0 || input_failure_ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=failed reason=invalid-injected-signal' /run/aqua/audio-input-disconnect.log || input_failure_ok=0; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || input_failure_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || input_failure_ok=0} {rejecting an interrupted deterministic input stream}
    } else {
        shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-signal' || ok=0} {capturing the deterministic non-silent PCM signal}
    }
    set injector_result 0
    for {set attempt 0} {$attempt < 100} {incr attempt} {
        if {[file exists $env(AUDIO_INPUT_RESULT)]} {
            set injector_result 1
            break
        }
        after 100
    }
    if {$audio_contract eq "input-disconnect"} {
        send -- {marker='[AQUA-AUDIO] stage=qemu-input-failure'; [ "$input_failure_ok" = 1 ] && echo "$marker status=ok backend=dbus expected_failure=true false_success=false services_running=true recovery_shell=true" || echo "$marker status=failed"}
        send -- "\r"
        expect {
            -exact {[AQUA-AUDIO] stage=qemu-input-failure status=ok backend=dbus expected_failure=true false_success=false services_running=true recovery_shell=true} {}
            -exact {[AQUA-AUDIO] stage=qemu-input-failure status=failed} { puts stderr "Interrupted input stream was not rejected"; exit 1 }
            timeout { puts stderr "Interrupted input failure marker missing"; exit 1 }
            eof { puts stderr "QEMU exited during interrupted input verification"; exit 1 }
        }
    } else {
        send -- {marker='[AQUA-AUDIO] stage=qemu-capture'; [ "$ok" = 1 ] && echo "$marker status=ok pattern=bipolar-injected"}
        send -- "\r"
        expect {
            -exact {[AQUA-AUDIO] stage=qemu-capture status=ok pattern=bipolar-injected} {}
            timeout { puts stderr "Deterministic QEMU input result missing"; exit 1 }
            eof { puts stderr "QEMU exited during deterministic input verification"; exit 1 }
        }
    }
    if {!$injector_result} {
        puts stderr "The D-Bus injector did not serve the required PCM bytes"
        exit 1
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    if {$audio_contract eq "input-disconnect"} {
        send -- {echo '[AQUA-AUDIO] stage=qemu-input-disconnect status=ok declared_device=intel-hda codec=hda-duplex backend=dbus bytes_before_failure=9600 host_microphone=false'}
    } else {
        send -- {echo '[AQUA-AUDIO] stage=qemu-input-signal status=ok declared_device=intel-hda codec=hda-duplex backend=dbus capture=true frames=4800 host_microphone=false'}
    }
    send -- "\r"
    if {$audio_contract eq "input-disconnect"} {
        expect -exact {[AQUA-AUDIO] stage=qemu-input-disconnect status=ok declared_device=intel-hda codec=hda-duplex backend=dbus bytes_before_failure=9600 host_microphone=false}
    } else {
        expect -exact {[AQUA-AUDIO] stage=qemu-input-signal status=ok declared_device=intel-hda codec=hda-duplex backend=dbus capture=true frames=4800 host_microphone=false}
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "service-loss"} {
    shell {rm -f /run/aqua/audio-active-service-loss.log; playback_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback-expect-interruption' >/run/aqua/audio-active-service-loss.log 2>&1 & playback_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-service-loss.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; playback_started=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-service-loss.log && playback_started=1} {starting a bounded active playback stream}
    send -- {marker='[AQUA-AUDIO] stage=qemu-service-loss-precondition'; [ "$playback_started" = 1 ] && echo "$marker status=ok active_stream=true frames=480" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-service-loss-precondition status=ok active_stream=true frames=480} {}
        -exact {[AQUA-AUDIO] stage=qemu-service-loss-precondition status=failed} { puts stderr "Active playback precondition failed"; exit 1 }
        timeout { puts stderr "Active playback precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before active service loss"; exit 1 }
    }
    expect -exact {# }
    shell {old_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state)"; kill "$old_pipewire"; wait "$playback_pid" || playback_status=$?} {interrupting active playback through PipeWire loss}
    shell {cat /run/aqua/audio-active-service-loss.log; service_loss_ok=1; [ "$playback_status" -eq 3 ] || service_loss_ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=interrupted direction=playback reason=pcm-io' /run/aqua/audio-active-service-loss.log || service_loss_ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=playback' /run/aqua/audio-active-service-loss.log; then service_loss_ok=0; fi; i=0; while [ "$i" -lt 30 ]; do new_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$new_pipewire" ] && [ "$new_pipewire" != "$old_pipewire" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || service_loss_ok=0; grep -Fq 'attempts=2' /run/aqua/media-service-supervisor.state || service_loss_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || service_loss_ok=0} {checking bounded ordered media-service recovery}
    shell {[ "$service_loss_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || service_loss_ok=0} {playing after media-service recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-service-loss'; [ "$service_loss_ok" = 1 ] && echo "$marker status=ok failed_service=pipewire active_stream_aborted=true false_success=false restart_recovery=true playback_after=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-service-loss status=ok failed_service=pipewire active_stream_aborted=true false_success=false restart_recovery=true playback_after=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-service-loss status=failed} { puts stderr "Active media-service loss contract failed"; exit 1 }
        timeout { puts stderr "Active media-service loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during active media-service recovery"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "policy-service-loss"} {
    shell {rm -f /run/aqua/audio-active-policy-loss.log; playback_status=0; old_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state)"; old_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state)"; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback-expect-interruption' >/run/aqua/audio-active-policy-loss.log 2>&1 & playback_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-policy-loss.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; playback_started=0; [ -n "$old_pipewire" ] && [ -n "$old_wireplumber" ] && grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-policy-loss.log && playback_started=1} {starting playback under the active policy service}
    send -- {marker='[AQUA-AUDIO] stage=qemu-policy-loss-precondition'; [ "$playback_started" = 1 ] && echo "$marker status=ok active_stream=true frames=480 pipewire_pid=true wireplumber_pid=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-policy-loss-precondition status=ok active_stream=true frames=480 pipewire_pid=true wireplumber_pid=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-policy-loss-precondition status=failed} { puts stderr "Active policy-service loss precondition failed"; exit 1 }
        timeout { puts stderr "Active policy-service loss precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before active policy-service loss"; exit 1 }
    }
    expect -exact {# }
    shell {kill "$old_wireplumber"; wait "$playback_pid" || playback_status=$?} {interrupting active playback through WirePlumber loss}
    shell {cat /run/aqua/audio-active-policy-loss.log; policy_loss_ok=1; [ "$playback_status" -eq 3 ] || policy_loss_ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=interrupted direction=playback reason=pcm-io' /run/aqua/audio-active-policy-loss.log || policy_loss_ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=playback' /run/aqua/audio-active-policy-loss.log; then policy_loss_ok=0; fi} {checking interrupted playback after policy-service loss}
    shell {i=0; while [ "$i" -lt 30 ]; do new_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; new_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$new_pipewire" ] && [ -n "$new_wireplumber" ] && [ "$new_pipewire" != "$old_pipewire" ] && [ "$new_wireplumber" != "$old_wireplumber" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || policy_loss_ok=0; grep -Fq 'attempts=2' /run/aqua/media-service-supervisor.state || policy_loss_ok=0; grep -Fq 'restarts=1' /run/aqua/media-service-supervisor.state || policy_loss_ok=0} {waiting for replacement media processes}
    shell {kill -0 "$old_pipewire" 2>/dev/null && policy_loss_ok=0; kill -0 "$old_wireplumber" 2>/dev/null && policy_loss_ok=0; grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=restarting failed_service=wireplumber' /run/aqua/audio-qemu-supervisor.log || policy_loss_ok=0; grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=stopping service=pipewire' /run/aqua/audio-qemu-supervisor.log || policy_loss_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || policy_loss_ok=0; cat /run/aqua/audio-qemu-supervisor.log} {checking ordered full-stack policy recovery}
    shell {[ "$policy_loss_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || policy_loss_ok=0} {playing after policy-service recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-policy-service-loss'; [ "$policy_loss_ok" = 1 ] && echo "$marker status=ok failed_service=wireplumber active_stream_aborted=true false_success=false full_stack_restart=true old_processes_retired=true restart_recovery=true playback_after=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-policy-service-loss status=ok failed_service=wireplumber active_stream_aborted=true false_success=false full_stack_restart=true old_processes_retired=true restart_recovery=true playback_after=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-policy-service-loss status=failed} { puts stderr "Active policy-service loss contract failed"; exit 1 }
        timeout { puts stderr "Active policy-service loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during policy-service recovery"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "restart-exhaustion"} {
    shell {exhaustion_ok=1; previous_pipewire=""; retired_media_pids=""} {initializing restart-exhaustion state}
    for {set expected_attempt 1} {$expected_attempt <= 4} {incr expected_attempt} {
        shell [format {pipewire_pid="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; wireplumber_pid="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; state_attempt="$(sed -n 's/^attempts=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; [ -n "$pipewire_pid" ] && [ -n "$wireplumber_pid" ] && [ "$pipewire_pid" != "$previous_pipewire" ] && [ "$state_attempt" = "%d" ] || exhaustion_ok=0; previous_pipewire="$pipewire_pid"; retired_media_pids="$retired_media_pids $pipewire_pid $wireplumber_pid"; [ "$exhaustion_ok" = 1 ] && kill "$pipewire_pid" || exhaustion_ok=0} $expected_attempt] "terminating PipeWire attempt $expected_attempt"
        if {$expected_attempt < 4} {
            set next_attempt [expr {$expected_attempt + 1}]
            shell [format {i=0; while [ "$i" -lt 30 ]; do next_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && grep -Fq 'attempts=%d' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$next_pipewire" ] && [ "$next_pipewire" != "$previous_pipewire" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null || exhaustion_ok=0; grep -Fq 'attempts=%d' /run/aqua/media-service-supervisor.state 2>/dev/null || exhaustion_ok=0} $next_attempt $next_attempt] "waiting for media-service attempt $next_attempt"
        } else {
            shell {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=degraded' /run/aqua/media-service-supervisor.state 2>/dev/null; do sleep 1; i=$((i + 1)); done} {waiting for fail-closed media degradation}
        }
    }
    shell {cat /run/aqua/audio-qemu-supervisor.log} {reporting bounded restart evidence}
    shell {probe_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' >/run/aqua/audio-restart-exhaustion-probe.log 2>&1 || probe_status=$?; cat /run/aqua/audio-restart-exhaustion-probe.log; [ "$probe_status" -ne 0 ] || exhaustion_ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=playback' /run/aqua/audio-restart-exhaustion-probe.log; then exhaustion_ok=0; fi} {checking playback remains fail-closed}
    shell {grep -Fq 'state=degraded' /run/aqua/media-service-supervisor.state || exhaustion_ok=0; grep -Fq 'attempts=4' /run/aqua/media-service-supervisor.state || exhaustion_ok=0; grep -Fq 'restarts=3' /run/aqua/media-service-supervisor.state || exhaustion_ok=0; grep -Fq 'max_restarts=3' /run/aqua/media-service-supervisor.state || exhaustion_ok=0; grep -Fq 'failed_service=pipewire' /run/aqua/media-service-supervisor.state || exhaustion_ok=0} {checking final restart counters}
    shell {[ ! -e /run/aqua/media-service-supervisor.pid ] || exhaustion_ok=0; [ ! -e /run/user/1000/pipewire-0 ] || exhaustion_ok=0; grep -Fxq 'pipewire_pid=' /run/aqua/media-service-supervisor.state || exhaustion_ok=0; grep -Fxq 'wireplumber_pid=' /run/aqua/media-service-supervisor.state || exhaustion_ok=0} {checking media state cleanup}
    shell {for retired_pid in $retired_media_pids; do kill -0 "$retired_pid" 2>/dev/null && exhaustion_ok=0; done} {checking retired media processes are gone}
    shell {su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null 2>&1 && exhaustion_ok=0; test "$(grep -Fc '[AQUA-MEDIA] stage=media-service-supervisor status=restarting failed_service=pipewire' /run/aqua/audio-qemu-supervisor.log)" -eq 3 || exhaustion_ok=0} {checking unavailable graph and finite restarts}
    shell {grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=degraded reason=restart-limit failed_service=pipewire attempts=4 restarts=3' /run/aqua/audio-qemu-supervisor.log || exhaustion_ok=0} {checking restart-limit marker}
    send -- {marker='[AQUA-AUDIO] stage=qemu-restart-exhaustion'; [ "$exhaustion_ok" = 1 ] && echo "$marker status=ok failed_service=pipewire attempts=4 restarts=3 restart_limit=true services_stopped=true playback_blocked=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-restart-exhaustion status=ok failed_service=pipewire attempts=4 restarts=3 restart_limit=true services_stopped=true playback_blocked=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-restart-exhaustion status=failed} { puts stderr "Media-service restart exhaustion contract failed"; exit 1 }
        timeout { puts stderr "Media-service restart exhaustion marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during media-service restart exhaustion"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "control-restart-exhaustion"} {
    shell {control_exhaustion_ok=1; control_before=0; previous_pipewire=""; previous_wireplumber=""; retired_media_pids=""; i=0; while [ "$i" -lt 3 ]; do if su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls'; then control_before=1; break; fi; sleep 1; i=$((i + 1)); done; [ "$control_before" = 1 ] || control_exhaustion_ok=0} {establishing acknowledged controls before restart exhaustion}
    for {set expected_attempt 1} {$expected_attempt <= 4} {incr expected_attempt} {
        shell [format {pipewire_pid="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; wireplumber_pid="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; state_attempt="$(sed -n 's/^attempts=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; [ -n "$pipewire_pid" ] && [ -n "$wireplumber_pid" ] && [ "$pipewire_pid" != "$previous_pipewire" ] && [ "$wireplumber_pid" != "$previous_wireplumber" ] && [ "$state_attempt" = "%d" ] || control_exhaustion_ok=0; previous_pipewire="$pipewire_pid"; previous_wireplumber="$wireplumber_pid"; retired_media_pids="$retired_media_pids $pipewire_pid $wireplumber_pid"; [ "$control_exhaustion_ok" = 1 ] && kill "$pipewire_pid" || control_exhaustion_ok=0} $expected_attempt] "terminating PipeWire control attempt $expected_attempt"
        if {$expected_attempt < 4} {
            set next_attempt [expr {$expected_attempt + 1}]
            shell [format {i=0; while [ "$i" -lt 30 ]; do next_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; next_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && grep -Fq 'attempts=%d' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$next_pipewire" ] && [ -n "$next_wireplumber" ] && [ "$next_pipewire" != "$previous_pipewire" ] && [ "$next_wireplumber" != "$previous_wireplumber" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null || control_exhaustion_ok=0; grep -Fq 'attempts=%d' /run/aqua/media-service-supervisor.state 2>/dev/null || control_exhaustion_ok=0} $next_attempt $next_attempt] "waiting for control media-service attempt $next_attempt"
        } else {
            shell {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=degraded' /run/aqua/media-service-supervisor.state 2>/dev/null; do sleep 1; i=$((i + 1)); done} {waiting for fail-closed control media degradation}
        }
    }
    shell {cat /run/aqua/audio-qemu-supervisor.log} {reporting bounded control restart evidence}
    shell {control_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe controls' >/run/aqua/audio-control-restart-exhaustion-probe.log 2>&1 || control_status=$?; cat /run/aqua/audio-control-restart-exhaustion-probe.log; [ "$control_status" -ne 0 ] || control_exhaustion_ok=0; grep -Fq '[AQUA-AUDIO] stage=control-probe status=failed operation=open' /run/aqua/audio-control-restart-exhaustion-probe.log || control_exhaustion_ok=0; if grep -Fq '[AQUA-AUDIO] stage=control-probe status=ok' /run/aqua/audio-control-restart-exhaustion-probe.log; then control_exhaustion_ok=0; fi} {checking controls remain fail-closed after restart exhaustion}
    shell {grep -Fq 'state=degraded' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0; grep -Fq 'attempts=4' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0; grep -Fq 'restarts=3' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0; grep -Fq 'max_restarts=3' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0; grep -Fq 'failed_service=pipewire' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0} {checking final control restart counters}
    shell {[ ! -e /run/aqua/media-service-supervisor.pid ] || control_exhaustion_ok=0; [ ! -e /run/user/1000/pipewire-0 ] || control_exhaustion_ok=0; grep -Fxq 'pipewire_pid=' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0; grep -Fxq 'wireplumber_pid=' /run/aqua/media-service-supervisor.state || control_exhaustion_ok=0} {checking control-exhaustion media cleanup}
    shell {for retired_pid in $retired_media_pids; do kill -0 "$retired_pid" 2>/dev/null && control_exhaustion_ok=0; done} {checking control-exhaustion media processes are gone}
    shell {su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null 2>&1 && control_exhaustion_ok=0; test "$(grep -Fc '[AQUA-MEDIA] stage=media-service-supervisor status=restarting failed_service=pipewire' /run/aqua/audio-qemu-supervisor.log)" -eq 3 || control_exhaustion_ok=0} {checking unavailable control graph and finite restarts}
    shell {grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=degraded reason=restart-limit failed_service=pipewire attempts=4 restarts=3' /run/aqua/audio-qemu-supervisor.log || control_exhaustion_ok=0} {checking control restart-limit marker}
    send -- {marker='[AQUA-AUDIO] stage=qemu-control-restart-exhaustion'; [ "$control_exhaustion_ok" = 1 ] && echo "$marker status=ok failed_service=pipewire attempts=4 restarts=3 restart_limit=true full_stack_retired=true services_stopped=true control_before=true control_blocked=true false_acknowledgement=false recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-control-restart-exhaustion status=ok failed_service=pipewire attempts=4 restarts=3 restart_limit=true full_stack_retired=true services_stopped=true control_before=true control_blocked=true false_acknowledgement=false recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-control-restart-exhaustion status=failed} { puts stderr "Control restart exhaustion contract failed"; exit 1 }
        timeout { puts stderr "Control restart exhaustion marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during control restart exhaustion"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "capture-restart-exhaustion"} {
    shell {capture_exhaustion_ok=1; previous_pipewire=""; previous_wireplumber=""; retired_media_pids=""; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-silence' || capture_exhaustion_ok=0} {establishing controlled capture before restart exhaustion}
    for {set expected_attempt 1} {$expected_attempt <= 4} {incr expected_attempt} {
