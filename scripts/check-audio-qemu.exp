#!/usr/bin/expect -f

set timeout $env(TIMEOUT_SECONDS)
log_file -noappend $env(SERIAL_LOG)
set audio_contract $env(AQUA_AUDIO_QEMU_CONTRACT)

proc shell {command description} {
    send -- "$command\r"
    expect {
        -exact {# } {}
        timeout { puts stderr "Timed out while $description"; exit 1 }
        eof { puts stderr "QEMU exited while $description"; exit 1 }
    }
}

set qemu_args [list qemu-system-x86_64 \
    -machine accel=tcg \
    -cpu max \
    -smp $env(CPUS) \
    -m $env(MEMORY) \
    -pidfile $env(QEMU_PID_FILE) \
    -kernel $env(KERNEL) \
    -drive file=$env(ROOTFS),if=virtio,format=raw,snapshot=on \
    -append {root=/dev/vda rw console=tty1 console=ttyS0,115200n8 panic=-1} \
    -serial stdio \
    -monitor none \
    -vga none \
    -device virtio-vga]
if {$audio_contract eq "output" || $audio_contract eq "service-loss" || $audio_contract eq "policy-service-loss" || $audio_contract eq "control-submission-budget" || $audio_contract eq "control-service-loss" || $audio_contract eq "control-policy-service-loss" || $audio_contract eq "restart-exhaustion" || $audio_contract eq "control-restart-exhaustion" || $audio_contract eq "policy-restart-exhaustion" || $audio_contract eq "control-policy-restart-exhaustion"} {
    lappend qemu_args -audiodev "wav,id=aqua-audio,path=$env(WAV_CAPTURE),out.frequency=48000,out.channels=2,out.format=s16"
    lappend qemu_args -device ich9-intel-hda
    lappend qemu_args -device hda-duplex,audiodev=aqua-audio
} elseif {$audio_contract eq "input" || $audio_contract eq "capture-service-loss" || $audio_contract eq "capture-policy-service-loss" || $audio_contract eq "capture-restart-exhaustion" || $audio_contract eq "capture-policy-restart-exhaustion"} {
    lappend qemu_args -audiodev "none,id=aqua-audio,in.frequency=48000,in.channels=2,in.format=s16"
    lappend qemu_args -device ich9-intel-hda
    lappend qemu_args -device hda-duplex,audiodev=aqua-audio
} elseif {$audio_contract eq "input-signal" || $audio_contract eq "input-disconnect"} {
    lappend qemu_args -audiodev "dbus,id=aqua-audio,nsamples=480,in.frequency=48000,in.channels=2,in.format=s16"
    lappend qemu_args -device ich9-intel-hda
    lappend qemu_args -device hda-duplex,audiodev=aqua-audio
} elseif {$audio_contract eq "active-input-unplug"} {
    lappend qemu_args -audiodev "dbus,id=aqua-audio,nsamples=480,in.frequency=48000,in.channels=2,in.format=s16"
    lappend qemu_args -device ich9-intel-hda,id=aqua-hda-input,addr=04.0
    lappend qemu_args -device hda-duplex,bus=aqua-hda-input.0,audiodev=aqua-audio
} elseif {$audio_contract eq "multi-route" || $audio_contract eq "hotplug" || $audio_contract eq "replug" || $audio_contract eq "nondefault-unplug" || $audio_contract eq "active-nondefault-unplug" || $audio_contract eq "active-default-unplug" || $audio_contract eq "control-route-loss" || $audio_contract eq "mute-route-loss"} {
    lappend qemu_args -audiodev "wav,id=aqua-route-primary,path=$env(WAV_ROUTE_PRIMARY),out.frequency=48000,out.channels=2,out.format=s16"
    lappend qemu_args -audiodev "wav,id=aqua-route-secondary,path=$env(WAV_ROUTE_SECONDARY),out.frequency=48000,out.channels=2,out.format=s16"
    lappend qemu_args -device ich9-intel-hda,id=aqua-hda-primary,addr=04.0
    lappend qemu_args -device hda-output,bus=aqua-hda-primary.0,audiodev=aqua-route-primary
    lappend qemu_args -device ich9-intel-hda,id=aqua-hda-secondary,addr=05.0
    lappend qemu_args -device hda-output,bus=aqua-hda-secondary.0,audiodev=aqua-route-secondary
} else {
    puts stderr "Unsupported audio QEMU contract: $audio_contract"
    exit 2
}
if {$audio_contract eq "input-signal" || $audio_contract eq "input-disconnect" || $audio_contract eq "active-input-unplug"} {
    lappend qemu_args -display "dbus,p2p=on,audiodev=aqua-audio"
} else {
    lappend qemu_args -display none
}
if {$audio_contract eq "hotplug" || $audio_contract eq "replug" || $audio_contract eq "nondefault-unplug" || $audio_contract eq "active-nondefault-unplug" || $audio_contract eq "active-default-unplug" || $audio_contract eq "control-route-loss" || $audio_contract eq "mute-route-loss" || $audio_contract eq "input-signal" || $audio_contract eq "input-disconnect" || $audio_contract eq "active-input-unplug"} {
    lappend qemu_args -qmp "unix:$env(QMP_SOCKET),server=on,wait=off"
}
lappend qemu_args -no-reboot
spawn {*}$qemu_args

expect {
    -exact {[AQUA-BOOT] stage=recovery-ready status=ok shell=/bin/sh} {}
    timeout { puts stderr "Timed out waiting for Aqua recovery"; exit 1 }
    eof { puts stderr "QEMU exited before Aqua recovery"; exit 1 }
}
expect {
    -exact {aqua-linux login: } {}
    timeout { puts stderr "Timed out waiting for serial login"; exit 1 }
    eof { puts stderr "QEMU exited before serial login"; exit 1 }
}
send -- "root\r"
expect {
    -exact {# } {}
    timeout { puts stderr "Timed out waiting for root shell"; exit 1 }
    eof { puts stderr "QEMU exited before root shell"; exit 1 }
}

shell {ok=1; grep -Fq '[AQUA-SESSION] stage=session-check status=ok no_graphics=true' /run/aqua-session-check.log || { cat /run/aqua-session-check.log; ok=0; }; /usr/bin/aqua-session-check >/run/aqua/audio-qemu-session-check.log 2>/run/aqua/audio-qemu-session-check.err || { cat /run/aqua/audio-qemu-session-check.log /run/aqua/audio-qemu-session-check.err; ok=0; }} {checking the base session contract with media package group members}
send -- {[ "$ok" = 1 ] && echo '[AQUA-AUDIO] stage=qemu-session status=ok base_session=true additional_group_members=true' || echo '[AQUA-AUDIO] stage=qemu-session status=failed'}
send -- "\r"
expect {
    -exact {[AQUA-AUDIO] stage=qemu-session status=ok base_session=true additional_group_members=true} {}
    -exact {[AQUA-AUDIO] stage=qemu-session status=failed} { puts stderr "Base session contract failed in the audio image"; exit 1 }
    timeout { puts stderr "Base session contract failed in the audio image"; exit 1 }
    eof { puts stderr "QEMU exited during base session verification"; exit 1 }
}
expect -exact {# }

if {$audio_contract eq "multi-route" || $audio_contract eq "hotplug" || $audio_contract eq "replug" || $audio_contract eq "nondefault-unplug" || $audio_contract eq "active-nondefault-unplug" || $audio_contract eq "active-default-unplug" || $audio_contract eq "control-route-loss" || $audio_contract eq "mute-route-loss"} {
    shell {ok=1; /usr/bin/aqua-audio-rootfs-check || ok=0; test -d /proc/asound || ok=0; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 2 || ok=0; test -c /dev/snd/pcmC0D0p || ok=0; test -c /dev/snd/pcmC1D0p || ok=0; test ! -e /dev/snd/pcmC0D0c || ok=0; test ! -e /dev/snd/pcmC1D0c || ok=0; [ "$ok" = 1 ] || { cat /proc/asound/cards; ls -l /dev/snd; }} {checking two HDA output devices}
    send -- {marker='[AQUA-AUDIO] stage=qemu-device'; [ "$ok" = 1 ] && echo "$marker status=ok driver=snd_hda_intel codec=hda-output outputs=2 capture_node=false"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device status=ok driver=snd_hda_intel codec=hda-output outputs=2 capture_node=false} {}
        timeout { puts stderr "Multi-device HDA output contract failed"; exit 1 }
        eof { puts stderr "QEMU exited during multi-device verification"; exit 1 }
    }
} else {
    shell {ok=1; /usr/bin/aqua-audio-rootfs-check || ok=0; test -d /proc/asound || ok=0; grep -Fq 'Intel' /proc/asound/cards || ok=0; test -c /dev/snd/pcmC0D0p || ok=0; test -c /dev/snd/pcmC0D0c || ok=0} {checking HDA duplex discovery}
    send -- {[ "$ok" = 1 ] && echo '[AQUA-AUDIO] stage=qemu-device status=ok driver=snd_hda_intel codec=hda-duplex playback=true capture_node=true'}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device status=ok driver=snd_hda_intel codec=hda-duplex playback=true capture_node=true} {}
        timeout { puts stderr "HDA duplex device contract failed"; exit 1 }
        eof { puts stderr "QEMU exited during device verification"; exit 1 }
    }
}
expect -exact {# }

shell {AQUA_SESSION_ALLOWED_COMMAND=/usr/bin/aqua-media-service-supervisor /usr/bin/aqua-session-user-launch /usr/bin/aqua-media-service-supervisor >/run/aqua/audio-qemu-supervisor.log 2>&1 &} {starting per-user media services}
shell {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null; do sleep 1; i=$((i + 1)); done} {waiting for PipeWire and WirePlumber}
if {$audio_contract eq "multi-route" || $audio_contract eq "hotplug" || $audio_contract eq "replug" || $audio_contract eq "nondefault-unplug" || $audio_contract eq "active-nondefault-unplug" || $audio_contract eq "active-default-unplug" || $audio_contract eq "control-route-loss" || $audio_contract eq "mute-route-loss"} {
    shell {ok=1; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || ok=0; grep -Fq 'service_owner_uid=1000' /run/aqua/media-service-supervisor.state || ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/run/aqua/wpctl-status.txt 2>&1 || ok=0; grep -Fq 'Sinks:' /run/aqua/wpctl-status.txt || ok=0} {checking per-user multi-output graph}
    send -- {marker='[AQUA-AUDIO] stage=qemu-service'; [ "$ok" = 1 ] && echo "$marker status=ok owner_uid=1000 pipewire=true wireplumber=true sinks=true route_profile=true"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-service status=ok owner_uid=1000 pipewire=true wireplumber=true sinks=true route_profile=true} {}
        timeout { puts stderr "Per-user multi-output service contract failed"; exit 1 }
        eof { puts stderr "QEMU exited during multi-output service verification"; exit 1 }
    }
} else {
    shell {ok=1; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || ok=0; grep -Fq 'service_owner_uid=1000' /run/aqua/media-service-supervisor.state || ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/run/aqua/wpctl-status.txt 2>&1 || ok=0; grep -Fq 'Sinks:' /run/aqua/wpctl-status.txt || ok=0; grep -Fq 'Sources:' /run/aqua/wpctl-status.txt || ok=0} {checking per-user graph and duplex routes}
    send -- {[ "$ok" = 1 ] && echo '[AQUA-AUDIO] stage=qemu-service status=ok owner_uid=1000 pipewire=true wireplumber=true sink=true source=true'}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-service status=ok owner_uid=1000 pipewire=true wireplumber=true sink=true source=true} {}
        timeout { puts stderr "Per-user audio service contract failed"; exit 1 }
        eof { puts stderr "QEMU exited during service verification"; exit 1 }
    }
}
expect -exact {# }

if {$audio_contract eq "input"} {
    shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-silence' || ok=0} {capturing bounded controlled zero PCM}
    send -- {marker='[AQUA-AUDIO] stage=qemu-capture'; [ "$ok" = 1 ] && echo "$marker status=ok pattern=zero-pcm"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture status=ok pattern=zero-pcm} {}
        timeout { puts stderr "Controlled QEMU input result missing"; exit 1 }
        eof { puts stderr "QEMU exited during controlled input verification"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {echo '[AQUA-AUDIO] stage=qemu-input status=ok declared_device=intel-hda codec=hda-duplex backend=none capture=true frames=4800 controlled_pattern=zero-pcm'}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-input status=ok declared_device=intel-hda codec=hda-duplex backend=none capture=true frames=4800 controlled_pattern=zero-pcm} {}
        timeout { puts stderr "Final QEMU input marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before final input marker"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "capture-service-loss"} {
    shell {rm -f /run/aqua/audio-active-capture-loss.log; capture_status=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-expect-interruption' >/run/aqua/audio-active-capture-loss.log 2>&1 & capture_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=capture frames=480' /run/aqua/audio-active-capture-loss.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; capture_started=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=capture frames=480' /run/aqua/audio-active-capture-loss.log && capture_started=1} {starting a bounded active capture stream}
    send -- {marker='[AQUA-AUDIO] stage=qemu-capture-service-loss-precondition'; [ "$capture_started" = 1 ] && echo "$marker status=ok active_stream=true frames=480 controlled_pattern=zero-pcm host_microphone=false" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture-service-loss-precondition status=ok active_stream=true frames=480 controlled_pattern=zero-pcm host_microphone=false} {}
        -exact {[AQUA-AUDIO] stage=qemu-capture-service-loss-precondition status=failed} { puts stderr "Active capture precondition failed"; exit 1 }
        timeout { puts stderr "Active capture precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before active capture service loss"; exit 1 }
    }
    expect -exact {# }
    shell {old_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state)"; kill "$old_pipewire"; wait "$capture_pid" || capture_status=$?} {interrupting active capture through PipeWire loss}
    shell {cat /run/aqua/audio-active-capture-loss.log; capture_loss_ok=1; [ "$capture_status" -eq 3 ] || capture_loss_ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=interrupted direction=capture reason=pcm-io' /run/aqua/audio-active-capture-loss.log || capture_loss_ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=capture' /run/aqua/audio-active-capture-loss.log; then capture_loss_ok=0; fi} {checking interrupted capture result}
    shell {i=0; while [ "$i" -lt 30 ]; do new_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$new_pipewire" ] && [ "$new_pipewire" != "$old_pipewire" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || capture_loss_ok=0; grep -Fq 'attempts=2' /run/aqua/media-service-supervisor.state || capture_loss_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || capture_loss_ok=0} {checking bounded ordered media-service recovery}
    shell {[ "$capture_loss_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-silence' || capture_loss_ok=0} {capturing controlled zero PCM after recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-capture-service-loss'; [ "$capture_loss_ok" = 1 ] && echo "$marker status=ok failed_service=pipewire active_stream_aborted=true false_success=false restart_recovery=true capture_after=true controlled_pattern=zero-pcm host_microphone=false recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture-service-loss status=ok failed_service=pipewire active_stream_aborted=true false_success=false restart_recovery=true capture_after=true controlled_pattern=zero-pcm host_microphone=false recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-capture-service-loss status=failed} { puts stderr "Active capture service-loss contract failed"; exit 1 }
        timeout { puts stderr "Active capture service-loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during active capture recovery"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "capture-policy-service-loss"} {
    shell {rm -f /run/aqua/audio-active-capture-policy-loss.log; capture_status=0; old_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state)"; old_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state)"; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-expect-interruption' >/run/aqua/audio-active-capture-policy-loss.log 2>&1 & capture_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=capture frames=480' /run/aqua/audio-active-capture-policy-loss.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; capture_started=0; [ -n "$old_pipewire" ] && [ -n "$old_wireplumber" ] && grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=capture frames=480' /run/aqua/audio-active-capture-policy-loss.log && capture_started=1} {starting capture under the active policy service}
    send -- {marker='[AQUA-AUDIO] stage=qemu-capture-policy-loss-precondition'; [ "$capture_started" = 1 ] && echo "$marker status=ok active_stream=true frames=480 pipewire_pid=true wireplumber_pid=true controlled_pattern=zero-pcm host_microphone=false" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture-policy-loss-precondition status=ok active_stream=true frames=480 pipewire_pid=true wireplumber_pid=true controlled_pattern=zero-pcm host_microphone=false} {}
        -exact {[AQUA-AUDIO] stage=qemu-capture-policy-loss-precondition status=failed} { puts stderr "Active capture policy-service loss precondition failed"; exit 1 }
        timeout { puts stderr "Active capture policy-service loss precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before active capture policy-service loss"; exit 1 }
    }
    expect -exact {# }
    shell {kill "$old_wireplumber"; wait "$capture_pid" || capture_status=$?} {interrupting active capture through WirePlumber loss}
    shell {cat /run/aqua/audio-active-capture-policy-loss.log; capture_policy_loss_ok=1; [ "$capture_status" -eq 3 ] || capture_policy_loss_ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=interrupted direction=capture reason=pcm-io' /run/aqua/audio-active-capture-policy-loss.log || capture_policy_loss_ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=capture' /run/aqua/audio-active-capture-policy-loss.log; then capture_policy_loss_ok=0; fi} {checking interrupted capture after policy-service loss}
    shell {i=0; while [ "$i" -lt 30 ]; do new_pipewire="$(sed -n 's/^pipewire_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; new_wireplumber="$(sed -n 's/^wireplumber_pid=//p' /run/aqua/media-service-supervisor.state 2>/dev/null)"; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state 2>/dev/null && [ -n "$new_pipewire" ] && [ -n "$new_wireplumber" ] && [ "$new_pipewire" != "$old_pipewire" ] && [ "$new_wireplumber" != "$old_wireplumber" ] && break; sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || capture_policy_loss_ok=0; grep -Fq 'attempts=2' /run/aqua/media-service-supervisor.state || capture_policy_loss_ok=0; grep -Fq 'restarts=1' /run/aqua/media-service-supervisor.state || capture_policy_loss_ok=0} {waiting for replacement media processes after capture interruption}
    shell {kill -0 "$old_pipewire" 2>/dev/null && capture_policy_loss_ok=0; kill -0 "$old_wireplumber" 2>/dev/null && capture_policy_loss_ok=0; grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=restarting failed_service=wireplumber' /run/aqua/audio-qemu-supervisor.log || capture_policy_loss_ok=0; grep -Fq '[AQUA-MEDIA] stage=media-service-supervisor status=stopping service=pipewire' /run/aqua/audio-qemu-supervisor.log || capture_policy_loss_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || capture_policy_loss_ok=0; cat /run/aqua/audio-qemu-supervisor.log} {checking ordered full-stack policy recovery after capture interruption}
    shell {[ "$capture_policy_loss_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe capture-silence' || capture_policy_loss_ok=0} {capturing controlled zero PCM after policy-service recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-capture-policy-service-loss'; [ "$capture_policy_loss_ok" = 1 ] && echo "$marker status=ok failed_service=wireplumber active_stream_aborted=true false_success=false full_stack_restart=true old_processes_retired=true restart_recovery=true capture_after=true controlled_pattern=zero-pcm host_microphone=false recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture-policy-service-loss status=ok failed_service=wireplumber active_stream_aborted=true false_success=false full_stack_restart=true old_processes_retired=true restart_recovery=true capture_after=true controlled_pattern=zero-pcm host_microphone=false recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-capture-policy-service-loss status=failed} { puts stderr "Active capture policy-service loss contract failed"; exit 1 }
        timeout { puts stderr "Active capture policy-service loss marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during capture policy-service recovery"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "control-submission-budget"} {
    shell {submission_budget_ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/libexec/aqua-tests/aqua-audio-adapter-probe' || submission_budget_ok=0; grep -Fq 'state=running' /run/aqua/media-service-supervisor.state || submission_budget_ok=0; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 wpctl status' >/dev/null || submission_budget_ok=0} {checking the native adapter submission budget and recovery}
    send -- {marker='[AQUA-AUDIO] stage=qemu-control-submission-budget'; [ "$submission_budget_ok" = 1 ] && echo "$marker status=ok failed_submissions=3 fourth_submission_blocked=true generation_stable=true recovery_generation_advanced=true authoritative_ack=true services_running=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-control-submission-budget status=ok failed_submissions=3 fourth_submission_blocked=true generation_stable=true recovery_generation_advanced=true authoritative_ack=true services_running=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-control-submission-budget status=failed} { puts stderr "Audio control submission-budget contract failed"; exit 1 }
        timeout { puts stderr "Audio control submission-budget marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during audio control submission-budget verification"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "control-route-loss"} {
