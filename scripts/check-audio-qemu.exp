    shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe primary-one' || ok=0} {checking the unchanged primary default output}
    shell {[ "$ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || ok=0} {playing through the unchanged primary output}
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {marker='[AQUA-AUDIO] stage=qemu-nondefault-unplug'; [ "$ok" = 1 ] && echo "$marker status=ok removed_default=false default_unchanged=true playback_before=true playback_after=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
