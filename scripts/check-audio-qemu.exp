if {$audio_contract eq "hotplug"} {
    shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || ok=0} {playing on the initial default output}
    shell {su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe routes-secondary' || ok=0} {selecting the secondary output as the configured default}
    shell {[ "$ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || ok=0} {playing on the secondary output before removal}
    send -- {[ "$ok" = 1 ] && echo '[AQUA-AUDIO] stage=qemu-hotplug-precondition status=ok selected_device=aqua-hda-secondary playback=true'}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-hotplug-precondition status=ok selected_device=aqua-hda-secondary playback=true} {}
        timeout { puts stderr "Unable to establish the selected-device removal precondition"; exit 1 }
        eof { puts stderr "QEMU exited before selected-device removal"; exit 1 }
    }
    expect -exact {# }
    if {[catch {exec python3 $env(QMP_DEVICE_DELETE) $env(QMP_SOCKET) aqua-hda-secondary} delete_result]} {
        puts stderr $delete_result
        exit 1
    }
    shell {ok=1; i=0; while [ "$i" -lt 30 ] && [ "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -ne 1 ]; do sleep 1; i=$((i + 1)); done; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 1 || ok=0; test -c /dev/snd/pcmC0D0p || ok=0; test ! -e /dev/snd/pcmC1D0p || ok=0} {waiting for ACPI PCI audio removal}
    send -- {marker='[AQUA-AUDIO] stage=qemu-device-unplug'; [ "$ok" = 1 ] && echo "$marker status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device-unplug status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1} {}
        timeout { puts stderr "Guest audio device removal was not acknowledged"; exit 1 }
        eof { puts stderr "QEMU exited during audio device removal"; exit 1 }
    }
    expect -exact {# }
    shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe fallback' || ok=0} {checking authoritative fallback to the remaining output}
    shell {[ "$ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || ok=0} {playing through the fallback output}
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {marker='[AQUA-AUDIO] stage=qemu-hotplug'; [ "$ok" = 1 ] && echo "$marker status=ok removed_default=true fallback_output=true playback_after=true"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-hotplug status=ok removed_default=true fallback_output=true playback_after=true} {}
        timeout { puts stderr "Final audio hotplug marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before the audio hotplug marker"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "replug"} {
    shell {replug_ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe routes-secondary' || replug_ok=0} {selecting the secondary output before removal}
    send -- {marker='[AQUA-AUDIO] stage=qemu-replug-precondition'; [ "$replug_ok" = 1 ] && echo "$marker status=ok selected_slot=05.0 outputs=2" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-replug-precondition status=ok selected_slot=05.0 outputs=2} {}
        -exact {[AQUA-AUDIO] stage=qemu-replug-precondition status=failed} { puts stderr "Unable to establish the output replug precondition"; exit 1 }
        timeout { puts stderr "Output replug precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before output replug"; exit 1 }
    }
    expect -exact {# }
    if {[catch {exec python3 $env(QMP_DEVICE_DELETE) $env(QMP_SOCKET) aqua-hda-secondary} delete_result]} {
        puts stderr $delete_result
        exit 1
    }
    shell {i=0; while [ "$i" -lt 30 ] && [ "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -ne 1 ]; do sleep 1; i=$((i + 1)); done; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 1 || replug_ok=0} {waiting for selected output removal}
    send -- {marker='[AQUA-AUDIO] stage=qemu-device-unplug'; [ "$replug_ok" = 1 ] && echo "$marker status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device-unplug status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1} {}
        timeout { puts stderr "Output removal was not acknowledged before replug"; exit 1 }
        eof { puts stderr "QEMU exited during output removal before replug"; exit 1 }
    }
    expect -exact {# }
    shell {[ "$replug_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe fallback' || replug_ok=0} {checking authoritative fallback after removal}
    shell {[ "$replug_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || replug_ok=0} {playing on the fallback output}
    if {[catch {exec python3 $env(QMP_AUDIO_OUTPUT_ADD) $env(QMP_SOCKET) aqua-hda-secondary aqua-codec-secondary aqua-route-secondary 05.0} add_result]} {
        puts stderr $add_result
        exit 1
    }
    if {![string match {*status=blocked reason=hda-codec-bus-not-hotpluggable*controller_rollback=true} $add_result]} {
        puts stderr "Unexpected HDA output restoration result: $add_result"
        exit 1
    }
    shell {i=0; while [ "$i" -lt 30 ] && [ "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -ne 1 ]; do sleep 1; i=$((i + 1)); done; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 1 || replug_ok=0; [ "$replug_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe fallback' || replug_ok=0} {checking topology after rejected restoration rollback}
    send -- {marker='[AQUA-AUDIO] stage=qemu-device-replug'; [ "$replug_ok" = 1 ] && echo "$marker status=blocked reason=hda-codec-bus-not-hotpluggable controller_rollback=true alsa_outputs=1 native_outputs=1 false_restoration=false"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device-replug status=blocked reason=hda-codec-bus-not-hotpluggable controller_rollback=true alsa_outputs=1 native_outputs=1 false_restoration=false} {}
        timeout { puts stderr "Rejected output restoration rollback was not acknowledged"; exit 1 }
        eof { puts stderr "QEMU exited during rejected output restoration rollback"; exit 1 }
    }
    expect -exact {# }
    shell {[ "$replug_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || replug_ok=0} {playing again through the stable fallback output}
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {marker='[AQUA-AUDIO] stage=qemu-output-replug'; [ "$replug_ok" = 1 ] && echo "$marker status=ok removed_default=true fallback_output=true playback_before_rejection=true replug_supported=false false_restoration=false controller_rollback=true fallback_stable=true playback_after_rejection=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-output-replug status=ok removed_default=true fallback_output=true playback_before_rejection=true replug_supported=false false_restoration=false controller_rollback=true fallback_stable=true playback_after_rejection=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-output-replug status=failed} { puts stderr "Output replug contract failed"; exit 1 }
        timeout { puts stderr "Final output replug marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before the output replug marker"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

