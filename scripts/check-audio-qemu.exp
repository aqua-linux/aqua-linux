if {$audio_contract eq "active-nondefault-unplug"} {
    shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe primary-two' || ok=0} {checking the active-stream primary default precondition}
    shell {rm -f /run/aqua/audio-active-nondefault-unplug.log; playback_status=0; [ "$ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback-active-stable' >/run/aqua/audio-active-nondefault-unplug.log 2>&1 & playback_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-nondefault-unplug.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; playback_started=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-nondefault-unplug.log && playback_started=1} {starting active playback on the retained default output}
    send -- {marker='[AQUA-AUDIO] stage=qemu-active-nondefault-unplug-precondition'; [ "$playback_started" = 1 ] && echo "$marker status=ok default_slot=04.0 removed_slot=05.0 active_stream=true frames=480" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-active-nondefault-unplug-precondition status=ok default_slot=04.0 removed_slot=05.0 active_stream=true frames=480} {}
        -exact {[AQUA-AUDIO] stage=qemu-active-nondefault-unplug-precondition status=failed} { puts stderr "Active non-default removal precondition failed"; exit 1 }
        timeout { puts stderr "Active non-default removal precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before active non-default removal"; exit 1 }
    }
    expect -exact {# }
    if {[catch {exec python3 $env(QMP_DEVICE_DELETE) $env(QMP_SOCKET) aqua-hda-secondary} delete_result]} {
        puts stderr $delete_result
        exit 1
    }
    shell {ok=1; i=0; while [ "$i" -lt 30 ] && [ "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -ne 1 ]; do sleep 1; i=$((i + 1)); done; test "$(awk '/^ [0-9]+ / { count++ } END { print count+0 }' /proc/asound/cards)" -eq 1 || ok=0; wait "$playback_pid" || playback_status=$?; cat /run/aqua/audio-active-nondefault-unplug.log; [ "$playback_status" -eq 0 ] || ok=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=ok direction=playback frames=48000 rate=48000 channels=2 format=s16le' /run/aqua/audio-active-nondefault-unplug.log || ok=0; if grep -Fq '[AQUA-AUDIO] stage=media-probe status=interrupted direction=playback' /run/aqua/audio-active-nondefault-unplug.log; then ok=0; fi} {requiring the active default stream to survive non-default removal}
    send -- {marker='[AQUA-AUDIO] stage=qemu-device-unplug'; [ "$ok" = 1 ] && echo "$marker status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-device-unplug status=ok device=aqua-hda-secondary event=DEVICE_DELETED alsa_outputs=1} {}
        timeout { puts stderr "Active-stream non-default removal was not acknowledged"; exit 1 }
        eof { puts stderr "QEMU exited during active-stream non-default removal"; exit 1 }
    }
    expect -exact {# }
    shell {[ "$ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe primary-one' || ok=0} {checking the retained authoritative route after active playback}
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {marker='[AQUA-AUDIO] stage=qemu-active-nondefault-unplug'; [ "$ok" = 1 ] && echo "$marker status=ok removed_default=false active_stream_survived=true false_interruption=true default_unchanged=true recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-active-nondefault-unplug status=ok removed_default=false active_stream_survived=true false_interruption=true default_unchanged=true recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-active-nondefault-unplug status=failed} { puts stderr "Active non-default audio unplug contract failed"; exit 1 }
        timeout { puts stderr "Final active non-default audio unplug marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before the active non-default audio unplug marker"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "active-default-unplug"} {
    shell {active_unplug_ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe routes-secondary' || active_unplug_ok=0} {selecting the secondary output for active removal}
    shell {rm -f /run/aqua/audio-active-default-unplug.log; playback_status=0; [ "$active_unplug_ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback-expect-route-loss' >/run/aqua/audio-active-default-unplug.log 2>&1 & playback_pid=$!; i=0; while [ "$i" -lt 10 ] && ! grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-default-unplug.log 2>/dev/null; do sleep 1; i=$((i + 1)); done; playback_started=0; grep -Fq '[AQUA-AUDIO] stage=media-probe status=active direction=playback frames=480' /run/aqua/audio-active-default-unplug.log && playback_started=1} {starting route-aware playback on the selected output}
    send -- {marker='[AQUA-AUDIO] stage=qemu-active-default-unplug-precondition'; [ "$playback_started" = 1 ] && echo "$marker status=ok selected_slot=05.0 active_stream=true frames=480" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-active-default-unplug-precondition status=ok selected_slot=05.0 active_stream=true frames=480} {}
        -exact {[AQUA-AUDIO] stage=qemu-active-default-unplug-precondition status=failed} { puts stderr "Active selected-device removal precondition failed"; exit 1 }
        timeout { puts stderr "Active selected-device removal precondition marker missing"; exit 1 }
        eof { puts stderr "QEMU exited before active selected-device removal"; exit 1 }
    }
    expect -exact {# }
    if {[catch {exec python3 $env(QMP_DEVICE_DELETE) $env(QMP_SOCKET) aqua-hda-secondary} delete_result]} {
