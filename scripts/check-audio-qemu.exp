    send -- {marker='[AQUA-AUDIO] stage=qemu-capture-policy-restart-exhaustion'; [ "$capture_policy_exhaustion_ok" = 1 ] && echo "$marker status=ok failed_service=wireplumber attempts=4 restarts=3 restart_limit=true full_stack_retired=true services_stopped=true capture_before=true capture_blocked=true false_success=false controlled_pattern=zero-pcm host_microphone=false recovery_shell=true" || echo "$marker status=failed"}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-capture-policy-restart-exhaustion status=ok failed_service=wireplumber attempts=4 restarts=3 restart_limit=true full_stack_retired=true services_stopped=true capture_before=true capture_blocked=true false_success=false controlled_pattern=zero-pcm host_microphone=false recovery_shell=true} {}
        -exact {[AQUA-AUDIO] stage=qemu-capture-policy-restart-exhaustion status=failed} { puts stderr "Capture policy-service restart exhaustion contract failed"; exit 1 }
        timeout { puts stderr "Capture policy-service restart exhaustion marker missing"; exit 1 }
        eof { puts stderr "QEMU exited during capture policy-service restart exhaustion"; exit 1 }
    }
    expect -exact {# }
    send -- "poweroff -f\r"
    expect eof
    exit 0
}

if {$audio_contract eq "multi-route"} {
    shell {ok=1; su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || ok=0} {playing on the initial default output}
    shell {su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe routes' || ok=0} {switching the configured default output}
    shell {[ "$ok" = 1 ] && su -s /bin/sh aqua -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/aqua-audio-probe playback' || ok=0} {playing on the changed default output}
