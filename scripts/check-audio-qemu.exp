        eof { puts stderr "QEMU exited during default route switching"; exit 1 }
    }
    expect -exact {# }
    shell {/usr/bin/aqua-media-service-stop >/run/aqua/audio-qemu-stop.log; i=0; while [ "$i" -lt 10 ] && test -e /run/aqua/media-service-supervisor.pid; do sleep 1; i=$((i + 1)); done} {stopping per-user media services}
    send -- {echo '[AQUA-AUDIO] stage=qemu-multi-route status=ok controllers=2 codecs=2 backends=2 default_changed=true captures=2'}
    send -- "\r"
    expect {
        -exact {[AQUA-AUDIO] stage=qemu-multi-route status=ok controllers=2 codecs=2 backends=2 default_changed=true captures=2} {}
