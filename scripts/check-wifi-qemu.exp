#!/usr/bin/expect -f

set timeout $env(TIMEOUT_SECONDS)
log_file -noappend $env(SERIAL_LOG)

proc shell {command description} {
    send -- "$command\r"
    expect {
        -exact {# } {}
        timeout { puts stderr "Timed out while $description"; exit 1 }
        eof { puts stderr "QEMU exited while $description"; exit 1 }
    }
}

spawn qemu-system-x86_64 \
    -machine accel=tcg \
    -cpu max \
    -smp $env(CPUS) \
    -m $env(MEMORY) \
    -kernel $env(KERNEL) \
    -drive file=$env(ROOTFS),if=virtio,format=raw,snapshot=on \
    -append {root=/dev/vda rw console=tty1 console=ttyS0,115200n8 panic=-1 aqua.boot_wifi=1} \
    -serial stdio \
    -display none \
    -vga none \
    -device virtio-vga \
    -device virtio-rng-pci \
    -no-reboot

expect {
    -exact {[AQUA-BOOT] stage=wifi-service-activation status=started mode=supervised-root target=qemu-hwsim interface=wlan0 boot_wifi=true default_wifi=false recovery_tty=true} {}
    timeout { puts stderr "Opt-in Wi-Fi activation marker missing"; exit 1 }
    eof { puts stderr "QEMU exited before Wi-Fi activation"; exit 1 }
}
expect {
    -exact {aqua-linux login: } {}
    timeout { puts stderr "Timed out waiting for recovery login"; exit 1 }
    eof { puts stderr "QEMU exited before recovery login"; exit 1 }
}
send -- "root\r"
expect -exact {# }
shell {stty -echo} {disabling recovery-shell command echo}

shell {wifi_ok=1; wifi_fail() { wifi_ok=0; echo "[AQUA-WIFI] check=$1 status=failed"; }; test -d /sys/class/net/wlan0 || wifi_fail wlan0; test -d /sys/class/net/wlan1 || wifi_fail wlan1; grep -Fq 'state=ready' /run/aqua-wifi/wifi-service.state || wifi_fail service-ready; grep -Fq 'default_wifi=false' /run/aqua-wifi/wifi-service.state || wifi_fail default-boundary} {checking hwsim radios and service readiness}
shell {ip link set wlan1 up; ip addr add 10.42.0.1/24 dev wlan1; : > /run/aqua-wifi/udhcpd.leases; if ! /usr/sbin/hostapd -B -P /run/aqua-wifi/hostapd.pid /etc/aqua/wifi-fixture-hostapd.conf >/run/aqua-wifi/hostapd-start.log 2>&1; then wifi_fail hostapd-start; sed -n '1,40p' /run/aqua-wifi/hostapd-start.log; fi; /usr/sbin/udhcpd -f /etc/aqua/wifi-fixture-udhcpd.conf >/run/aqua-wifi/udhcpd-server.log 2>&1 & echo $! >/run/aqua-wifi/udhcpd-server.pid} {starting isolated hwsim access point and DHCP server}
shell {sleep 2; hostapd_pid="$(cat /run/aqua-wifi/hostapd.pid 2>/dev/null || true)"; kill -0 "$hostapd_pid" 2>/dev/null || wifi_fail access-point-process; ip link show wlan1 | grep -Fq 'UP' || wifi_fail access-point-link} {waiting for the hwsim access point}

shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-scan' >/run/aqua-wifi/scan.log 2>&1 || wifi_fail broker-scan; cat /run/aqua-wifi/scan.log} {discovering the WPA3 transition fixture through the authenticated broker}
shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-scan' >/run/aqua-wifi/rescan.log 2>&1 || wifi_fail broker-rescan; cat /run/aqua-wifi/rescan.log} {explicitly rescanning through the authenticated broker}
shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-wpa3' >/run/aqua-wifi/wpa3-connect.log 2>&1 || wifi_fail broker-wpa3-connect; cat /run/aqua-wifi/wpa3-connect.log; grep -Fq 'security=wpa3-personal' /run/aqua-network/wifi.associated || wifi_fail wpa3-marker; test ! -e /var/lib/aqua-network/wifi.psk || wifi_fail wpa3-credential-persisted} {associating with SAE without persisting the passphrase}
shell {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state 2>/dev/null; do sleep 1; i=$((i + 1)); done; if ! grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state; then wifi_fail wpa3-running; cat /run/aqua-wifi/wifi-service.state /run/aqua-wifi/wifi-service.log /run/aqua-wifi/wpa_supplicant.log /run/aqua-wifi/udhcpc.log /run/aqua-wifi/udhcpd-server.log 2>/dev/null; ip addr show wlan0; cat /proc/net/route; fi; grep -Fq 'associated=true' /run/aqua-wifi/wifi-service.state || wifi_fail wpa3-association; grep -Fq 'lease_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail wpa3-dhcp; grep -Fq 'route_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail wpa3-route; grep -Fq 'dns_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail wpa3-dns; ip addr show wlan0 | grep -Fq '10.42.0.' || wifi_fail wpa3-lease-address} {checking WPA3 association and DHCP readiness}

shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-disconnect' >/run/aqua-wifi/wpa3-disconnect.log 2>&1 || wifi_fail wpa3-disconnect; i=0; while [ "$i" -lt 15 ] && ! grep -Fq 'state=ready' /run/aqua-wifi/wifi-service.state; do sleep 1; i=$((i + 1)); done; test ! -e /run/aqua-network/wifi.associated || wifi_fail wpa3-disconnect-marker; test ! -e /var/lib/aqua-network/wifi.psk || wifi_fail wpa3-disconnect-credential} {checking WPA3 session cleanup}
shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker' >/run/aqua-wifi/connect.log 2>&1 || wifi_fail broker-wpa2-connect; cat /run/aqua-wifi/connect.log; grep -Fq 'security=wpa2-personal' /run/aqua-network/wifi.associated || wifi_fail wpa2-marker; test -f /var/lib/aqua-network/wifi.psk || wifi_fail wpa2-credential-missing} {associating to the same transition fixture with WPA2 and saving the derived PSK}
shell {i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state 2>/dev/null; do sleep 1; i=$((i + 1)); done; if ! grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state; then wifi_fail running; cat /run/aqua-wifi/wifi-service.state /run/aqua-wifi/wifi-service.log /run/aqua-wifi/udhcpc.log /run/aqua-wifi/udhcpd-server.log 2>/dev/null; ip addr show wlan0; cat /proc/net/route; fi; grep -Fq 'associated=true' /run/aqua-wifi/wifi-service.state || wifi_fail association; grep -Fq 'carrier_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail carrier; grep -Fq 'lease_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail dhcp; grep -Fq 'route_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail route; grep -Fq 'dns_ready=true' /run/aqua-wifi/wifi-service.state || wifi_fail dns; ip addr show wlan0 | grep -Fq '10.42.0.' || wifi_fail lease-address} {checking saved WPA2 association and DHCP readiness}

shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-disconnect' >/run/aqua-wifi/disconnect.log 2>&1 || wifi_fail disconnect; i=0; while [ "$i" -lt 15 ] && ! grep -Fq 'state=ready' /run/aqua-wifi/wifi-service.state; do sleep 1; i=$((i + 1)); done; grep -Fq 'associated=false' /run/aqua-wifi/wifi-service.state || wifi_fail disconnect-state; test ! -e /run/aqua-network/wifi.associated || wifi_fail disconnect-marker} {checking controlled disconnect}
shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-reconnect' >/run/aqua-wifi/reconnect.log 2>&1 || wifi_fail reconnect; i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state; do sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state || wifi_fail reconnect-state} {checking reconnect from the root-owned saved credential}

shell {wpa_pid="$(sed -n 's/^wpa_pid=//p' /run/aqua-wifi/wifi-service.state)"; kill -KILL "$wpa_pid"; i=0; while [ "$i" -lt 30 ]; do state="$(cat /run/aqua-wifi/wifi-service.state 2>/dev/null || true)"; printf '%s\n' "$state" | grep -Fq 'state=ready' && printf '%s\n' "$state" | grep -Fq 'attempts=2' && break; sleep 1; i=$((i + 1)); done; grep -Fq 'attempts=2' /run/aqua-wifi/wifi-service.state || wifi_fail service-restart; grep -Fq 'restarts=1' /run/aqua-wifi/wifi-service.state || wifi_fail restart-budget; test ! -e /run/aqua-network/wifi.associated || wifi_fail stale-association} {forcing and checking wpa_supplicant recovery}
shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-reconnect' >/run/aqua-wifi/recovery-connect.log 2>&1 || wifi_fail recovery-connect; i=0; while [ "$i" -lt 30 ] && ! grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state; do sleep 1; i=$((i + 1)); done; grep -Fq 'state=running' /run/aqua-wifi/wifi-service.state || wifi_fail recovery-running; grep -Fq 'attempts=2' /run/aqua-wifi/wifi-service.state || wifi_fail recovery-attempt} {checking saved-credential association and DHCP after service recovery}
shell {su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-forget' >/run/aqua-wifi/forget.log 2>&1 || wifi_fail forget; test ! -e /var/lib/aqua-network/wifi.psk || wifi_fail forget-credential; test ! -e /run/aqua-network/wifi.associated || wifi_fail forget-marker; if su -s /bin/sh aqua -c '/usr/libexec/aqua-tests/aqua-wifi-native-probe broker-reconnect' >/run/aqua-wifi/forgotten-reconnect.log 2>&1; then wifi_fail forgotten-reconnect; fi} {forgetting the saved network and rejecting reconnect without a credential}

shell {/usr/bin/aqua-wifi-service-stop >/run/aqua-wifi/stop.log 2>&1 || wifi_fail service-stop; grep -Fq 'state=stopped' /run/aqua-wifi/wifi-service.state || wifi_fail stopped-state; test ! -S /run/wpa_supplicant/wlan0 || wifi_fail control-socket-cleanup; test ! -S /run/aqua-network/control.sock || wifi_fail broker-socket-cleanup; grep -Fq 'wpa_supplicant_stopped=true dhcp_stopped=true broker_stopped=true' /run/aqua-wifi/stop.log || wifi_fail stop-contract} {checking opt-in service disable and cleanup}

send -- {[ "$wifi_ok" = 1 ] && echo '[AQUA-WIFI] stage=qemu-hwsim-acceptance status=ok radios=2 discovery=true rescan=true transition_mode=true wpa3=true wpa3_session_only=true new_credential=true association=true dhcp=true disconnect=true reconnect=true service_recovery=true forget=true disable=true broker_auth=true default_wifi=false recovery_shell=true' || echo '[AQUA-WIFI] stage=qemu-hwsim-acceptance status=failed'}
send -- "\r"
expect {
    -exact {[AQUA-WIFI] stage=qemu-hwsim-acceptance status=ok radios=2 discovery=true rescan=true transition_mode=true wpa3=true wpa3_session_only=true new_credential=true association=true dhcp=true disconnect=true reconnect=true service_recovery=true forget=true disable=true broker_auth=true default_wifi=false recovery_shell=true} {}
    -exact {[AQUA-WIFI] stage=qemu-hwsim-acceptance status=failed} { puts stderr "Wi-Fi QEMU acceptance failed"; exit 1 }
    timeout { puts stderr "Final Wi-Fi acceptance marker missing"; exit 1 }
    eof { puts stderr "QEMU exited before final Wi-Fi marker"; exit 1 }
}
send -- "poweroff -f\r"
expect eof
