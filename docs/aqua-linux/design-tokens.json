{
  "product": "Aqua Linux",
  "milestone": "2",
  "status": "source-of-truth",
  "directionUpdated": "2026-09-05",
  "defaultTheme": "Light",
  "themes": {
    "Light": {
      "description": "white and ice-white surfaces with a very light gray secondary layer",
      "desktop": "#edf5ff",
      "surface": "#fbfdff",
      "surfaceSecondary": "#f1f6fc",
      "border": "#d7e1ee",
      "textPrimary": "#101827",
      "textSecondary": "#5d6b7c",
      "accent": "#1478f2",
      "brandSymbol": "aqua-symbol-primary.png"
    },
    "Dark": {
      "description": "neutral charcoal and near-black surfaces",
      "desktop": "#111214",
      "surface": "#1a1c1f",
      "surfaceSecondary": "#24272b",
      "border": "#393d42",
      "textPrimary": "#f5f6f7",
      "textSecondary": "#adb1b7",
      "accent": "#4a92e8",
      "brandSymbol": "aqua-symbol-inverse.png"
    }
  },
  "color": {
    "desktop": "#edf5ff",
    "surface": "#fbfdff",
    "surfaceSecondary": "#f1f6fc",
    "border": "#d7e1ee",
    "accent": "#1478f2",
    "accentSoft": "#dcecff",
    "textPrimary": "#101827",
    "textSecondary": "#5d6b7c",
    "destructive": "#e53935",
    "success": "#24a148",
    "warning": "#f59e0b"
  },
  "typography": {
    "uiFamily": "Noto Sans, system-ui, sans-serif",
    "uiFallbackFamilies": ["Noto Sans", "Noto Sans Arabic", "sans-serif"],
    "monoFamily": "ui-monospace, monospace",
    "baseSize": 14,
    "smallSize": 12,
    "titleSize": 18,
    "roles": {
      "caption": { "size": 12, "weight": 400, "lineHeight": 16 },
      "body": { "size": 14, "weight": 400, "lineHeight": 20 },
      "control": { "size": 14, "weight": 500, "lineHeight": 20 },
      "title": { "size": 18, "weight": 600, "lineHeight": 24 },
      "display": { "size": 24, "weight": 600, "lineHeight": 32 }
    },
    "shaping": {
      "unicodeShapingRequired": true,
      "kerningRequired": true,
      "fontFallbackRequired": true,
      "bidirectionalTextRequired": true,
      "graphemeSafeTruncation": true,
      "scaleNativeRasterization": true
    },
    "supportedOutputScales": [1.0, 1.25, 1.5, 2.0]
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24
  },
  "radius": {
    "control": 6,
    "panel": 12,
    "window": 14,
    "dock": 14
  },
  "surface": {
    "fill": "rgba(251, 253, 255, 0.96)",
    "secondaryFill": "rgba(241, 246, 252, 0.94)",
    "border": "rgba(159, 177, 200, 0.42)",
    "separator": "rgba(159, 177, 200, 0.26)",
    "shadow": "rgba(42, 65, 94, 0.18)",
    "optionalBlurRadius": 8,
    "blurRequired": false
  },
  "elevation": {
    "control": {
      "offsetY": 1,
      "blurRadius": 3,
      "spread": 0,
      "ambient": "rgba(42, 65, 94, 0.10)",
      "key": "rgba(42, 65, 94, 0.12)"
    },
    "panel": {
      "offsetY": 4,
      "blurRadius": 14,
      "spread": 0,
      "ambient": "rgba(42, 65, 94, 0.12)",
      "key": "rgba(42, 65, 94, 0.16)"
    },
    "dialog": {
      "offsetY": 8,
      "blurRadius": 24,
      "spread": 1,
      "ambient": "rgba(24, 42, 66, 0.16)",
      "key": "rgba(24, 42, 66, 0.20)"
    },
    "activeWindow": {
      "offsetY": 10,
      "blurRadius": 30,
      "spread": 1,
      "ambient": "rgba(24, 42, 66, 0.16)",
      "key": "rgba(24, 42, 66, 0.22)"
    }
  },
  "iconography": {
    "sourceFormat": "svg",
    "requiredLogicalSizes": [16, 20, 24, 32, 48, 64, 128],
    "supportedOutputScales": [1.0, 1.25, 1.5, 2.0],
    "scaleNativeRasterization": true,
    "bitmapEnlargementAllowed": false,
    "cacheKey": ["sourceRevision", "role", "theme", "state", "logicalSize", "outputScale"],
    "fallbackAsset": "aqua-symbol-primary.png"
  },
  "motion": {
    "durationMs": {
      "immediate": 0,
      "feedback": 90,
      "short": 140,
      "standard": 200,
      "spatial": 280
    },
    "easing": {
      "standard": [0.2, 0.0, 0.0, 1.0],
      "enter": [0.0, 0.0, 0.0, 1.0],
      "exit": [0.3, 0.0, 1.0, 1.0]
    },
    "interruptible": true,
    "frameCallbackDriven": true,
    "reducedMotion": {
      "spatialDurationMs": 0,
      "repeatingMotionAllowed": false,
      "stateFeedbackRequired": true
    }
  },
  "componentContract": {
    "requiredStates": [
      "idle",
      "hover",
      "keyboardFocus",
      "pressed",
      "selected",
      "disabled",
      "loading",
      "empty",
      "error",
      "success",
      "attention"
    ],
    "stableLayoutAcrossStates": true,
    "sharedTokensRequired": true,
    "screenSpecificDrawingCountsAsShared": false
  },
  "layout": {
    "topBarHeight": 56,
    "bottomControlHeight": 64,
    "applicationPanelWidth": 580,
    "searchPanelWidth": 720,
    "desktopIconSize": 52,
    "toastWidth": 360
  },
  "canonicalComposition": {
    "applicationsControl": "bottom-left",
    "searchControl": "bottom-left",
    "runningAppDock": "not-composed-on-desktop",
    "workspaceSwitcher": "bottom-right",
    "statusBar": "three-floating-panels",
    "defaultDesktopIcons": "none",
    "referenceContract": "visual-reference.md"
  },
  "mockPolicy": {
    "mockValuesMustBeLabeled": true,
    "blurMustRemainOptional": true,
    "doNotUseDesktopEnvironmentThemeAssets": true
  }
}
